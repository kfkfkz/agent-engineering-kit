#!/usr/bin/env python3
"""Audit and structurally migrate existing Spec Kit artifacts.

The tool never invents project facts.  Apply mode adds missing canonical
sections with explicit migration-pending markers; an Agent and human reviewer
must then integrate evidence and remove those markers.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


