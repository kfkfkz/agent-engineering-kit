def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def assert_safe_spec_tree(target: Path) -> None:
    """Refuse symlinked Spec Kit paths so reads/writes cannot escape target."""
    specify = target / ".specify"
    if not specify.exists() and not specify.is_symlink():
        return
    if specify.is_symlink():
        raise ValueError(f"Spec Kit 路径包含符号链接: {specify}")
    for path in specify.rglob("*"):
        if path.is_symlink():
            raise ValueError(f"Spec Kit 路径包含符号链接: {path}")
        try:
            path.resolve().relative_to(target)
        except ValueError as exc:
            raise ValueError(f"Spec Kit 路径逃逸目标仓库: {path}") from exc


def headings(text: str) -> list[str]:
    return [
        match.group(1).strip()
        for match in re.finditer(r"(?m)^#{1,4}\s+(.+?)\s*$", text)
    ]


def inspect_feature(feature: Path) -> dict:
    # key 用相对路径而不是 basename，避免 contracts/plan.md 之类子目录同名文件
    # 覆盖核心文档，导致 pending 标记失明并无限重复追加。
    files = {
        path.relative_to(feature).as_posix(): read_text(path)
        for path in feature.rglob("*.md")
        if path.is_file()
    }
    # 字段判定只看核心三文件（spec/plan/tasks）的标题：辅助文档（research、
    # contracts、checklists 等）是证据来源，不是统一字段的载体，跨文件聚合
    # 会让 quickstart 的「日志安全」之类标题误判 security 已覆盖。
    core_headings = "\n".join(
        heading
        for name in CORE_FILES
        for heading in headings(files.get(name, ""))
    )
    field_status = {}
    for field_id, field in FIELDS.items():
        target_text = files.get(field["target"], "")
        pending = f"{PENDING_PREFIX}{field_id}" in target_text
        present = bool(re.search(field["pattern"], core_headings, re.IGNORECASE))
        if not present and field.get("file_hint"):
            present = (feature / field["file_hint"]).is_file()
        field_status[field_id] = "pending_review" if pending else (
            "present" if present else "missing"
        )

    missing_core = [name for name in CORE_FILES if name not in files]
    return {
        "name": feature.name,
        "path": str(feature),
        "missing_core": missing_core,
        "fields": field_status,
    }


def discover(target: Path, wanted: list[str] | None = None) -> tuple[Path, list[dict]]:
    specs = target / ".specify" / "specs"
    if not specs.is_dir():
        return specs, []
    names = sorted(path.name for path in specs.iterdir() if path.is_dir())
    if wanted:
        unknown = [name for name in wanted if name not in names]
        if unknown:
            raise ValueError(
                "未找到 feature: " + ", ".join(unknown)
                + "（可用: " + ", ".join(names) + "）"
            )
        selected = [name for name in names if name in set(wanted)]
    else:
        selected = names
    features = [inspect_feature(specs / name) for name in selected]
    return specs, features


def summarize(features: list[dict]) -> dict:
    missing = sum(
        status == "missing"
        for feature in features
        for status in feature["fields"].values()
    )
    pending = sum(
        status == "pending_review"
        for feature in features
        for status in feature["fields"].values()
    )
    blocked = sum(bool(feature["missing_core"]) for feature in features)
    ready = sum(
        not feature["missing_core"]
        and all(status == "present" for status in feature["fields"].values())
        for feature in features
    )
    return {
        "features": len(features),
        "ready": ready,
        "blocked": blocked,
        "missing_fields": missing,
        "pending_review": pending,
    }


def planned_operations(target: Path, features: list[dict]) -> list[dict]:
    operations = []
    template_root = target / ".specify" / "templates"
    for name in TEMPLATE_OVERLAYS:
        path = template_root / name
        if path.is_file() and TEMPLATE_START not in read_text(path):
            operations.append({
                "kind": "template_overlay",
                "path": str(path.relative_to(target)),
            })
    for feature in features:
        feature_root = Path(feature["path"])
        for field_id, status in feature["fields"].items():
            if status != "missing":
                continue
            operations.append({
                "kind": "add_pending_section",
                "feature": feature["name"],
                "field": field_id,
                "label": FIELDS[field_id]["label"],
                "path": str((feature_root / FIELDS[field_id]["target"]).relative_to(target)),
            })
    return operations


def append_text(path: Path, addition: str) -> None:
    current = read_text(path)
    separator = "" if current.endswith("\n\n") else ("\n" if current.endswith("\n") else "\n\n")
    path.write_text(current + separator + addition.rstrip() + "\n", encoding="utf-8")


def apply_operations(target: Path, features: list[dict], operations: list[dict]) -> None:
    feature_by_name = {feature["name"]: Path(feature["path"]) for feature in features}
    for operation in operations:
        path = target / operation["path"]
        if operation["kind"] == "template_overlay":
            overlay = TEMPLATE_OVERLAYS[path.name]
            append_text(path, f"{TEMPLATE_START}\n{overlay.rstrip()}\n{TEMPLATE_END}")
            continue
        field_id = operation["field"]
        field = FIELDS[field_id]
        feature_root = feature_by_name[operation["feature"]]
        path = feature_root / field["target"]
        marker = f"<!-- {PENDING_PREFIX}{field_id} -->"
        addition = (
            f"## {field['label']}\n\n"
            f"{marker}\n"
            f"> 状态：待核验（结构迁移占位，未含项目事实）\n"
            f"> {field['prompt']}\n"
        )
        append_text(path, addition)


def payload(target: Path, specs: Path, features: list[dict], operations: list[dict]) -> dict:
    return {
        "schema_version": "agent-engineering.spec-migration.v1",
        "target": str(target),
        "specs_root": str(specs),
        "summary": summarize(features),
        "features": features,
        "operations": operations,
    }


def print_human(mode: str, data: dict) -> None:
    summary = data["summary"]
    title = "Spec Kit 迁移检查"
    if mode == "dry-run":
        title = "Spec Kit 迁移 DRY-RUN"
    elif mode == "apply":
        title = "Spec Kit 结构迁移完成"
    print(title)
    print(f"功能目录: {summary['features']}")
    print(f"就绪: {summary['ready']}")
    print(f"阻断: {summary['blocked']}")
    print(f"待补字段: {summary['missing_fields']}")
    print(f"待人工核验: {summary['pending_review']}")
    if mode in {"dry-run", "apply"}:
        print(f"计划操作: {len(data['operations'])}")
        for operation in data["operations"]:
            detail = operation.get("feature", "template")
            field = operation.get("label", operation["kind"])
            print(f"- {detail}: {field} -> {operation['path']}")
    if summary["features"] and mode != "apply":
        for feature in data["features"]:
            missing = [
                FIELDS[field_id]["label"]
                for field_id, status in feature["fields"].items()
                if status == "missing"
            ]
            pending = [
                FIELDS[field_id]["label"]
                for field_id, status in feature["fields"].items()
                if status == "pending_review"
            ]
            if feature["missing_core"] or missing or pending:
                print(
                    f"- {feature['name']}: "
                    f"缺核心={','.join(feature['missing_core']) or '无'}; "
                    f"待补={','.join(missing) or '无'}; "
                    f"待核验={','.join(pending) or '无'}"
                )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="审计并迁移已有 Spec Kit 文档")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--check", action="store_true", help="只检查，不写文件（默认）")
    modes.add_argument("--dry-run", action="store_true", help="显示结构迁移计划，不写文件")
    modes.add_argument("--apply", action="store_true", help="应用结构迁移并标记待人工核验")
    parser.add_argument(
        "--feature", action="append", default=[], metavar="NAME",
        help="只处理指定的 feature 目录名（可重复传入）",
    )
    parser.add_argument("--json", action="store_true", help="输出机器可读 JSON")
    parser.add_argument("target", nargs="?", default=".", help="目标项目目录")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    target = Path(args.target).expanduser().resolve()
    if not target.is_dir():
        print(f"错误: 目标目录不存在: {target}", file=sys.stderr)
        return 2

    try:
        assert_safe_spec_tree(target)
    except (OSError, ValueError) as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2

    try:
        specs, features = discover(target, args.feature)
    except (OSError, UnicodeError) as exc:
        print(f"错误: 无法安全读取 Spec Kit 文档: {exc}", file=sys.stderr)
        return 2
    except ValueError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2
    mode = "apply" if args.apply else ("dry-run" if args.dry_run else "check")
    if not specs.is_dir():
        data = payload(target, specs, [], [])
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print("未发现 .specify/specs，跳过 Spec Kit 迁移。")
        return 0

    blocked = [feature for feature in features if feature["missing_core"]]
    if mode == "apply" and blocked:
        for feature in blocked:
            missing = ", ".join(feature["missing_core"])
            print(f"错误: {feature['name']} 缺少核心文件: {missing}", file=sys.stderr)
        print("迁移已整体阻断，未写入任何文件。", file=sys.stderr)
        return 2

    try:
        operations = planned_operations(target, features)
    except (OSError, UnicodeError) as exc:
        print(f"错误: 无法安全读取 Spec Kit 模板: {exc}", file=sys.stderr)
        return 2
    before = payload(target, specs, features, operations)
    if mode == "apply":
        apply_operations(target, features, operations)
        _, updated_features = discover(target, args.feature)
        data = payload(target, specs, updated_features, operations)
    else:
        data = before

    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print_human(mode, data)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
