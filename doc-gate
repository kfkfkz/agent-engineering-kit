def cmd_check(req_dir: Path, stage: str, as_json: bool) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        with PlanStore(reviews).gate_snapshot() as snapshot:
            return _cmd_check_locked(
                req_dir, stage, as_json, _dynamic_state_from_snapshot(snapshot))
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_check_locked(req_dir: Path, stage: str, as_json: bool,
                      dynamic_state=None) -> int:
    if stage not in STAGES:
        print(f"✗ 未知阶段: {stage}（可选: {'、'.join(STAGES)}）")
        return 3
    if dynamic_state is not None and dynamic_state.state != "FROZEN":
        print(f"✗ 动态计划不可用于校验：{dynamic_state.reason}")
        return 3
    checks = run_checks(req_dir, stage, dynamic_state)
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")
    if as_json:
        print(json.dumps(checks.to_dict(), ensure_ascii=False, indent=2))
    else:
        print(f"硬校验 {stage}: {checks.to_dict()['summary']['pass']} 通过 / "
              f"{len(checks.fails)} 失败")
        for chk in checks.fails:
            print(f"  ✗ [{chk['group']}] {chk['name']}: {chk['detail']}")
    return 1 if checks.fails else 0


def cmd_status(req_dir: Path, as_json: bool) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        with PlanStore(reviews).gate_snapshot() as snapshot:
            return _cmd_status_locked(
                req_dir, as_json, _dynamic_state_from_snapshot(snapshot))
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_status_locked(req_dir: Path, as_json: bool, dynamic_state=None) -> int:
    report = {}
    lines = [f"需求目录: {req_dir.name}"]
    for stage in STAGES:
        st, why = stage_frozen(req_dir, stage, dynamic_state)
        report[stage] = {"state": st, "detail": why}
        lines.append(f"  {stage:<6s} {st:<10s} {why}")
    for extra in ("线上联调功能验证清单.md", "终稿.md"):
        p = req_dir / extra
        if p.is_file():
            ph = len(_placeholders(_read(p) or ""))
            report[extra] = {"exists": True, "placeholders": ph}
            lines.append(f"  {extra} 存在（占位符 {ph} 处）")
    if as_json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        print("\n".join(lines))
    return 0


def _dynamic_runtime(req_dir: Path, base_ref: str):
    root = _repo_root(req_dir)
    if root is None:
        raise ValueError("无法定位 Git 仓库根")
    base_commit = resolve_base_commit(root, base_ref)
    store = PlanStore(req_dir / "reviews")
    snapshot = store.snapshot()
    raw_plan = snapshot.get("artifact-plan.json")
    if raw_plan is None:
        return root, base_commit, store, None, None
    plan = load_plan_bytes(raw_plan)
    input_digest = git_plan_input_digest(plan, base_commit)
    state = read_frozen_dynamic_state(store, input_digest)
    return root, base_commit, store, plan, state


def _dynamic_state_from_snapshot(snapshot: dict[str, bytes]):
    """Validate the dynamic state captured by PlanStore.gate_snapshot()."""
    if not snapshot:
        return None
    try:
        raw_plan = snapshot.get("artifact-plan.json")
        raw_credential = snapshot.get("artifact-plan.gate.json")
        if raw_plan is None:
            return DynamicPlanState("INVALID", "orphan credential or binding")
        plan = load_plan_bytes(raw_plan)
        if raw_credential is None:
            if any(name.endswith(".plan-binding.json") for name in snapshot):
                return DynamicPlanState("INVALID", "binding without credential", plan)
            return DynamicPlanState("PREPARED", "plan has no freeze credential", plan)
        credential = load_credential_bytes(raw_credential)
    except (KeyError, TypeError, ValueError) as exc:
        return DynamicPlanState("INVALID", str(exc))

    class CapturedSnapshot:
        def snapshot(self) -> dict[str, bytes]:
            return dict(snapshot)

    return read_frozen_dynamic_state(CapturedSnapshot(), credential.input_digest)


def _bind_dynamic_gate(req_dir: Path, prior_state, stage: str) -> int:
    """Bind a just-published compatible gate to the frozen plan."""
    if (prior_state.state != "FROZEN" or prior_state.plan is None
            or prior_state.credential is None):
        print("✗ gate 已写入，但 ArtifactPlan 状态不可绑定")
        return 3
    if not participating_documents(prior_state.plan, stage):
        return 0
    current_states = evaluate_stage_states(
        prior_state, _dynamic_snapshots(req_dir, prior_state))
    parents = participating_prerequisites(prior_state.plan, stage)
    if any(current_states[parent] != "BOUND" for parent in parents):
        print("✗ gate 已写入，但真实前置 stage 尚未全部 BOUND")
        return 3
    try:
        gate_digest, doc_hashes, parent_fingerprints = _current_plan_gate_inputs(
            req_dir, prior_state, stage)
        if gate_digest is None:
            return 0
        rebound = bind_frozen_stage(
            PlanStore(req_dir / "reviews"), prior_state.credential.input_digest,
            stage, gate_digest=gate_digest, doc_hashes=doc_hashes,
            prerequisite_fingerprints=parent_fingerprints)
        states = evaluate_stage_states(
            rebound, _dynamic_snapshots(req_dir, rebound))
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ gate 已写入，但 ArtifactPlan binding 失败: {exc}")
        return 3
    if states.get(stage) != "BOUND":
        print(f"✗ gate 已写入，但 ArtifactPlan binding 未生效: {rebound.reason}")
        return 3
    return 0


def _current_plan_gate_inputs(req_dir: Path, state, stage: str):
    if state.plan is None:
        raise ValueError("动态计划不可用")
    documents = participating_documents(state.plan, stage)
    if not documents:
        return None, {}, {}
    gate_digest, current_docs = _current_plan_gate_inputs_no_parents(
        req_dir, state, stage)
    parent_fingerprints = {
        parent: _dynamic_stage_fingerprint(req_dir, state, parent)
        for parent in participating_prerequisites(state.plan, stage)
    }
    return gate_digest, current_docs, parent_fingerprints


def _dynamic_stage_fingerprint(req_dir: Path, state, stage: str) -> str:
    if state.plan is None or state.credential is None:
        return "0" * 64
    matching = [binding for binding in state.bindings if binding.stage == stage]
    if len(matching) != 1:
        return "0" * 64
    try:
        gate_digest, documents, _parents = _current_plan_gate_inputs_no_parents(
            req_dir, state, stage)
    except (OSError, ValueError):
        return "0" * 64
    payload = {
        "stage": stage,
        "gate_digest": gate_digest,
        "doc_hashes": documents,
        "binding_digest": matching[0].binding_digest,
        "credential_digest": state.credential.credential_digest,
    }
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _current_plan_gate_inputs_no_parents(req_dir: Path, state, stage: str):
    if state.plan is None:
        raise ValueError("动态计划不可用")
    documents = participating_documents(state.plan, stage)
    if not documents:
        return None, {}
    gate_path = req_dir / "reviews" / f"{stage}.gate.json"
    raw_gate = _read_review_bytes(gate_path)
    try:
        gate = json.loads(raw_gate.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"{stage} gate 不可读") from exc
    recorded = gate.get("doc_hashes") if isinstance(gate, dict) else None
    if (not isinstance(gate, dict) or gate.get("status") != "PASS"
            or not isinstance(recorded, dict)):
        raise ValueError(f"{stage} gate 不是有效 PASS")
    identity_parts = [raw_gate]
    if stage == "计划":
        closeout_path = req_dir / "reviews" / "计划.closeout.json"
        if closeout_path.exists() or closeout_path.is_symlink():
            raw_closeout = _read_review_bytes(closeout_path)
            try:
                closeout = json.loads(raw_closeout.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise ValueError("计划 closeout 不可读") from exc
            final_hashes = closeout.get("doc_hashes") if isinstance(
                closeout, dict) else None
            if (not isinstance(closeout, dict)
                    or closeout.get("status") != "PASS"
                    or closeout.get("plan_gate_sha256") != hashlib.sha256(
                        raw_gate).hexdigest()
                    or not isinstance(final_hashes, dict)
                    or set(final_hashes) != set(documents)):
                raise ValueError("计划 closeout 不是有效 PASS")
            current_docs = {
                document: hashlib.sha256(
                    _read_review_bytes(req_dir / document)).hexdigest()
                for document in documents
            }
            if current_docs != final_hashes:
                raise ValueError("计划收口后文档哈希失配")
            identity_parts.append(raw_closeout)
        elif gate.get("execution_baseline_hashes") is not None:
            baseline = gate.get("execution_baseline_hashes")
            if not isinstance(baseline, dict) or set(baseline) != set(documents):
                raise ValueError("计划执行基线未覆盖参与文档")
            current_docs = {
                document: _plan_baseline_hashes(req_dir).get(document)
                for document in documents
            }
            if current_docs != baseline or any(
                    not isinstance(value, str) for value in current_docs.values()):
                raise ValueError("计划执行基线哈希失配")
        else:
            current_docs = {}
    else:
        current_docs = {}
    if not current_docs:
        for document in documents:
            digest = hashlib.sha256(
                _read_review_bytes(req_dir / document)).hexdigest()
            if recorded.get(document) != digest:
                raise ValueError(f"{document} 与 gate 哈希失配")
            current_docs[document] = digest
    identity = hashlib.sha256(b"\x00".join(identity_parts)).hexdigest()
    return identity, current_docs


def _dynamic_snapshots(req_dir: Path, state) -> dict[str, dict[str, object]]:
    if state.plan is None:
        return {}
    snapshots = {}
    bound = {binding.stage for binding in state.bindings}
    for stage in ARTIFACT_REGISTRY.groups:
        if stage not in bound:
            continue
        try:
            gate_digest, documents, parents = _current_plan_gate_inputs(
                req_dir, state, stage)
            if gate_digest is None:
                continue
            snapshots[stage] = {
                "gate_digest": gate_digest,
                "doc_hashes": documents,
                "prerequisite_fingerprints": parents,
            }
        except (OSError, ValueError):
            snapshots[stage] = {
                "gate_digest": "0" * 64,
                "doc_hashes": {doc: "0" * 64 for doc in
                               participating_documents(state.plan, stage)},
                "prerequisite_fingerprints": {
                    parent: "0" * 64 for parent in
                    participating_prerequisites(state.plan, stage)},
            }
    return snapshots


def _dynamic_payload(req_dir: Path, state) -> dict[str, object]:
    payload: dict[str, object] = {"state": state.state, "reason": state.reason}
    if state.plan is not None:
        payload["plan"] = asdict(state.plan)
    if state.credential is not None:
        payload["credential"] = asdict(state.credential)
    if state.plan is not None and state.state == "FROZEN":
        binding_states = evaluate_stage_states(
            state, _dynamic_snapshots(req_dir, state))
        payload["binding_states"] = binding_states
        payload["effective_stage_states"] = effective_stage_states(
            state.plan, binding_states)
    return payload


def _print_dynamic(payload: dict[str, object], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"ArtifactPlan: {payload['state']} — {payload['reason']}")
        for stage, value in payload.get("effective_stage_states", {}).items():
            print(f"  {stage}: {value}")


def cmd_plan_prepare(req_dir: Path, base_ref: str, route: str,
                     overlays: tuple[str, ...], as_json: bool) -> int:
    try:
        root = _repo_root(req_dir)
        if root is None:
            raise ValueError("无法定位 Git 仓库根")
        base = resolve_base_commit(root, base_ref)
        state = prepare_git_current_plan(
            PlanStore(req_dir / "reviews"), root, base, route,
            scan_scope=scan_negative_risks, required_overlays=overlays)
        _print_dynamic(_dynamic_payload(req_dir, state), as_json)
        return 0 if state.state == "PREPARED" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan prepare 失败: {exc}")
        return 3


def cmd_plan_freeze(req_dir: Path, base_ref: str, as_json: bool) -> int:
    try:
        root, base, store, plan, _state = _dynamic_runtime(req_dir, base_ref)
        if plan is None:
            raise ValueError("没有 PREPARED ArtifactPlan")
        state = freeze_git_current_plan(
            store, root, base, git_plan_input_digest(plan, base),
            scan_scope=scan_negative_risks,
            frozen_at=datetime.now().isoformat(timespec="seconds"))
        _print_dynamic(_dynamic_payload(req_dir, state), as_json)
        return 0 if state.state == "FROZEN" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan freeze 失败: {exc}")
        return 3


def cmd_plan_bind(req_dir: Path, base_ref: str, stage: str, as_json: bool) -> int:
    try:
        root, base, store, plan, state = _dynamic_runtime(req_dir, base_ref)
        if plan is None or state is None or state.state != "FROZEN":
            raise ValueError("ArtifactPlan 未冻结或已失效")
        documents = participating_documents(plan, stage)
        if not documents:
            payload = _dynamic_payload(req_dir, state)
            _print_dynamic(payload, as_json)
            return 0
        current_states = evaluate_stage_states(
            state, _dynamic_snapshots(req_dir, state))
        parents = participating_prerequisites(plan, stage)
        if any(current_states[parent] != "BOUND" for parent in parents):
            raise ValueError("真实前置 stage 尚未全部 BOUND")
        gate_digest, doc_hashes, parent_fingerprints = _current_plan_gate_inputs(
            req_dir, state, stage)
        if gate_digest is None:
            raise ValueError("跳过 stage 不应建立 binding")
        rebound = bind_frozen_stage(
            store, git_plan_input_digest(plan, base), stage,
            gate_digest=gate_digest, doc_hashes=doc_hashes,
            prerequisite_fingerprints=parent_fingerprints)
        _print_dynamic(_dynamic_payload(req_dir, rebound), as_json)
        binding_states = _dynamic_payload(req_dir, rebound).get("binding_states", {})
        return 0 if binding_states.get(stage) == "BOUND" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan bind 失败: {exc}")
        return 3


def cmd_plan_status(req_dir: Path, base_ref: str, as_json: bool) -> int:
    try:
        _root, _base, _store, plan, state = _dynamic_runtime(req_dir, base_ref)
        if plan is None or state is None:
            payload = {"state": "ABSENT", "reason": "no dynamic sidecars"}
        else:
            payload = _dynamic_payload(req_dir, state)
        _print_dynamic(payload, as_json)
        return 0 if payload["state"] != "INVALID" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan status 失败: {exc}")
        return 3


def cmd_plan_rollback(req_dir: Path, as_json: bool) -> int:
    try:
        store = PlanStore(req_dir / "reviews")
        rollback_dynamic_state(store)
        payload = {"state": "ABSENT", "reason": "dynamic state rolled back"}
        _print_dynamic(payload, as_json)
        return 0
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan rollback 失败: {exc}")
        return 3


def main() -> int:
    ap = argparse.ArgumentParser(prog="doc-gate", description="需求文档流水线确定性门禁")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("check", "review-input", "gate"):
        p = sub.add_parser(name)
        p.add_argument("dir", help="需求目录（docs/01-需求/NNN-名称/）")
        p.add_argument("--stage", required=True, help=f"阶段: {'、'.join(STAGES)}")
        p.add_argument("--json", action="store_true")
        if name == "gate":
            p.add_argument("--no-review", action="store_true",
                           help="跳过 AI 评审（仅硬校验判定——限 review=optional 阶段）")
    ip = sub.add_parser("init", help="需求登记脚手架（两处目录+模板+索引行，幂等）")
    ip.add_argument("name", help="需求名 NNN-名称（如 014-识别驱动脱敏）")
    ip.add_argument("--repo", default=".", help="目标仓库根目录（默认当前目录）")
    ip.add_argument("--json", action="store_true")
    fp = sub.add_parser("freeze", help="人工签核阶段冻结凭证（需求分析/业务流程设计）")
    fp.add_argument("dir")
    fp.add_argument("--stage", default="需求分析",
                    help="需求分析 / 业务流程设计")
    fp.add_argument("--by", default="", help="签核人（进 approved_by）")
    fp.add_argument("--json", action="store_true")
    cp = sub.add_parser("closeout", help="执行完成后校验并冻结计划终态")
    cp.add_argument("dir")
    cp.add_argument("--json", action="store_true")
    sp = sub.add_parser("status")
    sp.add_argument("dir")
    sp.add_argument("--json", action="store_true")
    pp = sub.add_parser("plan-prepare", help="准备动态 ArtifactPlan")
    pp.add_argument("dir")
    pp.add_argument("--base", required=True, help="精确 Git 基线 commit/ref")
    pp.add_argument("--route", required=True,
                    choices=("direct", "bounded", "standard", "initiative"))
    pp.add_argument("--require", action="append", default=[], dest="overlays",
                    help="治理强制 required 的 artifact ID（可重复）")
    pp.add_argument("--json", action="store_true")
    for name in ("plan-freeze", "plan-status"):
        plan_parser = sub.add_parser(name)
        plan_parser.add_argument("dir")
        plan_parser.add_argument("--base", required=True)
        plan_parser.add_argument("--json", action="store_true")
    pb = sub.add_parser("plan-bind")
    pb.add_argument("dir")
    pb.add_argument("--base", required=True)
    pb.add_argument("--stage", required=True, choices=tuple(STAGES))
    pb.add_argument("--json", action="store_true")
    pr = sub.add_parser("plan-rollback")
    pr.add_argument("dir")
    pr.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.cmd == "init":
        return cmd_init(Path(args.repo).resolve(), args.name, args.json)

    req_dir = Path(args.dir).resolve()
    if not req_dir.is_dir():
        print(f"✗ 需求目录不存在: {req_dir}")
        return 3
    if args.cmd == "check":
        return cmd_check(req_dir, args.stage, args.json)
    if args.cmd == "review-input":
        return cmd_review_input(req_dir, args.stage, args.json)
    if args.cmd == "gate":
        return cmd_gate(req_dir, args.stage, args.no_review, args.json)
    if args.cmd == "freeze":
        return cmd_freeze(req_dir, args.stage,
                          getattr(args, "by", ""), getattr(args, "json", False))
    if args.cmd == "closeout":
        return cmd_closeout(req_dir, args.json)
    if args.cmd == "plan-prepare":
        return cmd_plan_prepare(req_dir, args.base, args.route,
                                tuple(args.overlays), args.json)
    if args.cmd == "plan-freeze":
        return cmd_plan_freeze(req_dir, args.base, args.json)
    if args.cmd == "plan-bind":
        return cmd_plan_bind(req_dir, args.base, args.stage, args.json)
    if args.cmd == "plan-status":
        return cmd_plan_status(req_dir, args.base, args.json)
    if args.cmd == "plan-rollback":
        return cmd_plan_rollback(req_dir, args.json)
    return cmd_status(req_dir, args.json)


if __name__ == "__main__":
    sys.exit(main())
