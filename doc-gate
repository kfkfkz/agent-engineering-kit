def _read(path: Path) -> str | None:
    try:
        # Review hashes bind disk bytes, including CRLF on native Windows.
        # Universal-newline text I/O would silently change the signed material.
        return path.read_bytes().decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def _sha256(path: Path) -> str | None:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


def _capture_stage_materials(req_dir: Path, documents) -> dict[str, bytes]:
    """Capture bounded raw input before checks; publication rechecks it."""
    root = _ui_fs.open_absolute_dir(Path(os.path.abspath(req_dir)))
    try:
        result = {}
        for doc in documents:
            try:
                result[doc] = _ui_fs.read_at(root, doc, MAX_DOCUMENT_BYTES)
            except FileNotFoundError:
                # Existing hard checks still report missing required docs and
                # may publish a non-authorizing diagnostic, never a PASS.
                pass
        return result
    finally:
        _ui_fs.close_dir(root)


