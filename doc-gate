def _stage_fingerprint(req_dir: Path, stage: str, dynamic_state=None) -> str | None:
    """上游阶段的指纹 = digest(status + doc_hashes + 其上游指纹)——
    任何上游重冻结（内容或其上游变化）都会改变指纹，驱动下游递归失效
    （第八轮审计 P1：此前只校验本阶段哈希，上游 v2 重冻结后旧下游仍 FROZEN）。"""
    if dynamic_state is not None:
        if (dynamic_state.state != "FROZEN" or dynamic_state.plan is None
                or not participating_documents(dynamic_state.plan, stage)):
            return None
        fingerprint = _dynamic_stage_fingerprint(req_dir, dynamic_state, stage)
        return None if fingerprint == "0" * 64 else fingerprint

    # A gate record is not a current credential by itself. Validate the stage
    # first so an edited-but-not-refrozen upstream invalidates descendants too.
    state, _detail = stage_frozen(req_dir, stage)
    if state != "FROZEN":
        return None
    gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
    if gate is None:
        return None
    try:
        g = json.loads(gate)
    except json.JSONDecodeError:
        return None
    ident = {"status": g.get("status"),
             "doc_hashes": g.get("doc_hashes"),
             "execution_baseline_hashes": g.get("execution_baseline_hashes"),
             "upstream_fingerprints": g.get("upstream_fingerprints")}
    if stage == "计划":
        closeout_text = _read(req_dir / "reviews" / "计划.closeout.json")
        if closeout_text is not None:
            try:
                closeout = json.loads(closeout_text)
            except json.JSONDecodeError:
                closeout = {}
            ident["closeout_doc_hashes"] = closeout.get("doc_hashes")
    return hashlib.sha256(
        json.dumps(ident, ensure_ascii=False, sort_keys=True).encode()).hexdigest()


def _dynamic_sidecar_present(req_dir: Path) -> bool:
    """A partial dynamic publication must never be guessed as legacy-static.

    T5 activation will replace this transitional guard with validated plan,
    credential and binding state evaluation. Until then all dynamic sidecars
    fail closed, including a damaged journal or publish temporary file.
    """
    reviews = req_dir / "reviews"
    if reviews.is_symlink():
        return True
    if not reviews.is_dir():
        return False
    return any(
        item.name in {"artifact-plan.json", "artifact-plan.gate.json",
                      "artifact-plan.tx.json"}
        or item.name.endswith(".plan-binding.json")
        or item.name.startswith(".artifact-plan-write-")
        for item in reviews.iterdir()
    )


def stage_frozen(req_dir: Path, stage: str, dynamic_state=None) -> tuple[str, str]:
    """返回 (状态, 说明)。状态: FROZEN / DRAFT / BLOCKED / NOT_GATED / MISSING / INVALID。

    FROZEN = gate.json PASS 且文档哈希一致 且 上游指纹与冻结时一致；
    上游重冻结/本阶段改动 → DRAFT（下游需重过门禁——递归失效）。
    """
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            return "INVALID", f"动态计划不可用：{dynamic_state.reason}"
        if not participating_documents(dynamic_state.plan, stage):
            return "SKIPPED", "ArtifactPlan 已证明本阶段无需产物"
        states = evaluate_stage_states(
            dynamic_state, _dynamic_snapshots(req_dir, dynamic_state))
        current = states.get(stage, "INVALID")
        if current == "BOUND":
            return "FROZEN", "ArtifactPlan binding 与当前门禁、文档及前置指纹一致"
        if current == "UNBOUND":
            return "NOT_GATED", "阶段尚未绑定到冻结 ArtifactPlan"
        if current == "STALE":
            return "DRAFT", "ArtifactPlan binding 已过期，需重新门禁"
        return "INVALID", "ArtifactPlan binding 无效"
    if _dynamic_sidecar_present(req_dir):
        return "INVALID", "动态计划存在但未能建立同锁快照"
    if stage in HUMAN_SIGNOFF:
        # 人工签核阶段（需求分析/业务流程设计）：文本签核不是凭证——必须有
        # gate.json 绑定内容哈希，签核后改动会被哈希检出
        doc = STAGES[stage]["docs"][0]
        if not (req_dir / doc).is_file():
            return "MISSING", f"{doc} 不存在"
        gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
        if gate is None:
            sign_re, _want = HUMAN_SIGNOFF[stage]
            m = re.search(sign_re, _read(req_dir / doc) or "")
            signed = m.group(1) if m else "未记录"
            return "DRAFT", (f"未过 doc-gate freeze（签核状态：{signed}——"
                            f"文本不构成凭证）")
        try:
            g = json.loads(gate)
        except json.JSONDecodeError:
            return "DRAFT", f"{stage}.gate.json 损坏"
        if g.get("status") != "PASS":
            return "DRAFT", f"{stage}最近判定 {g.get('status')}"
        want = (g.get("doc_hashes") or {}).get(doc)
        cur = _sha256(req_dir / doc)
        if want != cur:
            return "DRAFT", f"{doc} 签核后有改动（哈希失配）——需人工重审并重新 freeze"
        recorded = g.get("upstream_fingerprints") or {}
        for up in STAGES[stage]["upstream"]:
            cur_fp = _stage_fingerprint(req_dir, up, dynamic_state)
            if cur_fp is None or recorded.get(up) != cur_fp:
                return "DRAFT", f"上游 {up} 已重新冻结（指纹失配）——需重新签核"
        return "FROZEN", f"gate.json 通过（{g.get('approved_by', '未知')} 签核）"

    gate_file = req_dir / "reviews" / f"{stage}.gate.json"
    data = _read(gate_file)
    if data is None:
        return "NOT_GATED", "无 gate.json（未过门禁）"
    try:
        gate = json.loads(data)
    except json.JSONDecodeError:
        return "DRAFT", "gate.json 损坏"
    if gate.get("status") == "BLOCKED":
        return "BLOCKED", "最近判定 BLOCKED（人工介入）"
    if gate.get("status") != "PASS":
        return "DRAFT", f"最近判定 {gate.get('status')}"
    plan_detail = None
    if stage == "计划":
        closeout_file = req_dir / "reviews" / "计划.closeout.json"
        closeout_text = _read(closeout_file)
        if closeout_text is not None:
            try:
                closeout = json.loads(closeout_text)
            except json.JSONDecodeError:
                return "DRAFT", "计划.closeout.json 损坏"
            if closeout.get("status") != "PASS":
                return "DRAFT", "计划收口凭证不是 PASS"
            if closeout.get("plan_gate_sha256") != _sha256(gate_file):
                return "DRAFT", "计划门禁已更新——需重新收口"
            closeout_hashes = closeout.get("doc_hashes") or {}
            if set(closeout_hashes) != set(STAGES["计划"]["docs"]):
                return "DRAFT", "计划收口凭证未完整覆盖阶段文档"
            for doc, want in closeout_hashes.items():
                cur = _sha256(req_dir / doc)
                if cur is None:
                    return "DRAFT", f"{doc} 已不存在"
                if cur != want:
                    return "DRAFT", f"{doc} 收口后有改动（哈希失配）"
            plan_detail = "gate.json PASS（已收口，完整终态哈希一致）"
        elif gate.get("execution_baseline_hashes"):
            current = _plan_baseline_hashes(req_dir)
            baseline_hashes = gate["execution_baseline_hashes"]
            if set(baseline_hashes) != set(STAGES["计划"]["docs"]):
                return "DRAFT", "执行前计划基线未完整覆盖阶段文档"
            for doc, want in baseline_hashes.items():
                if current.get(doc) != want:
                    return "DRAFT", f"{doc} 执行前计划基线有改动（哈希失配）"
            plan_detail = "gate.json PASS（执行中，允许更新执行记录与勾选状态）"
        else:
            # Legacy credentials predate the execution baseline projection.
            for doc, want in (gate.get("doc_hashes") or {}).items():
                cur = _sha256(req_dir / doc)
                if cur is None:
                    return "DRAFT", f"{doc} 已不存在"
                if cur != want:
                    return "DRAFT", f"{doc} 冻结后有改动（哈希失配）"
    else:
        for doc, want in (gate.get("doc_hashes") or {}).items():
            cur = _sha256(req_dir / doc)
            if cur is None:
                return "DRAFT", f"{doc} 已不存在"
            if cur != want:
                return "DRAFT", f"{doc} 冻结后有改动（哈希失配）"
    # 上游指纹核验（第八轮审计 P1）：任一上游重冻结 → 本阶段失效，需重过门禁
    recorded = gate.get("upstream_fingerprints") or {}
    for up in STAGES[stage]["upstream"]:
        cur_fp = _stage_fingerprint(req_dir, up, dynamic_state)
        if cur_fp is None:
            return "DRAFT", f"上游 {up} 的 gate 凭证缺失"
        if recorded.get(up) != cur_fp:
            return "DRAFT", (f"上游 {up} 已重新冻结（指纹失配）——"
                            f"本阶段需重过门禁")
    if plan_detail is not None:
        return "FROZEN", plan_detail
    return "FROZEN", f"gate.json PASS（iteration {gate.get('iteration')}）"


# ══════════════════════════ 硬校验引擎 ══════════════════════════

class Checks:
    def __init__(self, stage: str):
        self.stage = stage
        self.items: list[dict] = []

    def add(self, group: str, name: str, ok: bool, detail: str = "") -> None:
        self.items.append({"group": group, "name": name,
                           "status": "PASS" if ok else "FAIL", "detail": detail})

    @property
    def fails(self) -> list[dict]:
        return [c for c in self.items if c["status"] == "FAIL"]

    def to_dict(self) -> dict:
        return {"stage": self.stage, "checks": self.items,
                "summary": {"pass": len(self.items) - len(self.fails),
                            "fail": len(self.fails)}}


def _check_structure(c: Checks, doc: str, text: str, required: list[str]) -> None:
    headers = re.findall(r"^##\s+(.+)$", text, re.M)
    def _norm(h: str) -> str:
        h = re.split(r"[（(]", h.strip())[0].strip()
        return re.sub(r"^\d+(\.\d+)*[.、\s]*", "", h)   # 剥编号前缀（"1. 简介"→"简介"）
    have = {_norm(h) for h in headers}
    missing = [s for s in required if s not in have]
    c.add("structure", f"必填章节：{doc}",
          not missing, "缺失: " + "、".join(missing) if missing else "")


def _check_placeholders(c: Checks, doc: str, text: str) -> None:
    ph = _placeholders(text)
    c.add("placeholder", f"占位符已替换：{doc}", not ph,
          f"残留 {len(ph)} 处: {'、'.join(ph[:3])}…" if ph else "")


def _effective_stage_spec(stage: str, dynamic_state=None) -> dict:
    spec = STAGES[stage]
    if dynamic_state is None or dynamic_state.plan is None:
        return spec
    documents = list(participating_documents(dynamic_state.plan, stage))
    return {
        "docs": documents,
        "upstream": list(participating_prerequisites(dynamic_state.plan, stage)),
        "review": spec["review"],
        "sections": {doc: spec["sections"][doc] for doc in documents},
    }


def run_checks(req_dir: Path, stage: str, dynamic_state=None) -> Checks:
    """对一个阶段跑全部硬校验（含上游冻结与需求意图检查）。"""
    c = Checks(stage)
    spec = _effective_stage_spec(stage, dynamic_state)

    if dynamic_state is not None and not spec["docs"]:
        c.add("plan", "阶段由 ArtifactPlan 跳过", True,
              "无需生成、评审或冻结本阶段产物")
        return c

    # ── 上游冻结 ──
    for up in spec["upstream"]:
        st, why = stage_frozen(req_dir, up, dynamic_state)
        c.add("upstream", f"上游已冻结：{up}", st == "FROZEN", why)

    # ── 需求意图（薄输入拒绝——任何阶段都校验最上游，需求分析阶段本身也检查）──
    req_text = _read(req_dir / "需求分析.md")
    if req_text is not None:
        scen = parse_scenarios(req_text)
        ok_scen = bool(scen) and all(
            s["前置"] and s["操作"] and s["结果"]
            and not _placeholders(s["前置"] + s["操作"] + s["结果"])
            for s in scen.values())
        c.add("intent", "需求场景完整（前置/操作/结果 已填）", ok_scen,
              "场景为空或 Given/When/Then 未填写/仍为占位符" if not ok_scen else "")
        a_items = parse_a_items(req_text)
        ok_a = bool(a_items) and all(not _placeholders(v["text"]) for v in a_items.values())
        c.add("intent", "验收项非占位", ok_a,
              "验收项为空或仍为占位符" if not ok_a else "")

    # ── 本阶段文档 ──
    for doc in spec["docs"]:
        text = _read(req_dir / doc)
        if text is None:
            c.add("structure", f"文档存在：{doc}", False, "文件不存在")
            continue
        _check_structure(c, doc, text, spec["sections"][doc])
        _check_placeholders(c, doc, text)

    if stage == "业务流程设计":
        flow_text = _read(req_dir / "业务流程设计.md") or ""
        _check_business_process_diagram(c, req_dir, flow_text)

    # ── 各阶段追踪链 ──
    req_a = parse_a_items(req_text) if req_text else {}

    if stage == "概要设计":
        text = _read(req_dir / "概要设计.md") or ""
        f_items = parse_f_items(text)
        covered = [a for f in f_items.values() for a in f["covers"]]
        dangling = [a for f in f_items.values() for a in f["covers"] if a not in req_a]
        c.add("trace", "每个验收项被 ≥1 功能点覆盖",
              bool(f_items) and set(req_a) <= set(covered),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered))) or '无')}")
        c.add("id", "功能点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "UI设计":
        text = _read(req_dir / "UI设计.md") or ""
        pages = parse_page_items(text)
        c.add("id", "页面清单非空", bool(pages), "无 PAGE 项")
        bad_states = [p for p, v in pages.items() if not v["states_ok"]]
        c.add("ui", "每页状态枚举完整（或 N/A）",
              not bad_states, f"缺状态: {'、'.join(bad_states)}" if bad_states else "")
        f_all = parse_f_items(_read(req_dir / "概要设计.md") or "")
        dangling = [r for v in pages.values() for r in v["refs"]
                    if r not in f_all and r not in req_a]
        c.add("id", "页面引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "详细设计":
        d_items: dict = {}
        for doc in spec["docs"]:
            text = _read(req_dir / doc)
            d_items.update(parse_d_items(text) if text is not None else {})
        f_all = parse_f_items(_read(req_dir / "概要设计.md") or "")
        covered_f = [f for v in d_items.values() for f in v["f"]]
        c.add("trace", "每个功能点有 ≥1 设计落点",
              bool(d_items) and set(f_all) <= set(covered_f),
              f"未落点: {('、'.join(sorted(set(f_all) - set(covered_f))) or '无')}")
        dangling = [r for v in d_items.values() for r in v["f"] + v["a"]
                    if (r.startswith("F") and r not in f_all)
                    or (r.startswith("A") and r not in req_a)]
        c.add("id", "落点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "计划":
        task_text = _read(req_dir / "任务清单.md") or ""
        test_text = _read(req_dir / "测试方案.md") or ""
        t_items = parse_t_items(task_text)
        tc_items = parse_tc_items(test_text)
        d_all: dict = {}
        detail_docs = set(_effective_stage_spec("详细设计", dynamic_state)["docs"])
        for doc in ("详细设计.md", "API设计.md", "数据库设计.md"):
            if doc not in detail_docs:
                continue
            text = _read(req_dir / doc)
            d_all.update(parse_d_items(text) if text is not None else {})

        covered_a = [a for v in tc_items.values() for a in v["accepts"]]
        c.add("trace", "任务清单至少包含一个任务", bool(t_items), "无 T-ID")
        c.add("trace", "每个验收项有 ≥1 测试用例",
              bool(tc_items) and set(req_a) <= set(covered_a),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered_a))) or '无')}")
        bad_tc = [tc for tc, v in tc_items.items() if not v["accepts"]]
        c.add("id", "用例挂接验收项", not bad_tc,
              f"未挂接: {'、'.join(bad_tc)}" if bad_tc else "")
        bad_t = [t for t, v in t_items.items()
                 if not v["designs"] or not v["has_verify"] or not v["has_scope"]]
        c.add("trace", "每任务绑定设计+验证方式+预计范围", not bad_t,
              f"缺项: {'、'.join(bad_t)}" if bad_t else "")
        dangling = [r for v in t_items.values() for r in v["designs"]
                    if (r.startswith("TC") and r not in tc_items)
                    or (r.startswith("D") and r not in d_all)]
        c.add("id", "任务引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    return c


