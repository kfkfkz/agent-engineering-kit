def _plan_baseline_text(doc: str, text: str) -> str:
    """Return the immutable planning projection used during execution.

    Task definitions, scopes and verification methods remain hash-bound.  Only
    checkbox state and the body of the execution-record section are mutable;
    closeout later binds the complete final documents again.
    """
    # This semantic execution projection historically used universal-newline
    # text. Preserve those existing credentials while review/full-closeout
    # hashes continue binding the original bytes.
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    projected = re.sub(r"(?m)^(\s*[-*]\s*)\[[ xX]\]", r"\1[ ]", text)
    if doc == "任务清单.md":
        projected = re.sub(
            r"(?ms)(^##\s+执行记录\s*\n).*?(?=^##\s+|\Z)",
            r"\1<AEK-EXECUTION-RECORD>\n\n",
            projected,
        )
    return projected


def _plan_baseline_hashes(req_dir: Path, *, source_materials=None) -> dict[str, str]:
    hashes = {}
    for doc in STAGES["计划"]["docs"]:
        text = (source_materials[doc].decode("utf-8", errors="strict") if source_materials is not None and doc in source_materials
                else None if source_materials is not None else _read(req_dir / doc))
        if text is not None:
            hashes[doc] = hashlib.sha256(
                _plan_baseline_text(doc, text).encode("utf-8")
            ).hexdigest()
    return hashes


def _execution_record_rows(text: str) -> dict[str, list[str]]:
    match = re.search(
        r"(?ms)^##\s+执行记录\s*\n(.*?)(?=^##\s+|\Z)", text
    )
    if match is None:
        return {}
    rows = {}
    for line in match.group(1).splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if cells and re.fullmatch(r"T\d+", cells[0]):
            rows[cells[0]] = cells
    return rows


def _task_sections(text: str) -> dict[str, tuple[str, int, int]]:
    """Return each frozen task definition without bleeding into its siblings."""
    matches = list(re.finditer(r"(?m)^###\s*(T\d+)：[^\n]*$", text))
    sections: dict[str, tuple[str, int, int]] = {}
    execution = re.search(r"(?m)^##\s+执行记录\s*$", text)
    document_end = execution.start() if execution else len(text)
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else document_end
        sections[match.group(1)] = (text[match.start():end], match.start(), end)
    return sections


def _release_blocking_tasks(
    text: str, tasks: dict[str, dict],
) -> tuple[dict[str, bool], list[str], dict[str, tuple[str, int, int]]]:
    """Read the frozen opt-out marker; absence stays release-blocking."""
    sections = _task_sections(text)
    blocking: dict[str, bool] = {}
    failures: list[str] = []
    for task_id in tasks:
        section = sections.get(task_id)
        if section is None:
            failures.append(f"{task_id} 缺任务定义区块")
            blocking[task_id] = True
            continue
        marker_lines = re.findall(
            r"(?m)^-\s*发布阻塞[:：]\s*([^\n]+?)\s*$", section[0])
        if not marker_lines:
            blocking[task_id] = True  # legacy plans remain conservative
            continue
        if len(marker_lines) != 1:
            failures.append(f"{task_id} 发布阻塞标记重复")
            blocking[task_id] = True
            continue
        marker = re.sub(r"\s*（[^）]*）\s*$", "", marker_lines[0]).strip()
        if marker not in {"是", "否"}:
            failures.append(f"{task_id} 发布阻塞标记必须为是/否")
            blocking[task_id] = True
            continue
        blocking[task_id] = marker == "是"
    return blocking, failures, sections


def _plan_completion_failures(req_dir: Path, *, source_materials=None) -> list[str]:
    def read(name):
        return (source_materials.get(name, b"").decode("utf-8", errors="strict")
                if source_materials is not None else _read(req_dir / name) or "")
    task_text = read("任务清单.md")
    test_text = read("测试方案.md")
    tasks = parse_t_items(task_text)
    rows = _execution_record_rows(task_text)
    failures = []
    blocking, marker_failures, sections = _release_blocking_tasks(task_text, tasks)
    failures.extend(marker_failures)
    deferred: set[str] = set()
    if not tasks:
        failures.append("任务清单没有可收口的 T-ID")
    for task_id in tasks:
        cells = rows.get(task_id)
        if cells is None:
            failures.append(f"{task_id} 缺执行记录")
            continue
        state = cells[1] if len(cells) > 1 else ""
        actual_scope = cells[2] if len(cells) > 2 else ""
        verification = cells[3] if len(cells) > 3 else ""
        if state in ("延期", "DEFERRED") and not blocking.get(task_id, True):
            deferred.add(task_id)
        elif state not in ("完成", "DONE"):
            failures.append(f"{task_id} 状态不是完成")
        if not actual_scope:
            failures.append(f"{task_id} 缺实际改动范围")
        if not verification:
            failures.append(f"{task_id} 缺验证结果")
    unknown_rows = sorted(set(rows) - set(tasks))
    if unknown_rows:
        failures.append("执行记录含未知任务: " + "、".join(unknown_rows))
    completion_text = task_text
    ignored_spans = sorted(
        (sections[task_id][1], sections[task_id][2])
        for task_id in deferred if task_id in sections)
    for start, end in reversed(ignored_spans):
        completion_text = completion_text[:start] + completion_text[end:]
    unchecked = len(re.findall(
        r"(?m)^\s*[-*]\s*\[\s*\]", completion_text + "\n" + test_text))
    if unchecked:
        failures.append(f"仍有 {unchecked} 个未完成检查项")
    return failures


def _archify_delivery_error(receipt_path: Path) -> tuple[str | None, str | None]:
    """校验一份业务流程 Archify delivery receipt 及其绑定产物。

    文件命名契约：<name>.workflow.json / <name>.html /
    <name>.delivery.json。receipt 是证据，不是单纯的“成功”标记；
    必须与当前 source 和 HTML 的 bytes + sha256 一致。
    """
    suffix = ".delivery.json"
    if not receipt_path.name.endswith(suffix):
        return None, f"receipt 命名非法: {receipt_path.name}"
    name = receipt_path.name[:-len(suffix)]
    try:
        parent = _open_dir_nofollow(receipt_path.parent)
        try:
            receipt = json.loads(_read_beneath(parent, receipt_path.name, MAX_DOCUMENT_BYTES))
            source_bytes = _read_beneath(parent, f"{name}.workflow.json", MAX_DOCUMENT_BYTES)
            artifact_bytes = _read_beneath(parent, f"{name}.html", MAX_HTML_BYTES)
        finally:
            _ui_fs.close_dir(parent)
        source_data = json.loads(source_bytes.decode("utf-8"))
    except (OSError, ValueError) as e:
        return name, f"{name}: 产物或 receipt 不可读/不是合法 JSON: {e}"

    if not isinstance(receipt, dict) or not isinstance(source_data, dict):
        return name, f"{name}: source/receipt 顶层必须是 object"
    if (source_data.get("schema_version") != 2
            or source_data.get("diagram_type") != "workflow"
            or not isinstance(source_data.get("meta"), dict)
            or source_data["meta"].get("quality_profile") != "showcase"):
        return name, f"{name}: 必须是 schema v2 showcase workflow source"
    if (receipt.get("schemaVersion") != 1 or receipt.get("ok") is not True
            or receipt.get("command") != "deliver"
            or receipt.get("type") != "workflow"):
        return name, f"{name}: delivery receipt envelope 非法"

    specification = receipt.get("specification")
    artifact_info = receipt.get("artifact")
    validation = receipt.get("validation")
    if not all(isinstance(v, dict)
               for v in (specification, artifact_info, validation)):
        return name, f"{name}: delivery receipt 缺少证据字段"
    expected_source = hashlib.sha256(source_bytes).hexdigest()
    expected_artifact = hashlib.sha256(artifact_bytes).hexdigest()
    if (specification.get("sha256") != expected_source
            or specification.get("bytes") != len(source_bytes)):
        return name, f"{name}: workflow source 与 delivery receipt 失配"
    if (artifact_info.get("sha256") != expected_artifact
            or artifact_info.get("bytes") != len(artifact_bytes)):
        return name, f"{name}: HTML 与 delivery receipt 失配"
    if b'<meta name="generator" content="archify ' not in artifact_bytes:
        return name, f"{name}: HTML 缺少 archify generator 标识"
    if (validation.get("checksPassed") != validation.get("checkCount")
            or not isinstance(validation.get("checkCount"), int)
            or validation["checkCount"] < 9
            or validation.get("compositionProfile") != "showcase"
            or validation.get("compositionStatus") != "pass"
            or validation.get("errors") != 0
            or validation.get("warnings") != 0):
        return name, f"{name}: delivery 未达到 showcase 9/9 无警告契约"
    return name, None


def _check_business_process_diagram(c, req_dir: Path, text: str) -> None:
    """默认强制 Archify 证据链；只接受显式 Node<18 DEGRADED 降级。"""
    fallback = bool(re.search(
        r"(?m)^>\s*图表模式[:：]\s*Mermaid\s+降级\s*$", text))
    mermaid = "```mermaid" in text.lower()
    if fallback:
        reason = bool(re.search(
            r"(?mi)^>\s*降级原因[:：].*Node\.js\s*"
            r"(?:<\s*18|未安装|不存在|不可用).*"
            r"archify\s+doctor[:：]\s*DEGRADED", text))
        c.add("diagram", "Mermaid 降级有 doctor DEGRADED 依据",
              mermaid and reason,
              "降级必须含 Mermaid 图，并披露 Node.js 未安装/<18 + "
              "archify doctor: DEGRADED")
        return

    diagrams = req_dir / "diagrams"
    receipts = sorted(diagrams.glob("*.delivery.json")) if diagrams.is_dir() else []
    valid_names: list[str] = []
    errors: list[str] = []
    for receipt_path in receipts:
        name, error = _archify_delivery_error(receipt_path)
        if error:
            errors.append(error)
        elif name is not None:
            valid_names.append(name)
    c.add("diagram", "Archify workflow/HTML/delivery receipt 一致",
          bool(valid_names),
          "；".join(errors) if errors else "缺少可核验的 diagrams/*.delivery.json")
    linked = any(
        re.search(rf"\]\(\s*diagrams/{re.escape(name)}\.html(?:\s+[^)]*)?\)", text)
        for name in valid_names)
    c.add("diagram", "文档引用已验证的 Archify HTML", linked,
          "需链接 diagrams/<name>.html，且同名 delivery receipt 通过")
    c.add("diagram", "Archify 模式不混入 Mermaid 回退", not mermaid,
          "检测到 Mermaid；只有显式 DEGRADED 模式才允许回退")


def _block(text: str, pos: int) -> str:
    """从标题位置取到下一个同级或更高级标题前的文本块。"""
    # Use the same horizontal-whitespace grammar as scenario headings. A
    # tab-separated next heading must not leave two scenarios in one block.
    following = re.compile(r"^#{1,3}(?!#)(?:[ \t]+|(?=\r?$)|(?=场景[ \t]*\d+：))", re.M).search(text, pos + 1)
    # Preserve the historical block bytes: the separator newline belongs to
    # neither block. Existing prototype dependency digests use these bytes.
    end = following.start() - 1 if following else len(text)
    return text[pos:end]


def _placeholders(text: str) -> list[str]:
    return re.findall(r"〈[^〉]+〉", text)


def _repo_root(start: Path) -> Path | None:
    for p in [start, *start.parents]:
        if (p / ".repo-memory-kit").is_dir() or (p / ".git").exists() or (p / ".svn").exists():
            return p
    return None


def _package_locations(req_dir: Path):
    root = _repo_root(req_dir)
    if root is None:
        # Preserve explicit legacy fixture/repository directories without
        # guessing the root of an unregistered nested version layout.
        if req_dir.parent.name != "03-SDD" or req_dir.parent.parent.name != "docs":
            raise ValueError("NOT_REGISTERED: repository root unavailable")
        root = req_dir.parents[2]
    relative = req_dir.absolute().relative_to(root.absolute()).as_posix()
    return root, resolve_package(root, relative)


def _validate_registered_package(req_dir: Path):
    root = _repo_root(req_dir)
    if root is None:
        return
    relative = req_dir.absolute().relative_to(root.absolute()).as_posix()
    handle = _ui_fs.open_absolute_dir(root)
    try:
        registered = any(row['package_ref'] == relative for row in package_registry(handle))
    finally:
        _ui_fs.close_dir(handle)
    metadata = req_dir / 'reviews/package.json'
    if registered or metadata.exists() or metadata.is_symlink() or relative.startswith('docs/需求/'):
        resolve_package(root, relative)


def _registered_package_identity(req_dir):
    _validate_registered_package(req_dir)
    metadata = req_dir / 'reviews/package.json'
    if not (metadata.exists() or metadata.is_symlink()):
        return None
    _root, package = _package_locations(req_dir)
    return {key: getattr(package, key) for key in
            ('change_id', 'revision', 'package_ref', 'source_root', 'design_root')}


def _require_gate_package(req_dir, gate, expected=None):
    if type(gate) is not dict:
        raise ValueError('invalid Gate package envelope')
    current = _registered_package_identity(req_dir)
    if gate.get('package_identity') != current or (expected is not None and current != expected):
        raise ValueError('SOURCE_CHANGED: Gate package identity no longer matches this operation')


def _load_policy(root: Path | None) -> dict:
    policy = dict(DEFAULT_POLICY)
    if not root:
        return policy
    f = root / ".repo-memory-kit" / "doc-policy.json"
    if not f.exists():
        return policy
    text = _read(f)
    if text is None:
        raise PolicyError(f"无法读取 {f}")
    try:
        user = json.loads(text)
    except json.JSONDecodeError as e:
        raise PolicyError(f"JSON 语法错误（第 {e.lineno} 行第 {e.colno} 列）") from e
    if not isinstance(user, dict):
        raise PolicyError("顶层必须是 JSON object")
    unknown = sorted(set(user) - set(DEFAULT_POLICY))
    if unknown:
        raise PolicyError(f"未知字段: {', '.join(unknown)}")
    for key, value in user.items():
        if type(value) is not int or value < 0:
            raise PolicyError(f"{key} 必须是非负整数")
        policy[key] = value
    if policy["max_iterations"] < 1:
        raise PolicyError("max_iterations 必须大于等于 1")
    return policy


