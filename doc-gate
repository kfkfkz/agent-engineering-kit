def _prototype_selection_targets(targets) -> tuple:
    if not isinstance(targets, (list, tuple)) or not 1 <= len(targets) <= 32:
        raise ValueError('select between 1 and 32 explicit prototype targets')
    result = []
    for target in targets:
        if not isinstance(target, (list, tuple)) or len(target) != 4:
            raise ValueError('each target requires PAGE/AREA/STATE/context')
        result.append(_prototype_target(dict(zip(
            ('page_id', 'area_id', 'state_id', 'context_id'), target)), 2))
    if len(set(result)) != len(result):
        raise ValueError('duplicate prototype selection')
    return tuple(sorted(result))


def _prototype_prepared_payload(items: list, schema_version=2) -> dict:
    payload = {'schema_version': schema_version, 'status': 'PREPARED', 'per_item': items}
    raw = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode('utf-8')
    # Each immutable receipt may carry this selection; stay below its 64KiB read limit.
    if len(raw) > 48 * 1024:
        raise ValueError('prepared selection exceeds 48KiB; narrow the selection')
    payload['prepare_sha256'] = hashlib.sha256(raw).hexdigest()
    return payload


def _prototype_selection_phrase(selection: dict, member: dict) -> str:
    """Bind a group decision to an actual current member, not a self-reported status."""
    if (type(selection) is not dict
            or set(selection) != {'schema_version', 'status', 'per_item', 'prepare_sha256'}
            or type(selection['schema_version']) is not int or selection['schema_version'] != 2
            or selection['status'] != 'PREPARED' or type(selection['per_item']) is not list):
        raise ValueError('invalid confirmation selection')
    items = selection['per_item']
    if any(type(item) is not dict for item in items):
        raise ValueError('invalid confirmation selection member')
    targets = _prototype_selection_targets([_prototype_target(item, 2) for item in items])
    fields = {'page_id', 'area_id', 'state_id', 'context_id', 'prototype_path',
              'prototype_sha256', 'dependency_sha256', 'scope_digest', 'evidence_contexts'}
    for item in items:
        if (type(item) is not dict or set(item) != fields
                or type(item['prototype_path']) is not str or len(item['prototype_path']) > 500
                or type(item['evidence_contexts']) is not list
                or any(type(item[key]) is not str or not _PROTOTYPE_DIGEST.fullmatch(item[key])
                       for key in ('prototype_sha256', 'dependency_sha256', 'scope_digest'))):
            raise ValueError('invalid confirmation selection member')
    if (tuple(_prototype_target(item, 2) for item in items) != targets
            or _prototype_prepared_payload(items) != selection
            or sum(all(item.get(key) == value for key, value in member.items()) for item in items) != 1):
        raise ValueError('confirmation selection does not bind the current member')
    return f"ACCEPT {selection['prepare_sha256'][:12]}"


def _prototype_preparation_maps(req_dir: Path, targets, *, require_confirmation=False, strict=True,
                                preview_out=None, schema_version=2) -> dict:
    """Two bounded group reads; no output survives an intervening dependency change."""
    targets = _prototype_selection_targets(targets)
    snapshots = []
    preview_snapshots = []
    dynamic_state = None
    if schema_version == 3:
        store = PlanStore(req_dir / 'reviews')
        with store.read_view(req_dir) as view:
            plan_snapshot = view.snapshot()
            consumer_digest = view.consumer_digest
        dynamic_state = _dynamic_state_from_snapshot(plan_snapshot, req_dir=req_dir)
        if dynamic_state is None or dynamic_state.state != 'FROZEN':
            raise ValueError('interactive prototypes require a frozen ArtifactPlan')
    for _ in range(2):
        text, mapped_ui = _ui_stage_material(req_dir, dynamic_state)
        if _prototype_manifest(text)['schema_version'] != schema_version:
            raise ValueError(f'prototype-prepare requires an explicit v{schema_version} manifest')
        checks, prepared, previews = Checks('UI设计'), {}, {}
        _check_ui_prototypes(checks, req_dir, text, require_confirmation=require_confirmation,
                             dynamic_state=dynamic_state, selected_targets=set(targets), preparation_out=prepared,
                             preview_out=previews if preview_out is not None else None, mapped_ui=mapped_ui)
        if strict and (checks.fails or set(prepared) != set(targets)):
            raise ValueError('current prototype preparation failed: ' + '；'.join(
                item['detail'] or item['name'] for item in checks.fails[:3]))
        snapshots.append(prepared)
        preview_snapshots.append(previews)
    if schema_version == 3:
        with store.read_view(req_dir) as view:
            if (view.snapshot() != plan_snapshot or view.consumer_digest != consumer_digest
                    or _dynamic_state_from_snapshot(plan_snapshot, req_dir=req_dir) != dynamic_state):
                raise ValueError('ArtifactPlan or approval changed during interactive preparation')
    if strict and snapshots[0] != snapshots[1]:
        raise ValueError('prototype or dependencies changed during preparation')
    if preview_out is not None:
        if preview_snapshots[0] != preview_snapshots[1] or set(preview_snapshots[1]) != set(targets):
            raise ValueError('preview sources changed during preparation')
        preview_out.update(preview_snapshots[1])
    return {target: snapshots[1][target] for target in targets
            if target in snapshots[1] and snapshots[0].get(target) == snapshots[1][target]}


def _prepare_prototype_selection(req_dir: Path, targets, schema_version=2) -> dict:
    items = _prototype_preparation_maps(req_dir, targets, schema_version=schema_version)
    return _prototype_prepared_payload([items[target] for target in sorted(items)], schema_version)


def _prepare_prototype_v2(req_dir: Path, target: tuple) -> dict:
    """Read-only optimistic preparation, never a maintainer decision."""
    return _prepare_prototype_selection(req_dir, [target])


def _prepare_prototype_preview(req_dir: Path, targets, *, render_profiles=None, schema_version=2) -> bytes:
    """Derive a report from selected Gate-verified snapshots, then recheck all sources."""
    targets = _prototype_selection_targets(targets)
    profiles = {}
    if render_profiles is not None:
        from aek.adapters.ui_interactive_host import LinuxInteractiveHostProfile
        from aek.adapters.ui_render_host import LinuxRenderHostProfile
        profile_type = LinuxInteractiveHostProfile if schema_version == 3 else LinuxRenderHostProfile
        if (type(render_profiles) is not dict or not set(render_profiles) <= set(targets)
                or any(type(profile) is not profile_type or profile._target != target
                       for target, profile in render_profiles.items())):
            raise ValueError('render profiles must be fixed controller-selected profiles for this selection')
        # Freeze the controller mapping, not a caller-owned mutable registry.
        profiles = {target: render_profiles[target] for target in targets if target in render_profiles}
    previews = {}
    prepared = _prototype_preparation_maps(req_dir, targets, preview_out=previews, schema_version=schema_version)
    selection = _prototype_prepared_payload([prepared[target] for target in targets], schema_version)
    package_root, package = _package_locations(req_dir)
    material = _open_dir_nofollow(package_root / package.material_root)
    items, encoded_bytes = [], 0
    try:
        for target in targets:
            references = []
            for ref in previews[target]:
                encoded_bytes += 4 * ((ref['bytes'] + 2) // 3)
                if encoded_bytes > MAX_PREVIEW_REPORT_BYTES:
                    raise ValueError('preview selection exceeds report image budget')
                raw = _read_beneath(material, ref['path'], MAX_PNG_BYTES)
                if len(raw) != ref['bytes'] or hashlib.sha256(raw).hexdigest() != ref['image_sha256']:
                    raise ValueError('preview image changed after preparation')
                _validate_png_reader(io.BytesIO(raw).read, len(raw), max_pixels=MAX_PHYSICAL_PIXELS)
                references.append(PreviewReference(ref['evidence_id'], target[3], raw, ref['image_sha256']))
            items.append(PreviewItem(target, references=tuple(references)))
    finally:
        _ui_fs.close_dir(material)
    def read_render(target, profile):
        if schema_version == 3:
            return profile.read_preview_result(expected_item=prepared[target])
        return profile.read_result(expected_item=prepared[target])
    rendered = {target: read_render(target, profile) for target, profile in profiles.items()}
    items = [replace(item, render=rendered.get(item.target)) for item in items]
    report = build_static_preview(selection, items)
    def recheck_material():
        current_previews = {}
        current = _prototype_preparation_maps(req_dir, targets, preview_out=current_previews,
                                              schema_version=schema_version)
        if (_prototype_prepared_payload([current[target] for target in targets], schema_version) != selection
                or current_previews != previews):
            raise ValueError('preview dependencies changed during report generation')
    recheck_material()
    if profiles:
        # Two bounded observations, not a claim of a globally atomic snapshot
        # across independently written source files. Never execute or approve.
        for target, profile in profiles.items():
            if read_render(target, profile) != rendered[target]:
                raise ValueError('trusted render source changed during report generation')
        recheck_material()
        # All source/material/proof IO is complete. This final control-side
        # fence is pure and must not reopen a new proof or runtime IO window.
        if any(profile.control_fence() is not True for profile in profiles.values()):
            raise ValueError('trusted render control context changed during report generation')
    return report.html


def cmd_prototype_prepare(req_dir: Path, page_id: str, area_id: str,
                          state_id: str, context_id: str, as_json: bool, *, targets=None,
                          preview_html=False, render_profiles=None, schema_version=2) -> int:
    try:
        if preview_html:
            if as_json:
                raise ValueError('--preview-html cannot be combined with --json')
            html = _prepare_prototype_preview(req_dir, targets if targets is not None
                else [(page_id, area_id, state_id, context_id)], render_profiles=render_profiles, schema_version=schema_version)
            if hasattr(sys.stdout, 'buffer'):
                sys.stdout.buffer.write(html)
            else:
                sys.stdout.write(html.decode('utf-8'))
            return 0
        payload = _prepare_prototype_selection(req_dir, targets if targets is not None
                                               else [(page_id, area_id, state_id, context_id)], schema_version)
        if as_json:
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(f"✓ 原型已准备（尚未确认）：{len(payload['per_item'])} 项")
            print(f"准备 SHA-256: {payload['prepare_sha256']}")
        return 0
    except (OSError, UnicodeError, ValueError, TypeError, KeyError) as exc:
        if preview_html:
            print('✗ 原型预览失败：材料无效、已变化、格式冲突或超限；请重新校验。', file=sys.stderr)
        elif as_json:
            print(json.dumps({'schema_version': schema_version, 'status': 'CONFLICT', 'error': str(exc)}, ensure_ascii=False))
        else:
            print(f'✗ 原型准备失败: {exc}')
        return 3


def _current_v2_confirmation(req_dir: Path, target: tuple, prepared: dict):
    item = prepared['per_item'][0]
    identity = {key: item[key] for key in ('state_id', 'context_id', 'scope_digest')}
    name = _prototype_confirmation_path(target[0], target[1], item['prototype_sha256'],
                                        item['dependency_sha256'], **identity)
    root = _open_dir_nofollow(req_dir)
    try:
        try:
            raw = _read_beneath(root, 'reviews/ui-prototype-confirmations/' + name, 64 * 1024)
        except FileNotFoundError:
            return None
        receipt = json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_json_object)
        text = _read_beneath(root, 'UI设计.md', 10 * 1024 * 1024).decode('utf-8')
    finally:
        _ui_fs.close_dir(root)
    checks, current = Checks('UI设计'), {}
    _check_ui_prototypes(checks, req_dir, text, selected_targets={target}, preparation_out=current)
    if checks.fails or current.get(target) != item:
        raise ValueError('existing confirmation is invalid or no longer current; it will not be overwritten')
    return {'receipt_ref': 'reviews/ui-prototype-confirmations/' + name, 'reviewer': receipt['reviewer']}


def cmd_prototype_confirm_v2(req_dir: Path, target: tuple, reviewer: str, expected_prepare: str) -> int:
    """One real terminal decision for one explicit, current v2 selection."""
    try:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError('v2 confirmation requires an interactive input and display terminal')
        target = _prototype_target(dict(zip(('page_id', 'area_id', 'state_id', 'context_id'), target)), 2)
        if (type(reviewer) is not str or not reviewer.strip() or len(reviewer) > 120
                or any(ord(ch) < 32 or ord(ch) == 127 for ch in reviewer)):
            raise ValueError('reviewer must be a non-empty safe name of at most 120 characters')
        if type(expected_prepare) is not str or not _PROTOTYPE_DIGEST.fullmatch(expected_prepare):
            raise ValueError('v2 confirmation requires a prepared SHA-256')
        prepared = _prepare_prototype_v2(req_dir, target)
        if prepared['prepare_sha256'] != expected_prepare:
            raise ValueError('prepared prototype or dependencies are stale')
        item = prepared['per_item'][0]
        prior = _current_v2_confirmation(req_dir, target, prepared)
        if prior is not None:
            print(json.dumps({'schema_version': 2, 'per_item': [{**item, **prior, 'status': 'ACCEPTED'}],
                              'projection_status': 'CURRENT'}, ensure_ascii=False))
            return 0
        identity = {key: item[key] for key in ('state_id', 'context_id', 'scope_digest')}
        digest = _prototype_confirmation_digest(target[0], target[1], item['prototype_sha256'],
                                                item['dependency_sha256'], **identity)
        print('请先查看实际HTML预览及本次所需截图；准备记录不是批准。')
        print(json.dumps(item, ensure_ascii=False, indent=2))
        print(f"HTML: {req_dir / item['prototype_path']}")
        phrase = input(f'若已预览并接受，请输入 ACCEPT {digest[:12]} 或 REVISE/BLOCK/CANCEL：').strip()
        if phrase in ('REVISE', 'BLOCK', 'CANCEL'):
            status = {'REVISE': 'NEEDS_REVISION', 'BLOCK': 'BLOCKED', 'CANCEL': 'CANCELLED'}[phrase]
            print(json.dumps({'schema_version': 2, 'per_item': [{**item, 'status': status}],
                              'projection_status': 'UNCHANGED'}, ensure_ascii=False))
            return 0
        if phrase != f'ACCEPT {digest[:12]}':
            raise ValueError('confirmation phrase does not match the displayed selection')
        # The human pause is an external mutation window. Recompute from the
        # current actual files, not from candidate-reported hashes or status.
        current = _prepare_prototype_v2(req_dir, target)
        if current != prepared:
            raise ValueError('prototype or dependencies changed while awaiting confirmation')
        reviewed_at = datetime.now(timezone.utc).isoformat()
        try:
            _write_prototype_confirmation(req_dir, target[0], target[1], item['prototype_sha256'],
                item['dependency_sha256'], reviewer, reviewed_at, phrase, **identity)
        except FileExistsError:
            pass  # A competing complete receipt is checked, never replaced.
        recorded = _current_v2_confirmation(req_dir, target, prepared)
        if recorded is None:
            raise ValueError('confirmation was not published')
        print(json.dumps({'schema_version': 2, 'per_item': [{**item, **recorded, 'status': 'ACCEPTED'}],
                          'projection_status': 'CURRENT'}, ensure_ascii=False))
        return 0
    except (OSError, UnicodeError, ValueError, TypeError, KeyError, EOFError) as exc:
        print(json.dumps({'schema_version': 2, 'per_item': [{'status': 'CONFLICT', 'error': str(exc)}],
                          'projection_status': 'PENDING'}, ensure_ascii=False))
        return 3


def cmd_prototype_confirm_batch(req_dir: Path, targets, reviewer: str, expected_prepare: str) -> int:
    """One explicit terminal decision; immutable per-item facts permit partial recovery."""
    try:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError('v2 confirmation requires an interactive input and display terminal')
        targets = _prototype_selection_targets(targets)
        if (type(reviewer) is not str or not reviewer.strip() or len(reviewer) > 120
                or any(ord(ch) < 32 or ord(ch) == 127 for ch in reviewer)):
            raise ValueError('reviewer must be a non-empty safe name of at most 120 characters')
        if type(expected_prepare) is not str or not _PROTOTYPE_DIGEST.fullmatch(expected_prepare):
            raise ValueError('v2 confirmation requires a prepared SHA-256')
        prepared = _prepare_prototype_selection(req_dir, targets)
        if prepared['prepare_sha256'] != expected_prepare:
            raise ValueError('prepared selection or dependencies are stale')
        items = {_prototype_target(item, 2): item for item in prepared['per_item']}
        results, pending = {}, []
        for target, item in items.items():
            try:
                prior = _current_v2_confirmation(req_dir, target, {'per_item': [item]})
                if prior is None:
                    pending.append(item)
                else:
                    results[target] = {**item, **prior, 'status': 'ACCEPTED'}
            except (OSError, UnicodeError, ValueError, TypeError, KeyError) as exc:
                results[target] = {**item, 'status': 'CONFLICT', 'error': str(exc)}
        if pending:
            selection = _prototype_prepared_payload(pending)
            print('请查看以下每项实际HTML和截图；已完成项不重复批准。准备记录不是批准。')
            print(json.dumps(selection, ensure_ascii=False, indent=2))
            for item in pending:
                print(f"HTML: {req_dir / item['prototype_path']}")
            phrase = input(f"若已预览并接受全部所列项，请输入 ACCEPT {selection['prepare_sha256'][:12]} 或 REVISE/BLOCK/CANCEL：").strip()
            decisions = {'REVISE': 'NEEDS_REVISION', 'BLOCK': 'BLOCKED', 'CANCEL': 'CANCELLED'}
            if phrase not in decisions and phrase != f"ACCEPT {selection['prepare_sha256'][:12]}":
                raise ValueError('confirmation phrase does not match the displayed selection')
            reviewed_at = datetime.now(timezone.utc).isoformat()
            for item in pending:
                target = _prototype_target(item, 2)
                if phrase in decisions:
                    results[target] = {**item, 'status': decisions[phrase]}
                    continue
                try:
                    if _prepare_prototype_v2(req_dir, target)['per_item'][0] != item:
                        raise ValueError('selected prototype or dependencies changed during confirmation')
                    identity = {key: item[key] for key in ('state_id', 'context_id', 'scope_digest')}
                    try:
                        _write_prototype_confirmation(req_dir, target[0], target[1], item['prototype_sha256'],
                            item['dependency_sha256'], reviewer, reviewed_at, phrase,
                            selection=selection, **identity)
                    except FileExistsError:
                        pass  # Competing receipts are revalidated; never replaced.
                    recorded = _current_v2_confirmation(req_dir, target, {'per_item': [item]})
                    if recorded is None:
                        raise ValueError('confirmation was not published')
                    results[target] = {**item, **recorded, 'status': 'ACCEPTED'}
                except (OSError, UnicodeError, ValueError, TypeError, KeyError) as exc:
                    results[target] = {**item, 'status': 'CONFLICT', 'error': str(exc)}
        # Finish ALL receipt IO before a group material fence. A later member's
        # receipt read must not leave an earlier cached ACCEPTED result current.
        accepted = [target for target, row in results.items() if row['status'] == 'ACCEPTED']
        if accepted:
            current = _prototype_preparation_maps(req_dir, accepted, require_confirmation=True, strict=False)
            for target in accepted:
                if current.get(target) != items[target]:
                    results[target] = {**items[target], 'status': 'CONFLICT',
                                       'error': 'confirmation is no longer current after batch IO'}
        rows = [results[target] for target in targets]
        conflict = any(row['status'] == 'CONFLICT' for row in rows)
        all_current = all(row['status'] == 'ACCEPTED' for row in rows)
        print(json.dumps({'schema_version': 2, 'per_item': rows,
            'projection_status': 'CURRENT' if all_current else ('PENDING' if conflict else 'UNCHANGED')}, ensure_ascii=False))
        return 3 if conflict else 0
    except (OSError, UnicodeError, ValueError, TypeError, KeyError, EOFError) as exc:
        print(json.dumps({'schema_version': 2, 'per_item': [{'status': 'CONFLICT', 'error': str(exc)}],
                          'projection_status': 'PENDING'}, ensure_ascii=False))
        return 3


def cmd_prototype_confirm(req_dir: Path, page_id: str, area_id: str,
                          reviewer: str) -> int:
    """Require an interactive maintainer action for this exact prototype digest."""
    try:
        if not sys.stdin.isatty():
            raise ValueError("原型确认必须在交互式终端中进行")
        if not reviewer.strip() or len(reviewer) > 120:
            raise ValueError("reviewer must be a non-empty name of at most 120 characters")
        ui_doc = STAGES["UI设计"]["docs"][0]
        root_fd = _open_dir_nofollow(req_dir)
        try:
            ui_text = _read_beneath(root_fd, ui_doc, 10 * 1024 * 1024).decode("utf-8")
            manifest = _prototype_manifest(ui_text)
            if manifest['schema_version'] != 1:
                raise ValueError('v2 prototypes require explicit --schema-version 2 and a prepared state/context')
            matches = [item for item in manifest["prototypes"]
                       if isinstance(item, dict) and item.get("page_id") == page_id
                       and item.get("area_id") == area_id]
            if len(matches) != 1:
                raise ValueError("PAGE/AREA must identify exactly one prototype record")
            item = matches[0]
            if (item.get("status") != "ACCEPTED"
                    or item.get("confirmation_source") != "maintainer_reply"
                    or item.get("reviewer") != reviewer):
                raise ValueError("record must contain the maintainer's explicit ACCEPTED decision and reviewer")
            digest = item.get("prototype_sha256")
            if not isinstance(digest, str) or not _PROTOTYPE_DIGEST.fullmatch(digest):
                raise ValueError("prototype SHA-256 is invalid")
            path = item.get("prototype_path")
            if not isinstance(path, str):
                raise ValueError("prototype path is invalid")
            raw = _read_beneath(root_fd, path, _PROTOTYPE_MAX_BYTES)
            actual = hashlib.sha256(raw).hexdigest()
            if actual != digest:
                raise ValueError("prototype changed after the recorded preview")
            source = raw.decode("utf-8", errors="strict")
            parser = _SelfContainedHtml()
            parser.feed(source)
            parser.close()
            if parser.errors:
                raise ValueError(parser.errors[0])
            dependency_hashes: dict = {}
            validation = Checks("UI设计")
            _check_ui_prototypes(validation, req_dir, ui_text,
                                 require_confirmation=False,
                                 dependency_out=dependency_hashes)
            if validation.fails:
                raise ValueError("当前原型或证据依赖未通过复验：" + "；".join(
                    item["detail"] or item["name"] for item in validation.fails[:3]))
            dependency_digest = dependency_hashes.get((page_id, area_id))
            if not isinstance(dependency_digest, str):
                raise ValueError("无法计算当前页面/区域依赖摘要")
            identity_digest = _prototype_confirmation_digest(
                page_id, area_id, digest, dependency_digest)
            try:
                reviewed_at = datetime.fromisoformat(item["reviewed_at"].replace("Z", "+00:00"))
            except (KeyError, TypeError, ValueError, AttributeError) as exc:
                raise ValueError("reviewed_at must be timezone-aware ISO-8601") from exc
            if reviewed_at.tzinfo is None:
                raise ValueError("reviewed_at must include a timezone")
            print(f"请先在预览器中检查原型：{req_dir / path}")
            print(f"PAGE/AREA: {page_id}/{area_id}")
            print(f"原型 SHA-256: {digest}")
            print(f"当前依赖 SHA-256: {dependency_digest}")
            print("确认绑定原型与当前截图、权限、页面、F/A 及设计体系依赖；任一变化后须重新预览确认。")
            phrase = input(f"若已查看实际预览并接受，请输入 ACCEPT {identity_digest[:12]}：").strip()
            receipt = _write_prototype_confirmation(
                req_dir, page_id, area_id, digest, dependency_digest, reviewer,
                item["reviewed_at"], phrase)
            print(f"✓ 已写入本地交互确认凭证: {receipt}")
            return 0
        finally:
            _ui_fs.close_dir(root_fd)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError, TypeError) as exc:
        print(f"✗ 原型确认失败: {exc}")
        return 3


def cmd_prototype_confirm_v3(req_dir, targets, reviewer, expected_prepare, source_refs):
    try:
        targets = _prototype_selection_targets(targets)
        refs = {}
        for value in source_refs:
            target, sep, source = value.partition('=')
            key = tuple(target.split('/'))
            if not sep or key in refs or not re.fullmatch(r'interaction-[0-9a-f]{64}', source):
                raise ValueError('each interaction reference must identify exactly one selected target')
            refs[key] = source
        if set(refs) != set(targets):
            raise ValueError('interaction references must match the explicit target selection')
        repo_root, _package = _package_locations(req_dir)
        if _INTERACTION_PROFILES.get() is None:
            raise ValueError('INTERACTION_UNAVAILABLE: trusted interaction host required')

        def capture():
            prepared = _prepare_prototype_selection(req_dir, targets, 3)
            if prepared['prepare_sha256'] != expected_prepare:
                raise ValueError('prepared prototype selection is no longer current')
            members = {}
            for item in prepared['per_item']:
                target = _prototype_target(item, 3)
                members[target] = _interaction_confirmation_member(repo_root, target, item, refs[target])
            return members

        members = capture()
        authorities = {id(profile._authority): profile._authority for profile, _member in members.values()}
        if len(authorities) != 1:
            raise ValueError('interactive confirmation requires a single trusted host scope')
        authority = next(iter(authorities.values()))
        results, pending = {}, {}
        for target, (profile, member) in members.items():
            prior = _read_interactive_confirmation(req_dir, profile, member)
            if prior is None:
                pending[target] = member
            else:
                results[target] = {**member, **prior, 'status': 'ACCEPTED'}
        if pending:
            selection = {'schema_version': 3, 'prepare_sha256': expected_prepare,
                         'members': list(pending.values())}
            def current():
                try:
                    return capture() == members
                except (OSError, ValueError, TypeError, KeyError):
                    return False
            decision, event_id = authority.host_source.confirm_prototypes(
                authority, selection=selection, reviewer=reviewer, revalidate=current)
            if decision == 'ACCEPT':
                with PlanStore(req_dir / 'reviews').locked_view(req_dir):
                    if not current():
                        raise ValueError('prototype changed before confirmation publication')
                    receipt = {'schema_version': 3, 'decision': 'ACCEPTED', 'selection': selection,
                               'event_id': event_id, 'reviewer': reviewer}
                    for target, member in pending.items():
                        try:
                            _publish_prototype_receipt(req_dir, _interactive_receipt_name(member), receipt)
                        except FileExistsError:
                            pass
                        prior = _read_interactive_confirmation(req_dir, members[target][0], member)
                        if prior is None:
                            raise ValueError('confirmation publication could not be verified')
                        results[target] = {**member, **prior, 'status': 'ACCEPTED'}
            else:
                status = {'REVISE': 'NEEDS_REVISION', 'BLOCK': 'BLOCKED', 'CANCEL': 'CANCELLED'}[decision]
                for target, member in pending.items():
                    results[target] = {**member, 'status': status}
        print(json.dumps({'schema_version': 3, 'per_item': [results[target] for target in targets]},
                         ensure_ascii=False))
        return 0
    except (OSError, ValueError, TypeError, KeyError, EOFError) as exc:
        print(json.dumps({'schema_version': 3, 'per_item': [{'status': 'CONFLICT', 'error': str(exc)}]},
                         ensure_ascii=False))
        return 3


def main(argv=None, *, interaction_profiles=None) -> int:
    """Only the trusted Python composition root supplies host profile objects."""
    token = _INTERACTION_PROFILES.set(dict(interaction_profiles) if interaction_profiles is not None else None)
    try:
        return _main(argv)
    finally:
        _INTERACTION_PROFILES.reset(token)


def _main(argv) -> int:
    ap = argparse.ArgumentParser(prog="doc-gate", description="需求文档流水线确定性门禁")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("check", "review-input", "gate"):
        p = sub.add_parser(name)
        p.add_argument("dir", help="需求目录（docs/01-需求/NNN-名称/）")
        p.add_argument("--stage", required=True, help=f"阶段: {'、'.join(STAGES)}")
        p.add_argument("--json", action="store_true")
        if name == "check":
            p.add_argument("--summary", action="store_true",
                           help="简洁 JSON 预检结果，保留完整报告及摘要绑定")
        if name in ("review-input", "gate"):
            p.add_argument("--schema-version", type=int, choices=(1, 2), default=1,
                           help="评审输入契约版本（默认 1，版本 2 显式启用）")
        if name == "gate":
            p.add_argument("--no-review", action="store_true",
                           help="跳过 AI 评审（仅硬校验判定——限 review=optional 阶段）")
            p.add_argument("--refresh-equivalent", action="store_true", help="核验并刷新确定等价材料，保留原批准")
            p.add_argument("--expected-revision", help="当前材料修订；首次精确基线显式给 none")
            p.add_argument("--source-hash", action="append", default=[], help="当前文档名=原字节SHA256，可重复")
    ip = sub.add_parser("init", help="需求登记脚手架（两处目录+模板+索引行，幂等）")
    ip.add_argument("name", help="需求名 NNN-名称（如 014-识别驱动脱敏）")
    ip.add_argument("--repo", default=".", help="目标仓库根目录（默认当前目录）")
    ip.add_argument("--json", action="store_true")
    ip.add_argument('--version', help='new package version; without a project mapping uses docs/需求/<version>/<name>')
    ip.add_argument('--layout', choices=('auto', 'legacy', 'co-located', 'project'), default='auto')
    fp = sub.add_parser("freeze", help="人工签核阶段冻结凭证（需求分析/业务流程设计）")
    fp.add_argument("dir")
    fp.add_argument("--stage", default="需求分析",
                    help="需求分析 / 业务流程设计")
    fp.add_argument("--by", default="", help="签核人（进 approved_by）")
    fp.add_argument("--approved-input-sha256", help="外部人工阶段经签核的本轮来源摘要")
    fp.add_argument("--json", action="store_true")
    fp.add_argument("--schema-version", type=int, choices=(1, 2), default=1,
                    help="版本2显式建立材料绑定；已有版本2包保持新版")
    cp = sub.add_parser("closeout", help="执行完成后校验并冻结计划终态")
    cp.add_argument("dir")
    cp.add_argument("--json", action="store_true")
    sp = sub.add_parser("status")
    sp.add_argument("dir")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--schema-version", type=int, choices=(1, 2), default=1,
                    help="版本2只读解释材料变化，不刷新批准")
    pp = sub.add_parser("plan-prepare", help="准备动态 ArtifactPlan")
    pp.add_argument("dir")
    pp.add_argument("--base", required=True, help="精确 Git 基线 commit/ref")
    pp.add_argument("--route", required=True,
                    choices=("direct", "bounded", "standard", "initiative"))
    pp.add_argument("--require", action="append", default=[], dest="overlays",
                    help="治理强制 required 的 artifact ID（可重复）")
    pp.add_argument("--json", action="store_true")
    pp.add_argument("--source-map", action="store_true", help="从标准输入读取显式来源映射 UTF-8 JSON")
    for name in ("plan-freeze", "plan-status"):
        plan_parser = sub.add_parser(name)
        plan_parser.add_argument("dir")
        plan_parser.add_argument("--base", required=True)
        plan_parser.add_argument("--json", action="store_true")
    pb = sub.add_parser("plan-bind")
    pb.add_argument("dir")
    pb.add_argument("--base", required=True)
    pb.add_argument("--stage", required=True, choices=tuple(STAGES))
    pb.add_argument("--json", action="store_true")
    pr = sub.add_parser("plan-rollback")
    pr.add_argument("dir")
    pr.add_argument("--json", action="store_true")
    upp = sub.add_parser('prototype-prepare', help='只读准备指定状态/权限上下文的 v2 原型')
    upp.add_argument('dir')
    upp.add_argument('--page')
    upp.add_argument('--area')
    upp.add_argument('--state')
    upp.add_argument('--context')
    upp.add_argument('--target', action='append', help='显式 PAGE/AREA/STATE/context，可重复，最多32项')
    upp.add_argument('--json', action='store_true')
    upp.add_argument('--schema-version', type=int, choices=(2, 3), default=2)
    upp.add_argument('--preview-html', action='store_true', help='只读输出完整静态HTML对照，不写文件或确认')
    ucp = sub.add_parser("prototype-confirm", help="交互式确认已预览的 UI 原型摘要")
    ucp.add_argument("dir", help="需求目录（docs/03-SDD/NNN-名称/）")
    ucp.add_argument("--page", help="页面 ID，如 PAGE-1")
    ucp.add_argument("--area", help="区域 ID，如 AREA-1")
    ucp.add_argument('--target', action='append', help='显式 PAGE/AREA/STATE/context，可重复，最多32项')
    ucp.add_argument("--reviewer", required=True, help="实际查看预览并确认的维护者姓名")
    ucp.add_argument('--schema-version', type=int, choices=(1, 2, 3), default=1)
    ucp.add_argument('--state')
    ucp.add_argument('--context')
    ucp.add_argument('--prepared-sha256')
    ucp.add_argument('--interaction-ref', action='append', default=[])
    args = ap.parse_args(argv)

    if args.cmd == 'prototype-prepare':
        singles = (args.page, args.area, args.state, args.context)
        if args.target and any(part is not None for part in singles):
            ap.error('--target cannot be combined with single-target arguments')
        if not args.target and any(part is None for part in singles):
            ap.error('prototype-prepare requires --target or --page/--area/--state/--context')
    if args.cmd == 'prototype-confirm':
        if args.schema_version != 3 and args.interaction_ref:
            ap.error('--interaction-ref requires --schema-version 3')
        if args.target:
            if args.schema_version not in (2, 3) or any(value is not None for value in (
                    args.page, args.area, args.state, args.context)):
                ap.error('--target requires explicit --schema-version 2 or 3 and no single-target arguments')
        elif args.page is None or args.area is None:
            ap.error('prototype-confirm requires --target or --page/--area')

    if args.cmd == "init":
        return cmd_init(Path(args.repo).absolute(), args.name, args.json, version=args.version, layout=args.layout)

    # Keep reparse/symlink components visible to the UI filesystem boundary.
    req_dir = Path(os.path.abspath(args.dir))
    if not req_dir.is_dir():
        if args.cmd == 'prototype-prepare' and args.preview_html:
            print('✗ 原型预览失败：需求目录不存在或不可用。', file=sys.stderr)
        else:
            print(f"✗ 需求目录不存在: {req_dir}")
        return 3
    try:
        _validate_registered_package(req_dir)
    except (OSError, TypeError, ValueError) as exc:
        print(f'✗ 需求包定位失败: {exc}')
        return 3
    if args.cmd == "check":
        return cmd_check(req_dir, args.stage, args.json, args.summary)
    if args.cmd == "review-input":
        return cmd_review_input(req_dir, args.stage, args.json, args.schema_version)
    if args.cmd == "gate":
        if args.refresh_equivalent:
            if args.no_review or args.expected_revision is None or not args.source_hash:
                ap.error("等价刷新须显式当前修订和全部来源摘要，不能与no-review混用")
            hashes = {}
            for value in args.source_hash:
                name, sep, digest = value.partition("=")
                if not sep or name in hashes or not re.fullmatch(r"[0-9a-f]{64}", digest):
                    ap.error("来源摘要必须是无重复的文档名=SHA256")
                hashes[name] = digest
            expected = None if args.expected_revision == "none" else args.expected_revision
            if expected is not None and not re.fullmatch(r"[0-9a-f]{64}", expected):
                ap.error("材料修订必须是SHA256或显式none")
            return cmd_material_refresh(req_dir, args.stage, expected, hashes, args.json)
        if args.expected_revision is not None or args.source_hash:
            ap.error("材料修订参数仅用于显式等价刷新")
        return cmd_gate(req_dir, args.stage, args.no_review, args.json, args.schema_version)
    if args.cmd == "freeze":
        return cmd_freeze(req_dir, args.stage,
                          getattr(args, "by", ""), getattr(args, "json", False), args.schema_version,
                          approved_input=args.approved_input_sha256)
    if args.cmd == "closeout":
        return cmd_closeout(req_dir, args.json)
    if args.cmd == "plan-prepare":
        return cmd_plan_prepare(req_dir, args.base, args.route,
                                tuple(args.overlays), args.json, source_map_stdin=args.source_map)
    if args.cmd == "plan-freeze":
        return cmd_plan_freeze(req_dir, args.base, args.json)
    if args.cmd == "plan-bind":
        return cmd_plan_bind(req_dir, args.base, args.stage, args.json)
    if args.cmd == "plan-status":
        return cmd_plan_status(req_dir, args.base, args.json)
    if args.cmd == "plan-rollback":
        return cmd_plan_rollback(req_dir, args.json)
    if args.cmd == "prototype-confirm":
        if args.schema_version == 3:
            targets = [part.split('/') for part in args.target] if args.target else [
                (args.page, args.area, args.state, args.context)]
            return cmd_prototype_confirm_v3(req_dir, targets, args.reviewer, args.prepared_sha256,
                                            args.interaction_ref)
        if args.target:
            return cmd_prototype_confirm_batch(req_dir, [part.split('/') for part in args.target],
                                                args.reviewer, args.prepared_sha256)
        if args.schema_version == 2:
            return cmd_prototype_confirm_v2(req_dir, (args.page, args.area, args.state, args.context),
                                             args.reviewer, args.prepared_sha256)
        if any(value is not None for value in (args.state, args.context, args.prepared_sha256)):
            print('✗ v2 state/context/preparation arguments require --schema-version 2')
            return 3
        return cmd_prototype_confirm(req_dir, args.page, args.area, args.reviewer)
    if args.cmd == 'prototype-prepare':
        targets = [part.split('/') for part in args.target] if args.target else None
        profiles = _INTERACTION_PROFILES.get()
        if args.schema_version == 3 and args.preview_html and profiles is not None:
            selected = targets or [(args.page, args.area, args.state, args.context)]
            profiles = {tuple(target): profiles[tuple(target)] for target in selected if tuple(target) in profiles}
        else:
            profiles = None
        return cmd_prototype_prepare(req_dir, args.page, args.area, args.state, args.context, args.json,
                                     targets=targets, preview_html=args.preview_html,
                                     render_profiles=profiles, schema_version=args.schema_version)
    return cmd_status(req_dir, args.json, args.schema_version)


if __name__ == "__main__":
    sys.exit(main())
