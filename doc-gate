def cmd_check(req_dir: Path, stage: str, as_json: bool) -> int:
    if stage not in STAGES:
        print(f"✗ 未知阶段: {stage}（可选: {'、'.join(STAGES)}）")
        return 3
    checks = run_checks(req_dir, stage)
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")
    if as_json:
        print(json.dumps(checks.to_dict(), ensure_ascii=False, indent=2))
    else:
        print(f"硬校验 {stage}: {checks.to_dict()['summary']['pass']} 通过 / "
              f"{len(checks.fails)} 失败")
        for chk in checks.fails:
            print(f"  ✗ [{chk['group']}] {chk['name']}: {chk['detail']}")
    return 1 if checks.fails else 0


def cmd_status(req_dir: Path, as_json: bool) -> int:
    report = {}
    lines = [f"需求目录: {req_dir.name}"]
    for stage in STAGES:
        st, why = stage_frozen(req_dir, stage)
        report[stage] = {"state": st, "detail": why}
        lines.append(f"  {stage:<6s} {st:<10s} {why}")
    for extra in ("线上联调功能验证清单.md", "终稿.md"):
        p = req_dir / extra
        if p.is_file():
            ph = len(_placeholders(_read(p) or ""))
            report[extra] = {"exists": True, "placeholders": ph}
            lines.append(f"  {extra} 存在（占位符 {ph} 处）")
    if as_json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        print("\n".join(lines))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="doc-gate", description="需求文档流水线确定性门禁")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("check", "gate"):
        p = sub.add_parser(name)
        p.add_argument("dir", help="需求目录（docs/01-需求/NNN-名称/）")
        p.add_argument("--stage", required=True, help=f"阶段: {'、'.join(STAGES)}")
        p.add_argument("--json", action="store_true")
        if name == "gate":
            p.add_argument("--no-review", action="store_true",
                           help="跳过 AI 评审（仅硬校验判定——限 review=optional 阶段）")
    ip = sub.add_parser("init", help="需求登记脚手架（两处目录+模板+索引行，幂等）")
    ip.add_argument("name", help="需求名 NNN-名称（如 014-识别驱动脱敏）")
    ip.add_argument("--repo", default=".", help="目标仓库根目录（默认当前目录）")
    ip.add_argument("--json", action="store_true")
    fp = sub.add_parser("freeze", help="人工签核阶段冻结凭证（需求分析/业务流程设计）")
    fp.add_argument("dir")
    fp.add_argument("--stage", default="需求分析",
                    help="需求分析 / 业务流程设计")
    fp.add_argument("--by", default="", help="签核人（进 approved_by）")
    fp.add_argument("--json", action="store_true")
    sp = sub.add_parser("status")
    sp.add_argument("dir")
    sp.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.cmd == "init":
        return cmd_init(Path(args.repo).resolve(), args.name, args.json)

    req_dir = Path(args.dir).resolve()
    if not req_dir.is_dir():
        print(f"✗ 需求目录不存在: {req_dir}")
        return 3
    if args.cmd == "check":
        return cmd_check(req_dir, args.stage, args.json)
    if args.cmd == "gate":
        return cmd_gate(req_dir, args.stage, args.no_review, args.json)
    if args.cmd == "freeze":
        return cmd_freeze(req_dir, args.stage,
                          getattr(args, "by", ""), getattr(args, "json", False))
    return cmd_status(req_dir, args.json)


if __name__ == "__main__":
    sys.exit(main())
