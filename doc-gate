def parse_scenarios(text: str) -> dict[str, dict]:
    """场景 N → fields, including indented paragraphs/lists after the colon.

    Continuations belong only to the current field: a peer block, another
    field or the next scenario cannot fill an otherwise empty value.
    """
    out = {}
    for m in re.finditer(r"^###[ \t]*场景[ \t]*(\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        values = {key: [] for key in ("前置", "操作", "结果")}
        lines = [line.expandtabs(4) for line in block.splitlines()[1:]]
        fields = [re.fullmatch(r"( *)(?:[-+*][ \t]+)?\*\*(前置|操作|结果)\*\*：[ \t]*(.*)", line)
                  for line in lines]
        indent = min((len(field.group(1)) for field in fields if field), default=0)
        current, seen = None, set()
        for line, field in zip(lines, fields):
            if field is not None and len(field.group(1)) == indent:
                current = field.group(2)
                if current in seen:
                    # Duplicate outer fields are ambiguous, not a means to
                    # fill a required value that was explicitly left empty.
                    values[current] = []
                    current = None
                    continue
                seen.add(current)
                values[current].append(field.group(3).strip())
            elif current is not None and line.strip():
                leading = len(line) - len(line.lstrip(' '))
                if leading <= indent or line.lstrip().startswith('#'):
                    current = None
                elif re.fullmatch(r"(?:[-+*]|\d+[.)])\s*(?:\[[ xX]\])?\s*", line.strip()) is None:
                    values[current].append(line.strip())
        item = {key: '\n'.join(value for value in rows if value) for key, rows in values.items()}
        out[m.group(1)] = item
    return out


def parse_a_items(text: str) -> dict[str, dict]:
    """A-ID → {scenarios: [n], text}（验收项）。"""
    out = {}
    for m in re.finditer(r"^- \[[ x]\]\s*(A\d+)：(.*)$", text, re.M):
        rest = m.group(2).strip()
        out[m.group(1)] = {"scenarios": re.findall(r"场景\s*(\d+)", rest), "text": rest}
    return out


def parse_f_items(text: str) -> dict[str, dict]:
    """F-ID → {covers: [A-ID]}（概要设计功能点）。"""
    out = {}
    for m in re.finditer(r"^###\s*(F\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        cov = re.search(r"覆盖验收项：\s*(.+)", block)
        out[m.group(1)] = {"covers": re.findall(r"A\d+", cov.group(1)) if cov else []}
    return out


def parse_d_items(text: str) -> dict[str, dict]:
    """D-ID → {f: [F-ID], a: [A-ID]}（详细设计落点）。"""
    out = {}
    for m in re.finditer(r"^###\s*(D\d+)：(.*)$", text, re.M):
        refm = re.search(r"（对应\s*([^）]+)）", m.group(2))
        refs = refm.group(1) if refm else ""
        out[m.group(1)] = {"f": re.findall(r"F\d+", refs), "a": re.findall(r"A\d+", refs)}
    return out


def parse_tc_items(text: str) -> dict[str, dict]:
    """TC-ID → {accepts: [A-ID]}（测试方案用例清单行）。"""
    out = {}
    for m in re.finditer(r"^\|\s*(TC-\d+)\s*\|(.+)$", text, re.M):
        cells = [c.strip() for c in m.group(2).split("|")]
        accepts = re.findall(r"A\d+", cells[1]) if len(cells) > 1 else []
        out[m.group(1)] = {"accepts": accepts}
    return out


def parse_t_items(text: str) -> dict[str, dict]:
    """T-ID → {designs: [D/TC-ID], has_scope, has_verify}（任务清单）。"""
    out = {}
    for m in re.finditer(r"^###\s*(T\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        des = re.search(r"对应设计：\s*(.+)", block)
        scope = re.search(r"预计修改范围：\s*(.+)", block)
        verify = re.search(r"验证方式：\s*(.+)", block)
        out[m.group(1)] = {
            "designs": re.findall(r"(?:D\d+|TC-\d+)", des.group(1)) if des else [],
            "has_scope": bool(scope and _placeholders(scope.group(1)) == []
                            and scope.group(1).strip() not in ("", "无")),
            "has_verify": bool(verify and _placeholders(verify.group(1)) == []
                               and verify.group(1).strip() != ""),
        }
    return out


def parse_page_items(text: str) -> dict[str, dict]:
    """PAGE-ID → {refs, states_ok}（UI设计页面清单）。"""
    out = {}
    for m in re.finditer(r"^###\s*(PAGE-\d+)：(.*)$", text, re.M):
        refm = re.search(r"（对应\s*([^）]+)）", m.group(2))
        refs = refm.group(1) if refm else ""
        block = _block(text, m.start())
        has_na = "不适用" in block
        states_ok = has_na or all(s in block for s in UI_STATES)
        out[m.group(1)] = {"refs": re.findall(r"(?:F\d+|A\d+)", refs), "states_ok": states_ok}
    return out


def req_freeze_state(text: str) -> str:
    m = re.search(r"冻结状态[:：]\s*(已冻结|未冻结)", text or "")
    return m.group(1) if m else "未记录"


# ══════════════════════════ 冻结状态 ══════════════════════════

def _stage_fingerprint(req_dir: Path, stage: str, dynamic_state=None) -> str | None:
    """上游阶段的指纹 = digest(status + doc_hashes + 其上游指纹)——
    任何上游重冻结（内容或其上游变化）都会改变指纹，驱动下游递归失效
    （第八轮审计 P1：此前只校验本阶段哈希，上游 v2 重冻结后旧下游仍 FROZEN）。"""
    if dynamic_state is not None:
        if (dynamic_state.state != "FROZEN" or dynamic_state.plan is None
                or not participating_documents(dynamic_state.plan, stage)):
            return None
        fingerprint = _dynamic_stage_fingerprint(req_dir, dynamic_state, stage)
        return None if fingerprint == "0" * 64 else fingerprint

    # A gate record is not a current credential by itself. Validate the stage
    # first so an edited-but-not-refrozen upstream invalidates descendants too.
    state, _detail = stage_frozen(req_dir, stage)
    if state != "FROZEN":
        return None
    gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
    if gate is None:
        return None
    try:
        g = json.loads(gate)
    except json.JSONDecodeError:
        return None
    ident = {"status": g.get("status"),
             "doc_hashes": g.get("doc_hashes"),
             "execution_baseline_hashes": g.get("execution_baseline_hashes"),
             "upstream_fingerprints": g.get("upstream_fingerprints")}
    if stage == "计划":
        closeout_text = _read(req_dir / "reviews" / "计划.closeout.json")
        if closeout_text is not None:
            try:
                closeout = json.loads(closeout_text)
            except json.JSONDecodeError:
                closeout = {}
            ident["closeout_doc_hashes"] = closeout.get("doc_hashes")
    return hashlib.sha256(
        json.dumps(ident, ensure_ascii=False, sort_keys=True).encode()).hexdigest()


def _dynamic_sidecar_present(req_dir: Path) -> bool:
    """A partial dynamic publication must never be guessed as legacy-static.

    T5 activation will replace this transitional guard with validated plan,
    credential and binding state evaluation. Until then all dynamic sidecars
    fail closed, including a damaged journal or publish temporary file.
    """
    reviews = req_dir / "reviews"
    if reviews.is_symlink():
        return True
    if not reviews.is_dir():
        return False
    for item in reviews.iterdir():
        if (item.name in {"artifact-plan.json", "artifact-plan.gate.json", "artifact-plan.tx.json"}
                or item.name.startswith(".artifact-plan-write-")):
            return True
        if item.name.endswith(".plan-binding.json"):
            try:
                binding = load_binding_bytes(_read_review_bytes(item))
                if (not isinstance(binding, MaterialStageBinding) or binding.binding_kind != "material-only"
                        or item.name != binding.stage + ".plan-binding.json"):
                    return True
            except (OSError, TypeError, ValueError):
                return True
    return False


def _document_materials(req_dir, view, dynamic_state=None, *, policy_operation=None):
    operation_package = _registered_package_identity(req_dir)
    def context(stage):
        credential = (dynamic_state.credential.credential_digest
                      if dynamic_state is not None and dynamic_state.credential is not None else None)
        if dynamic_state is not None:
            snapshot = view.snapshot(for_material_recovery=True)
            if (load_plan_bytes(snapshot.get("artifact-plan.json")) != dynamic_state.plan
                    or load_credential_bytes(snapshot.get("artifact-plan.gate.json")) != dynamic_state.credential):
                raise ValueError("SOURCE_CHANGED: frozen plan context changed")
        identity = {"policy": _load_policy(_repo_root(req_dir)),
                    "stage_spec": _effective_stage_spec(stage, dynamic_state), "plan_credential": credential}
        if _registered_package_identity(req_dir) != operation_package:
            raise ValueError('SOURCE_CHANGED: package locator changed during material operation')
        if operation_package is not None:
            identity["package_identity"] = operation_package
        if dynamic_state is not None and isinstance(dynamic_state.plan, ComposedArtifactPlan):
            epoch = _verify_composition(req_dir, load_source_map(dynamic_state.plan.source_map))
            identity['composition'] = {'mapping_digest': epoch.mapping_digest,
                                       'repository_identity': epoch.repository_identity,
                                       'package_revision': epoch.package_revision}
        if stage == "计划":
            identity["projection"] = (policy_operation or
                ("plan-execution-v1" if view.read_closeout() is None else "raw-closeout-v1"))
        return {"package_ref": req_dir.absolute().as_posix(),
                "policy_digest": hashlib.sha256(json.dumps(identity, ensure_ascii=False, sort_keys=True,
                    separators=(",", ":")).encode("utf-8")).hexdigest()}
    def project(stage, name, raw):
        if stage == "计划" and view.read_closeout() is None:
            return _plan_baseline_text(name, raw.decode("utf-8", errors="strict")).encode("utf-8")
        return raw
    def dependency_materials(stage):
        visited, materials = set(), {}
        def visit(current):
            for parent in _effective_stage_spec(current, dynamic_state)["upstream"]:
                if parent in visited:
                    continue
                visited.add(parent)
                for name in _stage_documents(parent, dynamic_state):
                    materials[name] = view.read_source(name)
                visit(parent)
        visit(stage)
        return materials
    def dependencies(stage):
        return {name: hashlib.sha256(raw).hexdigest() for name, raw in dependency_materials(stage).items()}
    archive = MaterialArchive(req_dir / "reviews")
    def consumption(stage, sources, previous, dependency_sources):
        if any('/' in name for name in (*sources, *dependency_sources)):
            if previous is not None:
                raise ValueError('SOURCE_CHANGED: mapped sources require full dependency proof')
            return None
        parser = ReviewMaterialParser()
        consumer = parser.parse(stage, {name: raw.decode("utf-8", errors="strict") for name, raw in sources.items()}, "0" * 64)
        parents = set()
        def visit(target):
            for parent in _effective_stage_spec(target, dynamic_state)["upstream"]:
                if parent not in parents:
                    parents.add(parent)
                    visit(parent)
        visit(stage)
        if not parents:
            return None
        if previous is not None and set(previous["approved_sources"]) != parents:
            raise ValueError("SOURCE_CHANGED: dependency source set changed")
        current, original, approved = {}, {}, {}
        for parent in sorted(parents):
            gate_raw = view.read_gate(parent)
            gate = json.loads(gate_raw.decode("utf-8")) if gate_raw is not None else None
            if type(gate) is not dict or gate.get("status") != "PASS" or gate.get("stage") != parent:
                if previous is not None:
                    raise ValueError("SOURCE_CHANGED: dependency original Gate unavailable")
                return None
            names = _stage_documents(parent, dynamic_state)
            if type(gate.get("doc_hashes")) is not dict or set(gate["doc_hashes"]) != set(names):
                raise ValueError("SOURCE_CHANGED: dependency documents changed")
            current[parent] = parser.parse(parent,
                {name: dependency_sources[name].decode("utf-8", errors="strict") for name in names}, "0" * 64)
            source = previous["approved_sources"][parent] if previous is not None else {
                "gate_ref": hashlib.sha256(gate_raw).hexdigest(), "doc_hashes": gate["doc_hashes"]}
            try:
                origin_gate_raw = archive.get(source["gate_ref"]) if previous is not None else gate_raw
                origin_gate = json.loads(origin_gate_raw.decode("utf-8"))
                if (origin_gate.get("stage") != parent or origin_gate.get("status") != "PASS"
                        or origin_gate.get("doc_hashes") != source["doc_hashes"] or set(source["doc_hashes"]) != set(names)):
                    raise ValueError("BASELINE_MISSING: dependency approval source invalid")
                original[parent] = parser.parse(parent, {name: archive.get(digest).decode("utf-8", errors="strict")
                    for name, digest in source["doc_hashes"].items()}, "0" * 64)
            except (OSError, ValueError):
                if previous is None:
                    return None
                raise
            approved[parent] = source
        before, after = consumption_identity(consumer, original), consumption_identity(consumer, current)
        if (before["status"] != "SCOPED" or after["status"] != "SCOPED"
                or before["content_digest"] != after["content_digest"]):
            if previous is not None:
                raise ValueError("SOURCE_CHANGED: consumed dependency content or boundary changed")
            return None
        result = {"schema_version": 2, "rule_version": "declared-consumption-v1",
                  "content_digest": before["content_digest"], "approved_sources": approved}
        if previous is not None:
            if result != previous:
                raise ValueError("SOURCE_CHANGED: dependency proof changed")
        else:
            # Called only by the original authorized baseline writer, never a
            # status reader. The exact original Gate is retained as evidence.
            for parent, source in approved.items():
                raw = view.read_gate(parent)
                archive.put(raw, expected_sha256=source["gate_ref"])
        return result
    service = DocumentMaterials(view, archive, context, project_source=project,
                             dependency_loader=dependencies, consumption_loader=consumption,
                             dependency_material_loader=dependency_materials,
                             gate_validator=lambda gate: _require_gate_package(req_dir, gate, operation_package))
    return service


def _current_material_binding(req_dir, stage, dynamic_state=None, *, allow_changed=False):
    with PlanStore(req_dir / "reviews").read_view(req_dir) as view:
        raw = view.snapshot().get(stage + ".plan-binding.json")
        binding = load_binding_bytes(raw) if raw is not None else None
        if not isinstance(binding, MaterialStageBinding):
            return None
        service = _document_materials(req_dir, view, dynamic_state)
        previous = ({name: service.archive.get(digest)
                     for name, digest in binding.material_revision["raw_after"].items()}
                    if allow_changed else None)
        return service.verify(stage, current=previous)


def _material_hash_current(req_dir, stage, dynamic_state=None):
    try:
        return _current_material_binding(req_dir, stage, dynamic_state) is not None
    except (OSError, PlanInvalid, TypeError, ValueError):
        return False


def stage_frozen(req_dir: Path, stage: str, dynamic_state=None) -> tuple[str, str]:
    """返回 (状态, 说明)。状态: FROZEN / DRAFT / BLOCKED / NOT_GATED / MISSING / INVALID。

    FROZEN = gate.json PASS 且文档哈希一致 且 上游指纹与冻结时一致；
    上游重冻结/本阶段改动 → DRAFT（下游需重过门禁——递归失效）。
    """
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            return "INVALID", f"动态计划不可用：{dynamic_state.reason}"
        if not participating_documents(dynamic_state.plan, stage):
            if stage == 'UI设计':
                coverage_checks = Checks(stage)
                scope = _current_ui_coverage(coverage_checks, req_dir, dynamic_state, False)
                if scope is None or not scope.complete or scope.required:
                    return 'INVALID', 'UI classification does not prove a current NON_UI scope'
            return "SKIPPED", "ArtifactPlan 已证明本阶段无需产物"
        states = evaluate_stage_states(
            dynamic_state, _dynamic_snapshots(req_dir, dynamic_state))
        current = states.get(stage, "INVALID")
        if current == "BOUND":
            if stage == "UI设计":
                try:
                    ui_text, mapped_ui = _ui_stage_material(req_dir, dynamic_state)
                    ui_checks = Checks(stage)
                    _check_ui_prototypes(ui_checks, req_dir, ui_text,
                                         dynamic_state=dynamic_state, mapped_ui=mapped_ui)
                except (OSError, TypeError, ValueError, KeyError) as exc:
                    return "DRAFT", str(exc)
                if ui_checks.fails:
                    return "DRAFT", "原型/截图确认或依赖已失效：" + "；".join(
                        item["detail"] or item["name"] for item in ui_checks.fails[:3])
            elif 'UI设计' in _upstream_stages(stage, dynamic_state):
                ui_state, detail = stage_frozen(req_dir, 'UI设计', dynamic_state)
                if ui_state != 'FROZEN':
                    return 'DRAFT', '上游 UI 确认不可用：' + detail
            return "FROZEN", "ArtifactPlan binding 与当前门禁、文档及前置指纹一致"
        if current == "UNBOUND":
            return "NOT_GATED", "阶段尚未绑定到冻结 ArtifactPlan"
        if current == "STALE":
            return "DRAFT", "ArtifactPlan binding 已过期，需重新门禁"
        return "INVALID", "ArtifactPlan binding 无效"
    if _dynamic_sidecar_present(req_dir):
        return "INVALID", "动态计划存在但未能建立同锁快照"
    material_path = req_dir / "reviews" / f"{stage}.plan-binding.json"
    material_current = None
    consumed_current = False
    if material_path.exists() or material_path.is_symlink():
        try:
            checked_material = _current_material_binding(req_dir, stage)
            material_current = checked_material is not None
            consumed_current = material_current and checked_material.material_revision.get("dependency_identity") is not None
        except (OSError, PlanInvalid, TypeError, ValueError):
            material_current = False
        if not material_current:
            return "DRAFT", "材料修订与当前来源、政策或原批准不一致"
    if stage in HUMAN_SIGNOFF:
        # 人工签核阶段（需求分析/业务流程设计）：文本签核不是凭证——必须有
        # gate.json 绑定内容哈希，签核后改动会被哈希检出
        doc = STAGES[stage]["docs"][0]
        if not (req_dir / doc).is_file():
            return "MISSING", f"{doc} 不存在"
        gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
        if gate is None:
            sign_re, _want = HUMAN_SIGNOFF[stage]
            m = re.search(sign_re, _read(req_dir / doc) or "")
            signed = m.group(1) if m else "未记录"
            return "DRAFT", (f"未过 doc-gate freeze（签核状态：{signed}——"
                            f"文本不构成凭证）")
        try:
            g = json.loads(gate)
            _require_gate_package(req_dir, g)
        except (json.JSONDecodeError, OSError, TypeError, ValueError):
            return "DRAFT", f"{stage}.gate.json 损坏"
        if g.get("status") != "PASS":
            return "DRAFT", f"{stage}最近判定 {g.get('status')}"
        want = (g.get("doc_hashes") or {}).get(doc)
        cur = _sha256(req_dir / doc)
        if want != cur and material_current is not True:
            return "DRAFT", f"{doc} 签核后有改动（哈希失配）——需人工重审并重新 freeze"
        recorded = g.get("upstream_fingerprints") or {}
        for up in STAGES[stage]["upstream"]:
            if consumed_current:
                continue
            cur_fp = _stage_fingerprint(req_dir, up, dynamic_state)
            if cur_fp is None or recorded.get(up) != cur_fp:
                return "DRAFT", f"上游 {up} 已重新冻结（指纹失配）——需重新签核"
        return "FROZEN", f"gate.json 通过（{g.get('approved_by', '未知')} 签核）"

    gate_file = req_dir / "reviews" / f"{stage}.gate.json"
    data = _read(gate_file)
    if data is None:
        return "NOT_GATED", "无 gate.json（未过门禁）"
    try:
        gate = json.loads(data)
        _require_gate_package(req_dir, gate)
    except (json.JSONDecodeError, OSError, TypeError, ValueError):
        return "DRAFT", "gate.json 损坏"
    if gate.get("status") == "BLOCKED":
        return "BLOCKED", "最近判定 BLOCKED（人工介入）"
    if gate.get("status") != "PASS":
        return "DRAFT", f"最近判定 {gate.get('status')}"
    lifecycle_path = req_dir / "reviews" / f"{stage}.issue-lifecycle.json"
    if lifecycle_path.exists() or lifecycle_path.is_symlink():
        try:
            lifecycle = LifecycleGateStore(
                req_dir / "reviews", stage).load_lifecycle()
            bound_digest = gate.get("lifecycle_snapshot_digest")
            if lifecycle is None or not isinstance(bound_digest, str):
                raise ValueError("PASS gate 未绑定 Issue 生命周期")
            project_pass_gate(
                lifecycle, stage=stage, status="PASS",
                lifecycle_snapshot_digest=bound_digest,
                gate_digest=_sha256(gate_file) or "")
        except (OSError, TypeError, ValueError) as exc:
            return "DRAFT", f"Issue 生命周期凭证无效：{exc}"
    plan_detail = None
    if stage == "计划":
        closeout_file = req_dir / "reviews" / "计划.closeout.json"
        closeout_text = _read(closeout_file)
        if closeout_text is not None:
            try:
                closeout = json.loads(closeout_text)
            except json.JSONDecodeError:
                return "DRAFT", "计划.closeout.json 损坏"
            if closeout.get("status") != "PASS":
                return "DRAFT", "计划收口凭证不是 PASS"
            if closeout.get("plan_gate_sha256") != _sha256(gate_file):
                return "DRAFT", "计划门禁已更新——需重新收口"
            closeout_hashes = closeout.get("doc_hashes") or {}
            if set(closeout_hashes) != set(STAGES["计划"]["docs"]):
                return "DRAFT", "计划收口凭证未完整覆盖阶段文档"
            for doc, want in closeout_hashes.items():
                cur = _sha256(req_dir / doc)
                if cur is None:
                    return "DRAFT", f"{doc} 已不存在"
                if cur != want and material_current is not True:
                    return "DRAFT", f"{doc} 收口后有改动（哈希失配）"
            plan_detail = "gate.json PASS（已收口，完整终态哈希一致）"
        elif gate.get("execution_baseline_hashes"):
            current = _plan_baseline_hashes(req_dir)
            baseline_hashes = gate["execution_baseline_hashes"]
            if set(baseline_hashes) != set(STAGES["计划"]["docs"]):
                return "DRAFT", "执行前计划基线未完整覆盖阶段文档"
            for doc, want in baseline_hashes.items():
                if current.get(doc) != want and material_current is not True:
                    return "DRAFT", f"{doc} 执行前计划基线有改动（哈希失配）"
            plan_detail = "gate.json PASS（执行中，允许更新执行记录与勾选状态）"
        else:
            # Legacy credentials predate the execution baseline projection.
            for doc, want in (gate.get("doc_hashes") or {}).items():
                cur = _sha256(req_dir / doc)
                if cur is None:
                    return "DRAFT", f"{doc} 已不存在"
                if cur != want and material_current is not True:
                    return "DRAFT", f"{doc} 冻结后有改动（哈希失配）"
    else:
        for doc, want in (gate.get("doc_hashes") or {}).items():
            cur = _sha256(req_dir / doc)
            if cur is None:
                return "DRAFT", f"{doc} 已不存在"
            if cur != want and material_current is not True:
                return "DRAFT", f"{doc} 冻结后有改动（哈希失配）"
    if stage == "UI设计":
        ui_doc = STAGES[stage]["docs"][0]
        ui_text = _read(req_dir / ui_doc)
        if ui_text is None:
            return "DRAFT", f"{ui_doc} 已不存在"
        ui_checks = Checks(stage)
        _check_ui_prototypes(ui_checks, req_dir, ui_text)
        if ui_checks.fails:
            return "DRAFT", "原型/截图确认或依赖已失效：" + "；".join(
                item["detail"] or item["name"] for item in ui_checks.fails[:3])
    # 上游指纹核验（第八轮审计 P1）：任一上游重冻结 → 本阶段失效，需重过门禁
    recorded = gate.get("upstream_fingerprints") or {}
    for up in STAGES[stage]["upstream"]:
        if consumed_current:
            continue
        cur_fp = _stage_fingerprint(req_dir, up, dynamic_state)
        if cur_fp is None:
            return "DRAFT", f"上游 {up} 的 gate 凭证缺失"
        if recorded.get(up) != cur_fp:
            return "DRAFT", (f"上游 {up} 已重新冻结（指纹失配）——"
                            f"本阶段需重过门禁")
    if plan_detail is not None:
        return "FROZEN", plan_detail
    return "FROZEN", f"gate.json PASS（iteration {gate.get('iteration')}）"


# ══════════════════════════ 硬校验引擎 ══════════════════════════

class Checks:
    def __init__(self, stage: str):
        self.stage = stage
        self.items: list[dict] = []

    def add(self, group: str, name: str, ok: bool, detail: str = "") -> None:
        self.items.append({"group": group, "name": name,
                           "status": "PASS" if ok else "FAIL", "detail": detail})

    @property
    def fails(self) -> list[dict]:
        return [c for c in self.items if c["status"] == "FAIL"]

    def to_dict(self) -> dict:
        return {"stage": self.stage, "checks": self.items,
                "summary": {"pass": len(self.items) - len(self.fails),
                            "fail": len(self.fails)}}


def _check_structure(c: Checks, doc: str, text: str, required: list[str]) -> None:
    headers = re.findall(r"^##\s+(.+)$", text, re.M)
    def _norm(h: str) -> str:
        h = re.split(r"[（(]", h.strip())[0].strip()
        return re.sub(r"^\d+(\.\d+)*[.、\s]*", "", h)   # 剥编号前缀（"1. 简介"→"简介"）
    have = {_norm(h) for h in headers}
    missing = [s for s in required if s not in have]
    c.add("structure", f"必填章节：{doc}",
          not missing, "缺失: " + "、".join(missing) if missing else "")


def _check_placeholders(c: Checks, doc: str, text: str) -> None:
    ph = _placeholders(text)
    c.add("placeholder", f"占位符已替换：{doc}", not ph,
          f"残留 {len(ph)} 处: {'、'.join(ph[:3])}…" if ph else "")


_PROTOTYPE_BLOCK = re.compile(r"(?ms)^```aek-prototypes\s*\n(.*?)^```\s*$")
_PROTOTYPE_DIGEST = re.compile(r"^[0-9a-f]{64}$")
_PROTOTYPE_MAX_BYTES = MAX_HTML_BYTES
_SCREENSHOT_MAX_BYTES = 200 * 1024 * 1024


def _open_dir_nofollow(path: Path):
    return _ui_fs.open_absolute_dir(Path(os.path.abspath(path)))


def _read_beneath(root_fd: int, relative: str, limit: int) -> bytes:
    path = PurePosixPath(relative)
    if (path.is_absolute() or not path.parts or ".." in path.parts
            or "\\" in relative or any(part in {"", "."} for part in path.parts)):
        raise ValueError("path must remain below the approved root")
    parent = _ui_fs.dup_dir(root_fd)
    try:
        for part in path.parts[:-1]:
            child = _ui_fs.open_child_dir(parent, part)
            _ui_fs.close_dir(parent)
            parent = child
        fd = _ui_fs.open_file(parent, path.parts[-1], os.O_RDONLY)
        try:
            before = os.fstat(fd)
            if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
                raise ValueError("prototype must be a regular file within the size limit")
            chunks = []
            remaining = limit + 1
            while remaining:
                block = os.read(fd, min(64 * 1024, remaining))
                if not block:
                    break
                chunks.append(block)
                remaining -= len(block)
            data = b"".join(chunks)
            after = os.fstat(fd)
            if len(data) > limit or (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                    after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ValueError("prototype changed during validation or exceeds the size limit")
            return data
        finally:
            os.close(fd)
    finally:
        _ui_fs.close_dir(parent)


def _hash_regular_beneath(root_fd: int, relative: str, limit: int) -> tuple[str, int]:
    path = PurePosixPath(relative)
    if (path.is_absolute() or not path.parts or ".." in path.parts
            or "\\" in relative or any(part in {"", "."} for part in path.parts)):
        raise ValueError("path must remain below the approved root")
    parent = _ui_fs.dup_dir(root_fd)
    try:
        for part in path.parts[:-1]:
            child = _ui_fs.open_child_dir(parent, part)
            _ui_fs.close_dir(parent)
            parent = child
        fd = _ui_fs.open_file(parent, path.parts[-1], os.O_RDONLY)
        try:
            before = os.fstat(fd)
            if not stat.S_ISREG(before.st_mode) or not 1 <= before.st_size <= limit:
                raise ValueError("screenshot must be a regular non-empty file within the size limit")
            digest = hashlib.sha256()
            total = 0
            while True:
                block = os.read(fd, 1024 * 1024)
                if not block:
                    break
                total += len(block)
                if total > limit:
                    raise ValueError("screenshot exceeds the size limit")
                digest.update(block)
            after = os.fstat(fd)
            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                    after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ValueError("screenshot changed during validation")
            return digest.hexdigest(), total
        finally:
            os.close(fd)
    finally:
        _ui_fs.close_dir(parent)


def _expected_ui_evidence_path(row: dict) -> str:
    permissions = row.get("permissions")
    if (not isinstance(permissions, dict) or set(permissions) != {"function_id", "data_id"}
            or any(not isinstance(permissions[key], str)
                   or not re.fullmatch(r"[A-Z][A-Z0-9_-]{0,31}", permissions[key])
                   for key in permissions)):
        raise ValueError("UI-EV permission identity is invalid")
    ident, state = row.get("id"), row.get("state")
    if not isinstance(ident, str) or not re.fullmatch(r"P[1-9][0-9]*", ident):
        raise ValueError("UI-EV ID is invalid")
    if state not in {"default", "loading", "empty", "error", "dialog", "drawer", "permission"}:
        raise ValueError("UI-EV state is invalid")
    parts = ["function", permissions["function_id"], "data", permissions["data_id"]]
    for key in ("system_version", "viewport"):
        if key in row:
            value = row[key]
            pattern = r"[A-Z][A-Z0-9_-]{0,31}" if key == "system_version" else r"[1-9][0-9]{1,4}x[1-9][0-9]{1,4}"
            if not isinstance(value, str) or not re.fullmatch(pattern, value):
                raise ValueError(f"UI-EV {key} is invalid")
            parts.extend(("version" if key == "system_version" else "viewport", value))
    filename = ident + ("" if state == "default" else "-" + state) + ".png"
    return "/".join((*parts, filename))


def _prototype_confirmation_digest(page_id: str, area_id: str,
                                   prototype_digest: str, dependency_digest: str, *,
                                   state_id=None, context_id=None, scope_digest=None) -> str:
    value = {"page_id": page_id, "area_id": area_id,
             "prototype_sha256": prototype_digest,
             "dependency_sha256": dependency_digest}
    if any(part is not None for part in (state_id, context_id, scope_digest)):
        _prototype_target({'page_id': page_id, 'area_id': area_id,
                           'state_id': state_id, 'context_id': context_id}, 2)
        if type(scope_digest) is not str or not _PROTOTYPE_DIGEST.fullmatch(scope_digest):
            raise ValueError('invalid prototype scope digest')
        value.update(schema_version=2, state_id=state_id, context_id=context_id, scope_digest=scope_digest)
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def _prototype_confirmation_path(page_id: str, area_id: str,
                                 prototype_digest: str, dependency_digest: str, **identity) -> str:
    if (not re.fullmatch(r"PAGE-[A-Z0-9_-]{1,56}", page_id)
            or not re.fullmatch(r"AREA-[A-Z0-9_-]{1,56}", area_id)
            or not _PROTOTYPE_DIGEST.fullmatch(prototype_digest)
            or not _PROTOTYPE_DIGEST.fullmatch(dependency_digest)):
        raise ValueError("invalid prototype confirmation identity")
    if identity:
        return 'v2-' + _prototype_confirmation_digest(
            page_id, area_id, prototype_digest, dependency_digest, **identity) + '.json'
    return f"{page_id}--{area_id}--{prototype_digest}--{dependency_digest}.json"


def _prototype_target(item: dict, schema_version: int) -> tuple:
    keys = ('page_id', 'area_id') if schema_version == 1 else ('page_id', 'area_id', 'state_id', 'context_id')
    if any(type(item.get(key)) is not str for key in keys):
        raise ValueError('invalid prototype target identity')
    if schema_version >= 2 and (
            not re.fullmatch(r'PAGE-[1-9][0-9]*', item['page_id'])
            or not re.fullmatch(r'AREA-[1-9][0-9]*', item['area_id'])
            or item['state_id'] not in {'default', 'loading', 'empty', 'error', 'dialog', 'drawer', 'permission'}
            or not re.fullmatch(r'[A-Z][A-Z0-9_-]{0,31}', item['context_id'])):
        raise ValueError('invalid prototype state or context identity')
    return tuple(item[key] for key in keys)


def _prototype_baseline_key(target: tuple, baselines: dict) -> tuple:
    # A shared legacy layout remains explicit. Typed mappings never fall back
    # to another state/context, and mixed shared/typed declarations are invalid.
    if target in baselines:
        return target
    if target[:2] in baselines:
        return target[:2]
    raise ValueError('UI source baseline is missing the prototype state/context')


def _prototype_manifest(text: str) -> dict:
    blocks = list(_PROTOTYPE_BLOCK.finditer(text))
    if len(blocks) != 1:
        raise ValueError("UI设计必须且只能包含一个 aek-prototypes JSON 区块")
    manifest = json.loads(blocks[0].group(1), object_pairs_hook=_unique_json_object)
    if (not isinstance(manifest, dict) or set(manifest) != {"schema_version", "prototypes"}
            or type(manifest.get('schema_version')) is not int or manifest['schema_version'] not in (1, 2, 3)
            or not isinstance(manifest.get("prototypes"), list) or not manifest['prototypes']
            or (manifest['schema_version'] >= 2 and len(manifest['prototypes']) > 32)):
        raise ValueError("原型确认清单格式无效")
    return manifest


def _prototype_manifest_version(raw):
    if raw is None:
        return None
    text = raw.decode('utf-8', errors='strict')
    return _prototype_manifest(text)['schema_version'] if _PROTOTYPE_BLOCK.search(text) else None


def _write_prototype_confirmation(req_dir: Path, page_id: str, area_id: str,
                                  prototype_digest: str, dependency_digest: str,
                                  reviewer: str, reviewed_at: str,
                                  phrase: str, *, selection=None, **identity) -> Path:
    """Create immutable local confirmation evidence; never replace an existing receipt."""
    confirmation_digest = _prototype_confirmation_digest(
        page_id, area_id, prototype_digest, dependency_digest, **identity)
    expected_phrase = f"ACCEPT {confirmation_digest[:12]}"
    if selection is not None:
        if not identity:
            raise ValueError('a batch selection requires an explicit v2 identity')
        expected_phrase = _prototype_selection_phrase(selection, {
            'page_id': page_id, 'area_id': area_id, 'prototype_sha256': prototype_digest,
            'dependency_sha256': dependency_digest, **identity})
    if phrase != expected_phrase:
        raise ValueError("confirmation phrase does not match prototype and dependency digests")
    name = _prototype_confirmation_path(
        page_id, area_id, prototype_digest, dependency_digest, **identity)
    receipt = {
        "schema_version": 1, "decision": "ACCEPTED", "page_id": page_id,
        "area_id": area_id, "prototype_sha256": prototype_digest,
        "dependency_sha256": dependency_digest, "reviewer": reviewer,
        "reviewed_at": reviewed_at, "confirmation_method": "interactive_tty",
        "confirmation_phrase": phrase,
    }
    if identity:
        receipt.update(schema_version=2, **identity)
    if selection is not None:
        receipt['selection'] = selection
    return _publish_prototype_receipt(req_dir, name, receipt)


def _publish_prototype_receipt(req_dir, name, receipt):
    reviews = req_dir / "reviews"
    root_fd = _open_dir_nofollow(req_dir)
    try:
        reviews_fd = _ui_fs.open_child_dir(root_fd, "reviews", create=True)
    finally:
        _ui_fs.close_dir(root_fd)
    try:
        receipts_fd = _ui_fs.open_child_dir(reviews_fd, "ui-prototype-confirmations", create=True)
        try:
            data = (json.dumps(receipt, ensure_ascii=False, sort_keys=True,
                               separators=(",", ":")) + "\n").encode("utf-8")
            temporary = f".{name}.tmp-{secrets.token_hex(8)}"
            try:
                fd = _ui_fs.open_file(receipts_fd, temporary,
                                      os.O_WRONLY | os.O_CREAT | os.O_EXCL)
                try:
                    _write_all(fd, data)
                    os.fsync(fd)
                finally:
                    os.close(fd)
                # Publish the complete receipt atomically without replacing an
                # existing human confirmation, on both supported platforms.
                _ui_fs.rename_noreplace(receipts_fd, temporary, receipts_fd, name)
                _ui_fs.fsync_dir(receipts_fd)
                return reviews / "ui-prototype-confirmations" / name
            finally:
                try:
                    _ui_fs.unlink(receipts_fd, temporary)
                except FileNotFoundError:
                    pass
        finally:
            _ui_fs.close_dir(receipts_fd)
    finally:
        _ui_fs.close_dir(reviews_fd)


_INTERACTION_PROFILES = ContextVar('trusted_interaction_profiles', default=None)


def _interactive_profile(repo_root, target):
    from aek.adapters.security_host import TerminalHostEventSource
    from aek.adapters.ui_interactive_host import LinuxInteractiveHostProfile

    profiles = _INTERACTION_PROFILES.get()
    profile = profiles.get(target) if profiles is not None else None
    if (type(profile) is not LinuxInteractiveHostProfile or profile._target != target
            or Path(profile._authority.repository_ref) != repo_root
            or type(profile._authority.host_source) is not TerminalHostEventSource
            or not profile.control_fence()):
        raise ValueError('INTERACTION_UNAVAILABLE: trusted interaction host required')
    return profile


def _interaction_confirmation_member(repo_root, target, item, source_ref=None):
    from aek.core.security.authority import digest

    profile = _interactive_profile(repo_root, target)
    observed = profile.read_result(expected_item=item, source_ref=source_ref)
    if observed is None:
        raise ValueError('INTERACTION_UNAVAILABLE: current trusted interaction observation required')
    facts = observed.facts
    member = {
        'target': list(target), 'prepare_sha256': _prototype_prepared_payload([item], 3)['prepare_sha256'],
        'prototype_sha256': item['prototype_sha256'], 'dependency_sha256': item['dependency_sha256'],
        'spec_sha256': item['spec_sha256'], 'scope_digest': item['scope_digest'],
        'interaction_ref': observed.metadata['ref'], 'runtime_plan_digest': facts['plan_sha256'],
        'observation_provenance': observed.provenance_ref, 'observation_digest': digest(facts),
        'observed_states': [capture['state'] for capture in facts['captures']],
    }
    return profile, member


def _interactive_receipt_name(member):
    from aek.core.security.authority import digest
    return 'v3-' + digest(member) + '.json'


def _read_interactive_confirmation(req_dir, profile, member):
    name = _interactive_receipt_name(member)
    root = _open_dir_nofollow(req_dir)
    try:
        try:
            raw = _read_beneath(root, 'reviews/ui-prototype-confirmations/' + name, 64 * 1024)
        except FileNotFoundError:
            return None
    finally:
        _ui_fs.close_dir(root)
    receipt = json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_json_object)
    if (type(receipt) is not dict or set(receipt) != {'schema_version', 'decision', 'selection', 'event_id', 'reviewer'}
            or type(receipt['schema_version']) is not int or receipt['schema_version'] != 3
            or receipt['decision'] != 'ACCEPTED'):
        raise ValueError('invalid v3 prototype confirmation')
    selection = receipt['selection']
    authority = profile._authority
    if (type(selection) is not dict or set(selection) != {'schema_version', 'prepare_sha256', 'members'}
            or selection['schema_version'] != 3 or type(selection['members']) is not list
            or sum(candidate == member for candidate in selection['members']) != 1
            or not authority.host_source.verify_prototype_confirmation(
                authority, receipt['event_id'], selection, receipt['reviewer'])):
        raise ValueError('prototype confirmation is not current trusted terminal evidence')
    return {'receipt_ref': 'reviews/ui-prototype-confirmations/' + name, 'reviewer': receipt['reviewer']}


def _ui_observation_contract() -> dict:
    if not _installed_layout:
        return _extraction_contract(_script_dir / 'skills/design-pipeline')
    # Both installed surfaces are managed copies of the same resource. Missing
    # client trees are allowed; conflicting/unsafe copies must not be selected
    # by fallback. Nothing in candidate material chooses a prompt path.
    contracts = []
    for surface in ('.agents', '.claude'):
        skill_root = _script_dir.parent.parent / surface / 'skills/design-pipeline'
        try:
            handle = _ui_fs.open_absolute_dir(skill_root)
        except FileNotFoundError:
            continue
        _ui_fs.close_dir(handle)
        contracts.append(_extraction_contract(skill_root))
    if not contracts or any(item != contracts[0] for item in contracts):
        raise ValueError('current managed observation contract is unavailable or inconsistent')
    return contracts[0]


def _ui_observation_evidence_state(evidence: dict, context_ids: set[str]) -> dict:
    # Unselected permission contexts and reverse projection updates are not
    # dependencies of this consumer. Selected applicability remains mandatory.
    return {**{key: value for key, value in evidence.items()
               if key not in ('applies_to', 'prototype_refs')},
            'applies_to': [item for item in evidence.get('applies_to', [])
                          if isinstance(item, dict) and item.get('context_id') in context_ids]}


def _verify_ui_observation_refs(material_fd, regions, scope, contract, image_digests) -> None:
    refs = [(region['region_id'], ref) for region in regions
            for ref in region.get('observations', [])]
    if not refs:
        return
    with _UiObservationStore(material_fd, create=False) as store:
        for region_id, ref in refs:
            source = {'scope_digest': scope, 'evidence_id': ref['evidence_id'],
                      'image_sha256': image_digests[ref['evidence_id']]}
            store.verify_current(source, contract, (region_id,), ref['sha256'])


def _ui_outline_material(req_dir, root, state):
    mapped = _capture_mapped_stage(req_dir, '概要设计', state)
    if mapped is None:
        raw = _read_beneath(root, '概要设计.md', 10 * 1024 * 1024)
        text = raw.decode('utf-8', errors='strict')
        blocks = {match.group(1): _block(text, match.start())
                  for match in re.finditer(r'^###\s*(F\d+)：', text, re.M)}
        return {'概要设计.md': raw}, blocks
    frame = mapped[1]
    sources = frame.sources()
    blocks = {location.label: sources[location.path][location.start:location.end].decode('utf-8', errors='strict')
              for location in frame.locations
              if location.artifact_id == 'outline-design' and location.category == 'points'}
    return sources, blocks


def _ui_upstream_digest(requirements, overview_sources, mapped):
    if mapped:
        outline_identity = hashlib.sha256(json.dumps(
            {name: hashlib.sha256(raw).hexdigest() for name, raw in overview_sources.items()},
            sort_keys=True, separators=(',', ':')).encode('utf-8')).digest()
    else:
        outline_identity = hashlib.sha256(overview_sources['概要设计.md']).digest()
    return hashlib.sha256(hashlib.sha256(requirements).digest() + outline_identity).hexdigest()


def _current_ui_coverage(c: Checks, req_dir: Path, dynamic_state, plan_required: bool):
    """Read classification facts from the original reviewed upstream, not UI.

    Legacy v1 without classification/ArtifactPlan keeps its original behavior.
    A dynamic plan cannot waive missing classification by deleting a UI block.
    Only bounded text is read here; NON_UI never touches screenshot storage.
    """
    try:
        if _mapped_stage_roles(dynamic_state, '需求分析'):
            raise ValueError('外部需求尚无当前 UI 分类凭证读取入口')
        mapped = bool(_mapped_stage_roles(dynamic_state, '概要设计'))
        root = _open_dir_nofollow(req_dir)
        try:
            try:
                overview_sources, feature_blocks = _ui_outline_material(req_dir, root, dynamic_state)
            except FileNotFoundError:
                if dynamic_state is None:
                    return None
                raise ValueError('UI classification upstream overview is missing')
            overviews = [raw.decode('utf-8', errors='strict') for raw in overview_sources.values()]
            starts = [match for text in overviews
                      for match in re.finditer(r'^```aek-ui-classification[ \t]*\r?$', text, re.M)]
            if not starts and dynamic_state is None:
                return None
            blocks = [match for text in overviews for match in re.finditer(
                r'^```aek-ui-classification[ \t]*\r?\n(.*?)^```[ \t]*\r?$', text, re.M | re.S)]
            if len(starts) != 1 or len(blocks) != 1:
                raise ValueError('UI classification needs one complete upstream JSON block')
            raw = blocks[0].group(1)
            if len(raw.encode('utf-8')) > 256 * 1024:
                raise ValueError('UI classification exceeds byte limit')
            classification = json.loads(raw, object_pairs_hook=_unique_json_object)
            requirements_raw = _read_beneath(root, '需求分析.md', 10 * 1024 * 1024)
        finally:
            _ui_fs.close_dir(root)
        requirements = requirements_raw.decode('utf-8', errors='strict')
        logical_inputs = {'需求分析.md': requirements}
        if not mapped:
            logical_inputs['概要设计.md'] = overviews[0]
        material = parse_review_documents('UI设计', logical_inputs, '0' * 64)
        feature_ids, acceptance_ids = list(feature_blocks) if mapped else [], []
        for section in material.snapshot.sections:
            for ident in section.defines_ids:
                if section.document == '概要设计.md' and re.fullmatch(r'F[1-9][0-9]*', ident):
                    feature_ids.append(ident)
                if section.document == '需求分析.md' and re.fullmatch(r'A[1-9][0-9]*', ident):
                    acceptance_ids.append(ident)
        upstream_current = (material.snapshot.parse_complete and not material.snapshot.unknown_edges
                            and stage_frozen(req_dir, '概要设计', dynamic_state)[0] == 'FROZEN')
        root = _open_dir_nofollow(req_dir)
        try:
            if (_ui_outline_material(req_dir, root, dynamic_state)[0] != overview_sources
                    or _read_beneath(root, '需求分析.md', 10 * 1024 * 1024) != requirements_raw):
                raise ValueError('UI classification upstream changed during validation')
        finally:
            _ui_fs.close_dir(root)
        scope = classify_ui_scope(feature_ids=feature_ids, acceptance_ids=acceptance_ids,
            classification=classification,
            requirements_sha256=hashlib.sha256(requirements_raw).hexdigest(),
            upstream_current=upstream_current, plan_required=plan_required)
        if mapped:
            _require_approved_upstream(req_dir, dynamic_state, {
                '概要设计': overview_sources, '需求分析': {'需求分析.md': requirements_raw}})
        scope = replace(scope, upstream_sha256=_ui_upstream_digest(requirements_raw, overview_sources, mapped))
        c.add('prototype', '上游 UI 分类完整且当前', scope.complete,
              '；'.join(scope.gaps) + ('；缺口已截断' if scope.truncated else ''))
        return scope
    except (OSError, ValueError, KeyError, TypeError, UnicodeError, RecursionError) as exc:
        c.add('prototype', '上游 UI 分类完整且当前', False, str(exc))
        # A non-complete immutable scope ensures callers never continue to IO.
        return classify_ui_scope(feature_ids=(), acceptance_ids=(), classification=None,
            requirements_sha256='', upstream_current=False, plan_required=plan_required)


def _check_ui_prototypes(c: Checks, req_dir: Path, text: str, *,
                         require_confirmation: bool = True,
                         dependency_out: dict | None = None,
                         dynamic_state=None, selected_targets=None, preparation_out=None,
                         preview_out=None, mapped_ui=None) -> None:
    """Re-read accepted UI prototypes and evidence at the existing UI stage gate."""
    blocks = list(_PROTOTYPE_BLOCK.finditer(text))
    required = "<!-- aek-prototypes:required -->" in text
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            c.add("prototype", "原型要求的上游计划有效", False,
                  "ArtifactPlan 未冻结或不可用")
            return
        # The reviewed document cannot opt out of its authoritative plan.
        required = required or dynamic_state.plan.by_id("ui-design").classification == "required"
    coverage = _current_ui_coverage(c, req_dir, dynamic_state, required)
    if coverage is not None:
        if not coverage.complete:
            return
        required = required or bool(coverage.required)
    if not blocks:
        if required:
            c.add("prototype", "原型确认清单存在", False, "缺少 aek-prototypes JSON 区块")
        return
    if len(blocks) != 1:
        c.add("prototype", "原型确认清单唯一", False, "只能有一个 aek-prototypes JSON 区块")
        return
    try:
        manifest = _prototype_manifest(text)
        version = manifest['schema_version']
        if mapped_ui is not None and version != 3:
            raise ValueError('mapped UI prototypes require the explicit schema 3 contract')
        if version == 3 and (dynamic_state is None
                or dynamic_state.plan.by_id('ui-design').classification != 'required'):
            raise ValueError('interactive prototypes require a frozen plan with required UI')
        repo_root, package = _package_locations(req_dir)
        prototype_root = req_dir if mapped_ui is None else repo_root / Path(mapped_ui[0]).parent
        approved_root = prototype_root.relative_to(repo_root).as_posix()
        root_fd = _open_dir_nofollow(req_dir)
        prototype_fd = root_fd
        material_fd = None
        material_rel = package.material_root + "/截图索引.json"
        try:
            if prototype_root != req_dir:
                prototype_fd = _open_dir_nofollow(prototype_root)
            repo_fd = _open_dir_nofollow(repo_root)
            try:
                index = json.loads(_read_beneath(repo_fd, material_rel, 8 * 1024 * 1024).decode("utf-8"),
                                   object_pairs_hook=_unique_json_object)
            finally:
                _ui_fs.close_dir(repo_fd)
            if (not isinstance(index, dict) or index.get("schema_version") != 1
                    or not isinstance(index.get("screenshots"), list)):
                raise ValueError("screenshot index schema or change ID is invalid")
            # Legacy schema1 used change_id as its actual directory. New
            # indexes retain a stable machine ID and bind the display directory.
            dirname = index.get("requirement_dir", index.get("change_id"))
            if dirname != (req_dir.name if package.layout == 'legacy' else package.title):
                raise ValueError("screenshot index requirement directory does not match this SDD")
            if package.layout != 'legacy':
                if index.get('change_id') != package.change_id:
                    raise ValueError('screenshot index machine ID does not match its registered package')
            elif "requirement_dir" in index:
                match = re.fullmatch(r"([0-9]{3})-.+", dirname)
                if (len(dirname) > 180 or unicodedata.normalize("NFC", dirname) != dirname
                        or not match or index.get("change_id") != "CHG-" + match.group(1)):
                    raise ValueError("screenshot index machine ID does not match its requirement number")
            material_fd = _open_dir_nofollow(repo_root / package.material_root)
            screenshots: dict[str, dict] = {}
            for screenshot in index["screenshots"]:
                if (not isinstance(screenshot, dict) or not isinstance(screenshot.get("id"), str)
                        or screenshot["id"] in screenshots):
                    raise ValueError("screenshot index has invalid or duplicate UI-EV IDs")
                screenshots[screenshot["id"]] = screenshot
            if coverage is not None:
                mapped = check_ui_coverage(coverage, manifest['prototypes'], index['screenshots'],
                                           selected_targets=selected_targets)
                c.add('ui-coverage', '上游 UI 义务反向覆盖', mapped.complete,
                      '；'.join(mapped.gaps) + ('；缺口已截断' if mapped.truncated else ''))
                if not mapped.complete:
                    return
            design_system = index.get("design_system")
            if not isinstance(design_system, dict):
                raise ValueError("截图索引缺少设计体系")
            design_digest = hashlib.sha256(json.dumps(
                design_system, ensure_ascii=False, sort_keys=True, separators=(",", ":")
            ).encode("utf-8")).hexdigest()
            requirements_raw = _read_beneath(root_fd, "需求分析.md", 10 * 1024 * 1024)
            overview_sources, feature_blocks = _ui_outline_material(req_dir, root_fd, dynamic_state)
            if coverage is not None and _ui_upstream_digest(requirements_raw, overview_sources,
                    bool(_mapped_stage_roles(dynamic_state, '概要设计'))) != coverage.upstream_sha256:
                raise ValueError('UI upstream changed before prototype dependency checks')
            current_acceptance = parse_a_items(requirements_raw.decode("utf-8", errors="strict"))
            page_blocks = _ui_page_blocks(text, mapped_ui)
            # Opt-in v2 source/region projection. Legacy manifests and receipt
            # schemas stay unchanged; a declared baseline joins the existing
            # dependency hash and cannot manufacture an approval.
            baseline_blocks = list(re.finditer(r'^```aek-ui-baseline\s*\n(.*?)\n```', text, re.M | re.S))
            baseline_starts = list(re.finditer(r'^```aek-ui-baseline\s*$', text, re.M))
            baselines = None
            if baseline_starts:
                if len(baseline_starts) != 1 or len(baseline_blocks) != 1:
                    raise ValueError('UI source baseline must have one complete JSON block')
                raw_baseline = baseline_blocks[0].group(1)
                if len(raw_baseline.encode('utf-8', errors='strict')) > MAX_BASELINE_BYTES:
                    raise ValueError('UI source baseline exceeds byte limit')
                baseline_manifest = json.loads(raw_baseline, object_pairs_hook=_unique_json_object)
                baselines = _read_ui_baseline(repo_root, baseline_manifest)
                prototype_targets = {_prototype_baseline_key(_prototype_target(item, version), baselines)
                                     for item in manifest['prototypes']}
                if set(baselines) != prototype_targets:
                    raise ValueError('UI source baseline targets do not match current prototypes')
            seen = set()
            errors: list[str] = []
            pending_dependencies = {}
            pending_preparations = {}
            pending_previews = {}
            typed_targets = {}
            observation_targets = {}
            has_observations = baselines is not None and any(
                region.get('observations') for region in baseline_manifest['regions'])
            observation_contract = None
            package_scope = req_dir.name if package.layout == 'legacy' else package.package_ref + '\0' + package.revision
            observation_scope = (_observation_scope(repo_root, package_scope, index['change_id'])
                                 if has_observations else None)
            for number, item in enumerate(manifest["prototypes"], 1):
                where = f"prototypes[{number}]"
                required_keys = {"prototype_path", "prototype_sha256", "page_id", "area_id",
                                 "feature_ids", "acceptance_ids", "change_intent", "depends_on",
                                 "artifact_plan_id", "gate_digest", "approved_root", "status",
                                 "reviewer", "reviewed_at", "confirmation_source", "evidence_contexts",
                                 "design_system_sha256", "dependency_sha256"}
                if version >= 2:
                    required_keys -= {'status', 'reviewer', 'reviewed_at', 'confirmation_source', 'dependency_sha256'}
                    required_keys |= {'state_id', 'context_id'}
                if version == 3:
                    required_keys |= {'prototype_mode', 'interaction_spec'}
                if not isinstance(item, dict) or set(item) != required_keys:
                    errors.append(f"{where}: schema mismatch")
                    continue
                if version >= 2:
                    if (len(json.dumps(item, ensure_ascii=False, allow_nan=False).encode('utf-8')) > 64 * 1024
                            or type(item['artifact_plan_id']) is not str or not item['artifact_plan_id'].strip()
                            or len(item['artifact_plan_id']) > 120 or '\0' in item['artifact_plan_id']
                            or type(item['gate_digest']) is not str
                            or not _PROTOTYPE_DIGEST.fullmatch(item['gate_digest'])):
                        raise ValueError('invalid v2 prototype metadata or byte limit')
                    for key, prefix in (('feature_ids', 'F'), ('acceptance_ids', 'A')):
                        ids = item[key]
                        if (type(ids) is not list or not ids or len(ids) > 128
                                or any(type(ident) is not str or not re.fullmatch(prefix + r'[1-9][0-9]*', ident)
                                       for ident in ids) or len(ids) != len(set(ids))):
                            raise ValueError('invalid v2 prototype trace identities')
                target = _prototype_target(item, version)
                if target in seen:
                    raise ValueError('duplicate prototype target identity')
                seen.add(target)
                if selected_targets is not None and target not in selected_targets:
                    continue
                if version == 1 and (item["status"] != "ACCEPTED" or item["confirmation_source"] != "maintainer_reply"
                        or not isinstance(item["reviewer"], str)
                        or not item["reviewer"].strip() or not isinstance(item["reviewed_at"], str)
                        or not item["reviewed_at"].strip()):
                    errors.append(f"{where}: ACCEPTED requires a named maintainer and timestamp")
                    continue
                if version == 1:
                    try:
                        reviewed_at = datetime.fromisoformat(item["reviewed_at"].replace("Z", "+00:00"))
                    except (ValueError, AttributeError):
                        errors.append(f"{where}: invalid review timestamp")
                        continue
                    if reviewed_at.tzinfo is None:
                        errors.append(f"{where}: review timestamp must include a timezone")
                        continue
                path = item["prototype_path"]
                page_id, area_id = item["page_id"], item["area_id"]
                id_lists_ok = (isinstance(item["feature_ids"], list) and item["feature_ids"]
                               and all(re.fullmatch(r"F[1-9][0-9]*", str(x)) for x in item["feature_ids"])
                               and isinstance(item["acceptance_ids"], list) and item["acceptance_ids"]
                               and all(re.fullmatch(r"A[1-9][0-9]*", str(x)) for x in item["acceptance_ids"]))
                if (item["approved_root"] != approved_root
                        or not isinstance(page_id, str) or not re.fullmatch(r"PAGE-[A-Z0-9_-]+", page_id)
                        or not isinstance(area_id, str) or not re.fullmatch(r"AREA-[A-Z0-9_-]+", area_id)
                        or not id_lists_ok or not isinstance(item["change_intent"], str)
                        or not item["change_intent"].strip()
                        or not isinstance(path, str) or not path.lower().endswith(".html")
                        or not _PROTOTYPE_DIGEST.fullmatch(str(item["prototype_sha256"]))
                        or not _PROTOTYPE_DIGEST.fullmatch(str(item["gate_digest"]))
                        or item["design_system_sha256"] != design_digest
                        or (version == 1 and not _PROTOTYPE_DIGEST.fullmatch(str(item["dependency_sha256"])))
                        or not isinstance(item["depends_on"], list) or not item["depends_on"]
                        or any(not isinstance(value, str) for value in item["depends_on"])
                        or len(item["depends_on"]) != len(set(item["depends_on"]))
                        or not isinstance(item["evidence_contexts"], list) or not item["evidence_contexts"]):
                    errors.append(f"{where}: invalid identity, digest, dependency, or approved root")
                    continue
                if (not set(item["feature_ids"]) <= feature_blocks.keys()
                        or not set(item["acceptance_ids"]) <= current_acceptance.keys()):
                    errors.append(f"{where}: feature/acceptance dependency is missing from current design")
                    continue
                page_block = page_blocks.get(page_id)
                if page_block is None or not re.search(rf"\b{re.escape(area_id)}\b", page_block):
                    errors.append(f"{where}: PAGE/AREA is not present in the current UI design")
                    continue
                try:
                    raw = _read_beneath(prototype_fd, path, _PROTOTYPE_MAX_BYTES)
                    actual_digest = hashlib.sha256(raw).hexdigest()
                    if actual_digest != item["prototype_sha256"]:
                        raise ValueError("prototype SHA-256 does not match the accepted preview")
                    if version == 3:
                        if (item['artifact_plan_id'] != dynamic_state.plan.digest
                                or item['gate_digest'] != dynamic_state.credential.credential_digest):
                            raise ValueError('interactive prototype does not bind the current frozen plan')
                        spec_path, spec_digest = interaction_reference(item)
                        validate_interactive_html(raw, actual_digest)
                        load_interaction_spec(_read_beneath(prototype_fd, spec_path, MAX_INTERACTION_BYTES), spec_digest)
                    else:
                        parser = _SelfContainedHtml()
                        parser.feed(raw.decode("utf-8", errors="strict"))
                        parser.close()
                        if parser.errors:
                            raise ValueError(parser.errors[0])
                    selected_contexts: dict[str, set[str]] = {}
                    for pair in item["evidence_contexts"]:
                        if (not isinstance(pair, dict) or set(pair) != {"evidence_id", "context_id"}
                                or not isinstance(pair["evidence_id"], str)
                                or not isinstance(pair["context_id"], str)
                                or pair["evidence_id"] not in item["depends_on"]):
                            raise ValueError("evidence_contexts contains an invalid UI-EV/context mapping")
                        if version >= 2 and pair['context_id'] in selected_contexts.get(pair['evidence_id'], set()):
                            raise ValueError('duplicate v2 evidence context mapping')
                        selected_contexts.setdefault(pair["evidence_id"], set()).add(pair["context_id"])
                        if version >= 2 and pair['context_id'] != item['context_id']:
                            raise ValueError('prototype context does not match selected evidence context')
                    if set(selected_contexts) != set(item["depends_on"]):
                        raise ValueError("every UI-EV dependency must name at least one permission context")
                    dependency_rows = []
                    for evidence_id in item["depends_on"]:
                        evidence = screenshots.get(evidence_id)
                        if evidence is None:
                            raise ValueError(f"unknown UI-EV: {evidence_id}")
                        if version >= 2 and evidence.get('state') != item['state_id']:
                            raise ValueError('prototype state does not match actual screenshot state')
                        validation = evidence.get("validation", {})
                        if not isinstance(validation, dict):
                            raise ValueError(f"invalid UI-EV validation record: {evidence_id}")
                        expected_path = _expected_ui_evidence_path(evidence)
                        if evidence.get("path") != expected_path:
                            raise ValueError(f"UI-EV path is not the derived material path: {evidence_id}")
                        digest, actual_bytes = _hash_regular_beneath(
                            material_fd, expected_path, _SCREENSHOT_MAX_BYTES)
                        if (validation.get("status") != "valid"
                                or validation.get("content_sha256") != digest
                                or validation.get("bytes") != actual_bytes
                                or evidence.get("placeholder_sha256") == digest):
                            raise ValueError(f"UI-EV is not technically valid: {evidence_id}")
                        semantic = {key: evidence.get(key) for key in (
                            "page", "state", "purpose", "feature_ids", "acceptance_ids")}
                        if any(not isinstance(semantic[key], str) or not semantic[key].strip()
                               for key in ("page", "state", "purpose")):
                            raise ValueError(f"invalid UI-EV semantic metadata: {evidence_id}")
                        for key, prefix in (("feature_ids", "F"), ("acceptance_ids", "A")):
                            values = semantic[key]
                            if (not isinstance(values, list) or not values
                                    or any(not isinstance(value, str)
                                           or not re.fullmatch(rf"{prefix}[1-9][0-9]*", value)
                                           for value in values)
                                    or len(values) != len(set(values))):
                                raise ValueError(f"invalid UI-EV {key}: {evidence_id}")
                        semantic["feature_ids"] = sorted(semantic["feature_ids"])
                        semantic["acceptance_ids"] = sorted(semantic["acceptance_ids"])
                        contexts = evidence.get("applies_to", [])
                        if not isinstance(contexts, list):
                            raise ValueError(f"invalid UI-EV permission contexts: {evidence_id}")
                        confirmed = []
                        for context in contexts:
                            if not isinstance(context, dict):
                                continue
                            review = context.get("content_review")
                            freshness = context.get("freshness")
                            if (isinstance(review, dict) and isinstance(freshness, dict)
                                    and review.get("status") == "applicable"
                                    and review.get("reviewed_sha256") == digest
                                    and freshness.get("status") == "confirmed_current"
                                    and freshness.get("confirmed_sha256") == digest):
                                confirmed.append(context)
                        confirmed_by_id = {context["context_id"]: context for context in confirmed
                                           if isinstance(context.get("context_id"), str)}
                        target_ids = selected_contexts[evidence_id]
                        if version >= 2 and sum(context.get('context_id') == item['context_id']
                                for context in contexts if isinstance(context, dict)) != 1:
                            raise ValueError('prototype context must identify one actual evidence context')
                        if not target_ids <= confirmed_by_id.keys():
                            raise ValueError(f"UI-EV lacks current visual/context confirmation: {evidence_id}")
                        dependency_rows.append({"id": evidence_id, "sha256": digest,
                                                "semantic": semantic,
                                                "contexts": [{"context_id": context_id,
                                                              "permissions": confirmed_by_id[context_id].get("permissions"),
                                                              "system_version": confirmed_by_id[context_id].get("system_version"),
                                                              "viewport": confirmed_by_id[context_id].get("viewport"),
                                                              "relation": confirmed_by_id[context_id].get("relation")}
                                                             for context_id in sorted(target_ids)]})
                        bound = evidence.get("prototype_refs", [])
                        if not any(ref.get("prototype_path") == path
                                   and ref.get("prototype_sha256") == actual_digest
                                   and ref.get("page_id") == page_id and ref.get("area_id") == area_id
                                   and ref.get("feature_ids") == item["feature_ids"]
                                   and ref.get("acceptance_ids") == item["acceptance_ids"]
                                   and ref.get("change_intent") == item["change_intent"]
                                   and ref.get("depends_on") == item["depends_on"]
                                   and ref.get("artifact_plan_id") == item["artifact_plan_id"]
                                   and ref.get("gate_digest") == item["gate_digest"]
                                   and ref.get("approved_root") == approved_root
                                   and ((version == 1 and 'schema_version' not in ref)
                                        or (version >= 2 and type(ref.get('schema_version')) is int
                                        and ref.get('schema_version') == version
                                        and ref.get('state_id') == item['state_id']
                                        and ref.get('context_id') == item['context_id']
                                        and (version != 3 or (
                                            ref.get('prototype_mode') == item['prototype_mode']
                                            and ref.get('interaction_spec') == item['interaction_spec']))))
                                   for ref in bound if isinstance(ref, dict)):
                            raise ValueError(f"UI-EV reverse reference is stale: {evidence_id}")
                    dependency_snapshot = {
                        "design_system_sha256": design_digest,
                        "page_design_sha256": hashlib.sha256(page_block.encode("utf-8")).hexdigest(),
                        "features": {ident: feature_blocks[ident] for ident in sorted(item["feature_ids"])},
                        "acceptance": {ident: current_acceptance[ident]["text"]
                                       for ident in sorted(item["acceptance_ids"])},
                        "evidence": sorted(dependency_rows, key=lambda row: row["id"]),
                    }
                    if package.layout != 'legacy':
                        dependency_snapshot['package_identity'] = {
                            'change_id': package.change_id, 'revision': package.revision,
                            'source_root': package.source_root, 'design_root': package.design_root}
                    receipt_identity = {}
                    if version >= 2:
                        receipt_identity = {'state_id': item['state_id'], 'context_id': item['context_id'],
                            'scope_digest': _observation_scope(repo_root, package_scope, index['change_id'])}
                        dependency_snapshot['prototype_context'] = {
                            'schema_version': version, 'scope_digest': receipt_identity['scope_digest'], 'spec': item}
                    if baselines is not None:
                        baseline = baselines[_prototype_baseline_key(target, baselines)]
                        if baseline['gaps']:
                            raise ValueError('UI source baseline requires revalidation: ' +
                                ','.join(row['source_id'] for row in baseline['gaps'][:8]))
                        for region in baseline['regions']:
                            if (not set(region['feature_ids']) <= set(item['feature_ids'])
                                    or not set(region['acceptance_ids']) <= set(item['acceptance_ids'])
                                    or not set(region['screenshot_ids']) <= set(item['depends_on'])):
                                raise ValueError('UI source baseline references outside prototype scope')
                        observation_ids = {ref['evidence_id'] for region in baseline['regions']
                                           for ref in region.get('observations', [])}
                        if observation_ids:
                            if observation_contract is None:
                                observation_contract = _ui_observation_contract()
                            image_digests = {row['id']: row['sha256'] for row in dependency_rows}
                            _verify_ui_observation_refs(material_fd, baseline['regions'],
                                observation_scope, observation_contract, image_digests)
                            observation_targets[target] = {
                                'regions': baseline['regions'],
                                'image_digests': {ident: image_digests[ident] for ident in observation_ids},
                                'context_ids': {ident: selected_contexts[ident] for ident in observation_ids},
                                'evidence': {ident: _ui_observation_evidence_state(screenshots[ident],
                                    selected_contexts[ident]) for ident in observation_ids}}
                        dependency_snapshot['ui_baseline_sha256'] = baseline['digest']
                    dependency_digest = hashlib.sha256(json.dumps(
                        dependency_snapshot, ensure_ascii=False, sort_keys=True, separators=(",", ":")
                    ).encode("utf-8")).hexdigest()
                    if version == 1 and dependency_digest != item["dependency_sha256"]:
                        raise ValueError(f"prototype dependency digest is stale (current {dependency_digest})")
                    pending_dependencies[target] = dependency_digest
                    if version >= 2:
                        pending_preparations[target] = {key: item[key] for key in
                            ('page_id', 'area_id', 'state_id', 'context_id', 'prototype_path')}
                        pending_preparations[target].update(
                            prototype_sha256=actual_digest, dependency_sha256=dependency_digest,
                            scope_digest=receipt_identity['scope_digest'],
                            evidence_contexts=[{'evidence_id': row['id'], 'contexts': row['contexts']}
                                               for row in dependency_rows])
                        if version == 3:
                            pending_preparations[target].update(mode=INTERACTIVE_MODE,
                                spec_sha256=spec_digest, interaction_status='PENDING')
                        if preview_out is not None:
                            pending_previews[target] = [{
                                'evidence_id': row['id'], 'image_sha256': row['sha256'],
                                'path': _expected_ui_evidence_path(screenshots[row['id']]),
                                'bytes': screenshots[row['id']]['validation']['bytes']}
                                for row in dependency_rows]
                        typed_targets[target] = {
                            'item': item, 'page_block': page_block,
                            'features': dependency_snapshot['features'],
                            'acceptance': dependency_snapshot['acceptance'],
                            'image_digests': {row['id']: row['sha256'] for row in dependency_rows},
                            'context_ids': selected_contexts,
                            'evidence': {ident: _ui_observation_evidence_state(screenshots[ident], ids)
                                         for ident, ids in selected_contexts.items()}}
                    if require_confirmation and version == 3:
                        profile, member = _interaction_confirmation_member(
                            repo_root, target, pending_preparations[target])
                        if _read_interactive_confirmation(req_dir, profile, member) is None:
                            raise ValueError('current interaction lacks a maintainer confirmation')
                    if require_confirmation and version < 3:
                        confirmation_rel = _prototype_confirmation_path(
                            page_id, area_id, actual_digest, dependency_digest, **receipt_identity)
                        reviews_fd = _open_dir_nofollow(req_dir / "reviews")
                        try:
                            confirmations_fd = _ui_fs.open_child_dir(
                                reviews_fd, "ui-prototype-confirmations")
                            try:
                                confirmation = json.loads(
                                    _read_beneath(confirmations_fd, confirmation_rel, 64 * 1024).decode("utf-8"),
                                    object_pairs_hook=_unique_json_object)
                            finally:
                                _ui_fs.close_dir(confirmations_fd)
                        finally:
                            _ui_fs.close_dir(reviews_fd)
                        identity_digest = _prototype_confirmation_digest(
                            page_id, area_id, actual_digest, dependency_digest, **receipt_identity)
                        confirmation_keys = {"schema_version", "decision", "page_id", "area_id",
                            "prototype_sha256", "dependency_sha256", "reviewer", "reviewed_at",
                            "confirmation_method", "confirmation_phrase"} | set(receipt_identity)
                        expected_phrase = f"ACCEPT {identity_digest[:12]}"
                        if version >= 2 and isinstance(confirmation, dict) and 'selection' in confirmation:
                            confirmation_keys.add('selection')
                            expected_phrase = _prototype_selection_phrase(
                                confirmation['selection'], pending_preparations[target])
                        if (not isinstance(confirmation, dict)
                                or set(confirmation) != confirmation_keys
                                or type(confirmation.get("schema_version")) is not int
                                or confirmation.get("schema_version") != version
                                or confirmation.get("decision") != "ACCEPTED"
                                or confirmation.get("page_id") != page_id
                                or confirmation.get("area_id") != area_id
                                or confirmation.get("prototype_sha256") != actual_digest
                                or confirmation.get("dependency_sha256") != dependency_digest
                                or (version == 1 and confirmation.get("reviewer") != item["reviewer"])
                                or (version == 1 and confirmation.get("reviewed_at") != item["reviewed_at"])
                                or any(confirmation.get(key) != value for key, value in receipt_identity.items())
                                or confirmation.get("confirmation_method") != "interactive_tty"
                                or confirmation.get("confirmation_phrase") != expected_phrase):
                            raise ValueError("prototype lacks matching interactive confirmation for current dependencies")
                        if version >= 2:
                            if (type(confirmation['reviewer']) is not str or not confirmation['reviewer'].strip()
                                    or len(confirmation['reviewer']) > 120
                                    or type(confirmation['reviewed_at']) is not str
                                    or datetime.fromisoformat(confirmation['reviewed_at'].replace('Z', '+00:00')).tzinfo is None):
                                raise ValueError('invalid current interactive reviewer or timestamp')
                except (OSError, UnicodeError, ValueError, KeyError, TypeError) as exc:
                    pending_dependencies.pop(target, None)
                    errors.append(f"{where}: {exc}")
            if observation_targets or typed_targets:
                # Finish all observation payload IO before the current image,
                # selected context, source and contract fences. Interpreted
                # text cannot reopen those already-checked source windows.
                for target, snapshot in observation_targets.items():
                    try:
                        _verify_ui_observation_refs(material_fd, snapshot['regions'],
                            observation_scope, observation_contract, snapshot['image_digests'])
                    except (OSError, UnicodeError, ValueError, KeyError, TypeError) as exc:
                        pending_dependencies.pop(target, None)
                        errors.append(f'UI observation changed: {target[0]}/{target[1]}: {exc}')
                if typed_targets:
                    # Receipts are external IO too. All v2 targets, including
                    # those without observations, need a current material fence.
                    current_text, current_mapped = _ui_stage_material(req_dir, dynamic_state)
                    if mapped_ui is not None and (current_mapped is None or current_mapped[0] != mapped_ui[0]):
                        raise ValueError('external UI manifest owner changed during check')
                    current_manifest = _prototype_manifest(current_text)
                    if current_manifest['schema_version'] != version:
                        raise ValueError('prototype manifest version changed during check')
                    current_items = {}
                    for current_item in current_manifest['prototypes']:
                        current_target = _prototype_target(current_item, version)
                        if current_target in current_items:
                            raise ValueError('duplicate current prototype identity')
                        current_items[current_target] = current_item
                    current_pages = _ui_page_blocks(current_text, current_mapped)
                    current_requirements = parse_a_items(_read_beneath(
                        root_fd, '需求分析.md', 10 * 1024 * 1024).decode('utf-8'))
                    _sources, current_features = _ui_outline_material(req_dir, root_fd, dynamic_state)
                    current_baselines = None
                    current_starts = re.findall(r'^```aek-ui-baseline\s*$', current_text, re.M)
                    current_blocks = re.findall(r'^```aek-ui-baseline\s*\n(.*?)\n```', current_text, re.M | re.S)
                    if (bool(current_starts) != (baselines is not None)
                            or (current_starts and (len(current_starts) != 1 or len(current_blocks) != 1))):
                        raise ValueError('UI source baseline declaration changed during check')
                    if baselines is not None:
                        if len(current_blocks) != 1 or len(current_blocks[0].encode('utf-8')) > MAX_BASELINE_BYTES:
                            raise ValueError('current UI source baseline is missing or ambiguous')
                        current_baselines = _read_ui_baseline(repo_root, json.loads(
                            current_blocks[0], object_pairs_hook=_unique_json_object))
                    for target, snapshot in typed_targets.items():
                        try:
                            if (current_items.get(target) != snapshot['item']
                                    or current_pages.get(target[0]) != snapshot['page_block']
                                    or any(current_features.get(ident) != value
                                           for ident, value in snapshot['features'].items())
                                    or any(current_requirements.get(ident, {}).get('text') != value
                                           for ident, value in snapshot['acceptance'].items())):
                                raise ValueError('prototype specification or design dependencies changed')
                            if current_baselines is not None:
                                current = current_baselines[_prototype_baseline_key(target, current_baselines)]
                                if (current is None or current['gaps']
                                        or current['digest'] != baselines[_prototype_baseline_key(target, baselines)]['digest']):
                                    raise ValueError('prototype source mapping changed')
                            item = snapshot['item']
                            if hashlib.sha256(_read_beneath(prototype_fd, item['prototype_path'],
                                    _PROTOTYPE_MAX_BYTES)).hexdigest() != item['prototype_sha256']:
                                raise ValueError('prototype HTML changed after receipt IO')
                            if version == 3:
                                spec_path, spec_digest = interaction_reference(item)
                                if hashlib.sha256(_read_beneath(prototype_fd, spec_path,
                                        MAX_INTERACTION_BYTES)).hexdigest() != spec_digest:
                                    raise ValueError('interaction specification changed after preparation')
                        except (OSError, UnicodeError, ValueError, KeyError, TypeError) as exc:
                            pending_dependencies.pop(target, None)
                            errors.append(f'UI prototype changed: {target[0]}/{target[1]}: {exc}')
                final_index = json.loads(_read_beneath(material_fd, '截图索引.json',
                    8 * 1024 * 1024).decode('utf-8'), object_pairs_hook=_unique_json_object)
                if (not isinstance(final_index, dict) or type(final_index.get('schema_version')) is not int
                        or final_index.get('schema_version') != 1
                        or final_index.get('change_id') != index['change_id']
                        or final_index.get('requirement_dir', final_index.get('change_id')) != (req_dir.name if package.layout == 'legacy' else package.title)
                        or not isinstance(final_index.get('screenshots'), list)):
                    raise ValueError('UI observation evidence scope changed during check')
                final_screenshots = {}
                for row in final_index['screenshots']:
                    if (not isinstance(row, dict) or not isinstance(row.get('id'), str)
                            or row['id'] in final_screenshots):
                        raise ValueError('duplicate current UI evidence identity')
                    final_screenshots[row['id']] = row
                for target, snapshot in {**observation_targets, **typed_targets}.items():
                    try:
                        if final_index.get('design_system') != design_system:
                            raise ValueError('observation design system changed during check')
                        for ident, old_state in snapshot['evidence'].items():
                            current = final_screenshots[ident]
                            if _ui_observation_evidence_state(current, snapshot['context_ids'][ident]) != old_state:
                                raise ValueError('observation screenshot context changed during check')
                            digest, _ = _hash_regular_beneath(material_fd,
                                _expected_ui_evidence_path(current), _SCREENSHOT_MAX_BYTES)
                            if digest != current['validation']['content_sha256']:
                                raise ValueError('observation screenshot changed during check')
                    except (OSError, UnicodeError, ValueError, KeyError, TypeError) as exc:
                        pending_dependencies.pop(target, None)
                        errors.append(f'UI observation changed: {target[0]}/{target[1]}: {exc}')
                # Reading an observation is another external IO boundary. A
                # contract captured before those reads cannot authorize their
                # publication if the managed prompt changed during them.
                if observation_targets:
                    try:
                        contract_still_current = _ui_observation_contract() == observation_contract
                    except (OSError, ValueError):
                        contract_still_current = False
                    if not contract_still_current:
                        for target in observation_targets:
                            pending_dependencies.pop(target, None)
                        errors.append('UI observation contract changed during final payload verification')
            if baselines is not None:
                final_baselines = _read_ui_baseline(repo_root, baseline_manifest)
                for target, baseline in baselines.items():
                    if selected_targets is not None and not any(
                            _prototype_baseline_key(selected, baselines) == target for selected in selected_targets):
                        continue
                    final = final_baselines.get(target)
                    if final is None or final['gaps'] or final['digest'] != baseline['digest']:
                        for consumer in tuple(pending_dependencies):
                            if consumer == target or (len(target) == 2 and consumer[:2] == target):
                                pending_dependencies.pop(consumer, None)
                        errors.append(f'UI source baseline changed during check: {target[0]}/{target[1]}')
            if observation_targets:
                try:
                    with _UiObservationStore(material_fd, create=False) as store:
                        binding_index, _ = store.binding_snapshot(observation_scope)
                    current_bindings = {row['evidence_id']: row for row in binding_index['bindings']}
                except (OSError, ValueError):
                    current_bindings = {}
                contract_sha = hashlib.sha256(json.dumps(observation_contract,
                    ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode('utf-8')).hexdigest()
                for target, snapshot in observation_targets.items():
                    for region in snapshot['regions']:
                        for ref in region.get('observations', []):
                            expected = {'evidence_id': ref['evidence_id'],
                                'image_sha256': snapshot['image_digests'][ref['evidence_id']],
                                'contract_sha256': contract_sha, 'observation_sha256': ref['sha256']}
                            if current_bindings.get(ref['evidence_id']) != expected:
                                pending_dependencies.pop(target, None)
                                errors.append(f'UI observation binding changed: {target[0]}/{target[1]}')
            # Nothing is offered for confirmation until all source reads in
            # this check have finished. The source files remain user-owned.
            if _package_locations(req_dir) != (repo_root, package):
                pending_dependencies.clear()
                errors.append('registered package identity changed during prototype verification')
            if coverage is not None:
                final_coverage = _current_ui_coverage(c, req_dir, dynamic_state, required)
                if final_coverage != coverage:
                    pending_dependencies.clear()
                    errors.append('UI classification upstream changed after prototype/receipt IO')
            if dependency_out is not None:
                dependency_out.update(pending_dependencies)
            if preparation_out is not None:
                preparation_out.update({target: value for target, value in pending_preparations.items()
                                        if target in pending_dependencies})
            if preview_out is not None:
                preview_out.update({target: value for target, value in pending_previews.items()
                                    if target in pending_dependencies})
            c.add("prototype", "原型确认与依赖摘要有效", not errors,
                  "；".join(errors[:5]))
        finally:
            if material_fd is not None:
                _ui_fs.close_dir(material_fd)
            if prototype_fd is not root_fd:
                _ui_fs.close_dir(prototype_fd)
            _ui_fs.close_dir(root_fd)
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError, KeyError, TypeError, RecursionError) as exc:
        c.add("prototype", "原型确认与依赖摘要有效", False, str(exc))


def _unique_json_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def _effective_stage_spec(stage: str, dynamic_state=None) -> dict:
    spec = STAGES[stage]
    if dynamic_state is None or dynamic_state.plan is None:
        return spec
    documents = list(participating_documents(dynamic_state.plan, stage))
    return {
        "docs": documents,
        "upstream": list(participating_prerequisites(dynamic_state.plan, stage)),
        "review": spec["review"],
        "sections": {doc: spec["sections"][doc] for doc in documents},
    }


def _mapped_stage_roles(dynamic_state, stage):
    plan = dynamic_state.plan if dynamic_state is not None else None
    if not isinstance(plan, ComposedArtifactPlan):
        return ()
    group = ARTIFACT_REGISTRY.get_group(stage)
    return tuple(artifact for artifact in load_source_map(plan.source_map).artifacts
                 if artifact['artifact_id'] in group.artifact_ids)


def _stage_source_names(plan, stage):
    return tuple(dict.fromkeys(name for artifact in ARTIFACT_REGISTRY.get_group(stage).artifact_ids
                              if plan.by_id(artifact).classification != 'skipped'
                              for name in artifact_sources(plan, artifact)))


def _stage_documents(stage, dynamic_state):
    if dynamic_state is not None and dynamic_state.plan is not None:
        return _stage_source_names(dynamic_state.plan, stage)
    return STAGES[stage]['docs']


def _read_stage_materials(req_dir, stage, dynamic_state, mapped=None):
    if mapped is None:
        mapped = _capture_mapped_stage(req_dir, stage, dynamic_state)
    documents = _stage_documents(stage, dynamic_state)
    if mapped is None:
        return _capture_stage_materials(req_dir, documents)
    external = mapped[1].sources()
    native = _capture_stage_materials(req_dir, [name for name in documents if name not in external])
    combined = {**external, **native}
    if len(combined) > 16 or sum(map(len, combined.values())) > 16 * 1024 * 1024:
        raise ValueError('UNTRUSTED_MAPPING: combined stage source set exceeds its limits')
    return combined


def _upstream_stages(stage, dynamic_state):
    stages = list(_effective_stage_spec(stage, dynamic_state)['upstream'])
    for current in stages:
        for parent in _effective_stage_spec(current, dynamic_state)['upstream']:
            if parent not in stages:
                stages.append(parent)
    return stages


def _capture_upstream_materials(req_dir, stage, state):
    if state is None or state.state != 'FROZEN':
        return None
    return {parent: _read_stage_materials(req_dir, parent, state)
            for parent in _upstream_stages(stage, state)}


def _require_approved_upstream(req_dir, state, materials):
    if materials is None:
        return
    bindings = {binding.stage: binding for binding in state.bindings}
    for stage, sources in materials.items():
        binding = bindings.get(stage)
        if binding is None:
            raise ValueError(f'SOURCE_CHANGED: {stage} has no approval binding')
        expected = (binding.material_revision['raw_after']
                    if isinstance(binding, MaterialStageBinding) else dict(binding.doc_hashes))
        actual = {name: hashlib.sha256(raw).hexdigest() for name, raw in sources.items()}
        if actual != expected or _read_stage_materials(req_dir, stage, state) != sources:
            raise ValueError(f'SOURCE_CHANGED: {stage} differs from the approved upstream snapshot')
        if stage == 'UI设计' and stage_frozen(req_dir, stage, state)[0] != 'FROZEN':
            raise ValueError('SOURCE_CHANGED: upstream UI prototype confirmation is no longer current')


def _feature_items(req_dir, state, overview=None):
    roles = _mapped_stage_roles(state, '概要设计')
    if not roles:
        return parse_f_items(overview if overview is not None else (_read(req_dir / '概要设计.md') or ''))
    _capture_mapped_stage(req_dir, '概要设计', state)
    return {point['id']: {'covers': point['covers']} for point in roles[0]['points']}


def _capture_mapped_stage(req_dir, stage, dynamic_state):
    roles = _mapped_stage_roles(dynamic_state, stage)
    if not roles:
        return None
    if stage not in {'概要设计', '业务流程设计', 'UI设计', '详细设计'}:
        raise ValueError('当前阶段尚无外部来源校验入口')
    root, package = _package_locations(req_dir)
    mapping = load_source_map(dynamic_state.plan.source_map)
    if package.package_ref != mapping.package_ref:
        raise ValueError('ROOT_MISMATCH: source mapping belongs to another package')
    upstream_text = _read(req_dir / '需求分析.md') or ''
    captured = capture_mapped_sources(root, mapping, tuple(role['artifact_id'] for role in roles),
                                      external_ids=tuple(sorted(parse_a_items(upstream_text))))
    if captured.package_revision != package.revision:
        raise ValueError('SOURCE_CHANGED: package changed during mapped source capture')
    return mapping, captured


def _ui_stage_material(req_dir, state, mapped=None):
    if mapped is None:
        mapped = _capture_mapped_stage(req_dir, 'UI设计', state)
    if mapped is None:
        root = _open_dir_nofollow(req_dir)
        try:
            return _read_beneath(root, 'UI设计.md', 10 * 1024 * 1024).decode('utf-8'), None
        finally:
            _ui_fs.close_dir(root)
    frame = mapped[1]
    documents = {name: raw.decode('utf-8') for name, raw in frame.sources().items()}
    owner = _mapped_section(frame, 'ui-design', '页面清单').path
    if any(_PROTOTYPE_BLOCK.search(text) for name, text in documents.items() if name != owner):
        raise ValueError('UI prototype manifest must belong to the mapped page-list document')
    return documents[owner], (owner, frame)


def _mapped_section(frame, role, section):
    location, = (item for item in frame.locations if item.artifact_id == role
                 and item.category == 'sections' and item.label == section)
    return location


def _ui_page_blocks(text, mapped):
    if mapped is None:
        return {match.group(1): _block(text, match.start())
                for match in re.finditer(r'^###\s*(PAGE-\d+)：', text, re.M)}
    _owner, frame = mapped
    sources = frame.sources()
    return {location.label: sources[location.path][location.start:location.end].decode('utf-8')
            for location in frame.locations
            if location.artifact_id == 'ui-design' and location.category == 'points'}


def run_checks(req_dir: Path, stage: str, dynamic_state=None, *,
               source_materials: dict[str, bytes] | None = None, mapped_stage=None,
               upstream_materials=None) -> Checks:
    """对一个阶段跑全部硬校验（含上游冻结与需求意图检查）。"""
    c = Checks(stage)
    spec = _effective_stage_spec(stage, dynamic_state)
    mapped_roles = {ARTIFACT_REGISTRY.get_artifact(role['artifact_id']).filename: role
                    for role in _mapped_stage_roles(dynamic_state, stage)} if mapped_stage is not None else {}

    def read_document(document: str) -> str | None:
        # Publication callers capture once: checks, signoff and hashes must
        # describe that same material, even if disk changes A -> B -> A.
        # A missing captured document must not silently reappear from disk.
        if source_materials is not None and document in spec["docs"]:
            raw = source_materials.get(document)
        elif upstream_materials is not None:
            raw = next((sources[document] for sources in upstream_materials.values()
                        if document in sources), None)
        else:
            return _read(req_dir / document)
        if raw is None:
            return None
        try:
            return raw.decode("utf-8", errors="strict")
        except UnicodeDecodeError:
            return None

    if dynamic_state is not None and not spec["docs"]:
        if stage == 'UI设计':
            scope = _current_ui_coverage(c, req_dir, dynamic_state, False)
            if scope is None or not scope.complete:
                return c
            if scope.required:
                c.add('prototype', '上游 UI 义务与跳过计划一致', False,
                      'UI classification requires prototypes but ArtifactPlan skips UI')
                return c
        c.add("plan", "阶段由 ArtifactPlan 跳过", True,
              "无需生成、评审或冻结本阶段产物")
        return c

    # ── 上游冻结 ──
    for up in _upstream_stages(stage, dynamic_state):
        st, why = stage_frozen(req_dir, up, dynamic_state)
        c.add("upstream", f"上游已冻结：{up}", st == "FROZEN", why)

    # ── 需求意图（薄输入拒绝——任何阶段都校验最上游，需求分析阶段本身也检查）──
    req_text = read_document("需求分析.md")
    if req_text is not None:
        scen = parse_scenarios(req_text)
        ok_scen = bool(scen) and all(
            s["前置"] and s["操作"] and s["结果"]
            and not _placeholders(s["前置"] + s["操作"] + s["结果"])
            for s in scen.values())
        c.add("intent", "需求场景完整（前置/操作/结果 已填）", ok_scen,
              "场景为空或 Given/When/Then 未填写/仍为占位符" if not ok_scen else "")
        a_items = parse_a_items(req_text)
        ok_a = bool(a_items) and all(not _placeholders(v["text"]) for v in a_items.values())
        c.add("intent", "验收项非占位", ok_a,
              "验收项为空或仍为占位符" if not ok_a else "")

    def design_items(documents):
        roles = {ARTIFACT_REGISTRY.get_artifact(role['artifact_id']).filename: role
                 for role in _mapped_stage_roles(dynamic_state, '详细设计')}
        if roles and stage != '详细设计':
            _capture_mapped_stage(req_dir, '详细设计', dynamic_state)
        combined = {}
        for name in documents:
            if name in roles:
                items = {}
                for point in roles[name]['points']:
                    refs = sorted(set(point['covers']) | set(point['uses']))
                    items[point['id']] = {'f': [ref for ref in point['covers'] if ref.startswith('F')],
                                          'uses_f': [ref for ref in point['uses'] if ref.startswith('F')],
                                          'a': [ref for ref in refs if ref.startswith('A')]}
            else:
                items = parse_d_items(read_document(name) or '')
            if roles and combined.keys() & items.keys():
                raise ValueError('WRITER_CONFLICT: mapped and native design points have duplicate IDs')
            combined.update(items)
        return combined

    # ── 本阶段文档 ──
    if mapped_roles:
        for name, raw in mapped_stage[1].sources().items():
            _check_placeholders(c, name, raw.decode('utf-8', errors='strict'))
    for doc in spec["docs"]:
        if doc in mapped_roles:
            artifact = mapped_roles[doc]
            frame = mapped_stage[1]
            required = set(spec['sections'][doc])
            selected = {location.label for location in frame.locations
                        if location.artifact_id == artifact['artifact_id'] and location.category == 'sections'}
            c.add('structure', f'外部来源必填章节：{doc}', required == selected,
                  '缺失：' + '、'.join(sorted(required - selected)) if required != selected else '')
            continue
        text = read_document(doc)
        if text is None:
            c.add("structure", f"文档存在：{doc}", False, "文件不存在")
            continue
        _check_structure(c, doc, text, spec["sections"][doc])
        _check_placeholders(c, doc, text)

    if stage == "业务流程设计":
        if mapped_stage is None:
            _check_business_process_diagram(c, req_dir, read_document("业务流程设计.md") or "")
        else:
            frame = mapped_stage[1]
            owner = _mapped_section(frame, 'business-flow', '业务流程总览').path
            _check_business_process_diagram(c, _package_locations(req_dir)[0] / Path(owner).parent,
                                            frame.sources()[owner].decode('utf-8'))
            points = mapped_roles['业务流程设计.md']['points']
            features = set(_feature_items(req_dir, dynamic_state, read_document('概要设计.md') or ''))
            known = features | set(parse_a_items(req_text or ''))
            c.add('trace', '外部业务流程覆盖当前功能点且引用有效',
                  features == {point['id'] for point in points}
                  and all(set(point['covers'] + point['uses']) <= known for point in points))

    # ── 各阶段追踪链 ──
    req_a = parse_a_items(req_text) if req_text else {}

    if stage == "概要设计":
        if '概要设计.md' in mapped_roles:
            f_items = {point['id']: {'covers': point['covers']} for point in mapped_roles['概要设计.md']['points']}
        else:
            f_items = parse_f_items(read_document("概要设计.md") or "")
        covered = [a for f in f_items.values() for a in f["covers"]]
        dangling = [a for f in f_items.values() for a in f["covers"] if a not in req_a]
        c.add("trace", "每个验收项被 ≥1 功能点覆盖",
              bool(f_items) and set(req_a) <= set(covered),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered))) or '无')}")
        c.add("id", "功能点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "UI设计":
        if mapped_stage is None:
            text, mapped_ui = read_document("UI设计.md") or "", None
            pages = parse_page_items(text)
        else:
            text, mapped_ui = _ui_stage_material(req_dir, dynamic_state, mapped_stage)
            blocks = _ui_page_blocks(text, mapped_ui)
            pages = {point['id']: {'refs': point['covers'] + point['uses'],
                'states_ok': '不适用' in blocks[point['id']] or all(s in blocks[point['id']] for s in UI_STATES)}
                for point in mapped_roles['UI设计.md']['points']}
        _check_ui_prototypes(c, req_dir, text, dynamic_state=dynamic_state, mapped_ui=mapped_ui)
        c.add("id", "页面清单非空", bool(pages), "无 PAGE 项")
        bad_states = [p for p, v in pages.items() if not v["states_ok"]]
        c.add("ui", "每页状态枚举完整（或 N/A）",
              not bad_states, f"缺状态: {'、'.join(bad_states)}" if bad_states else "")
        f_all = _feature_items(req_dir, dynamic_state, read_document("概要设计.md") or "")
        dangling = [r for v in pages.values() for r in v["refs"]
                    if r not in f_all and r not in req_a]
        c.add("id", "页面引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "详细设计":
        d_items = design_items(spec['docs'])
        f_all = _feature_items(req_dir, dynamic_state, read_document("概要设计.md") or "")
        covered_f = [f for v in d_items.values() for f in v["f"]]
        c.add("trace", "每个功能点有 ≥1 设计落点",
              bool(d_items) and set(f_all) <= set(covered_f),
              f"未落点: {('、'.join(sorted(set(f_all) - set(covered_f))) or '无')}")
        dangling = [r for v in d_items.values() for r in v['f'] + v.get('uses_f', []) + v['a']
                    if (r.startswith("F") and r not in f_all)
                    or (r.startswith("A") and r not in req_a)]
        c.add("id", "落点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "计划":
        task_text = read_document("任务清单.md") or ""
        test_text = read_document("测试方案.md") or ""
        t_items = parse_t_items(task_text)
        tc_items = parse_tc_items(test_text)
        d_all = design_items(_effective_stage_spec('详细设计', dynamic_state)['docs'])

        covered_a = [a for v in tc_items.values() for a in v["accepts"]]
        c.add("trace", "任务清单至少包含一个任务", bool(t_items), "无 T-ID")
        c.add("trace", "每个验收项有 ≥1 测试用例",
              bool(tc_items) and set(req_a) <= set(covered_a),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered_a))) or '无')}")
        bad_tc = [tc for tc, v in tc_items.items() if not v["accepts"]]
        c.add("id", "用例挂接验收项", not bad_tc,
              f"未挂接: {'、'.join(bad_tc)}" if bad_tc else "")
        bad_t = [t for t, v in t_items.items()
                 if not v["designs"] or not v["has_verify"] or not v["has_scope"]]
        c.add("trace", "每任务绑定设计+验证方式+预计范围", not bad_t,
              f"缺项: {'、'.join(bad_t)}" if bad_t else "")
        dangling = [r for v in t_items.values() for r in v["designs"]
                    if (r.startswith("TC") and r not in tc_items)
                    or (r.startswith("D") and r not in d_all)]
        c.add("id", "任务引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    return c


