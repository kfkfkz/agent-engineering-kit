def _validate_issues(req_dir: Path, stage: str, spec: dict,
                     text: str, dynamic_state=None,
                     material_parser: ReviewMaterialParser | None = None, *,
                     source_materials: dict[str, bytes] | None = None,
                     review_inputs=None, mapped_review=None, upstream_materials=None) -> tuple[list[dict] | None, str]:
    """Compatibility adapter: hash files here, validate immutable input in core."""
    if source_materials is None:
        source_materials = _capture_stage_materials(req_dir, spec["docs"])
    expected = {doc: (hashlib.sha256(source_materials[doc]).hexdigest()
                     if doc in source_materials else None) for doc in spec["docs"]}
    reviews = req_dir / "reviews"
    request_raw = _review_input_bytes(req_dir, stage, "review-request.json",
                                      review_inputs, required=False)
    if request_raw is not None:
        try:
            request = load_versioned_review_request(request_raw)
            if request.stage != stage or dict(request.doc_hashes) != expected:
                return None, "review request 与当前阶段文档不一致，需重新生成评审输入"
            current = load_review_snapshot(_review_input_bytes(
                req_dir, stage, "review-current.json", review_inputs))
            documents = {doc: (source_materials[doc].decode("utf-8", errors="strict")
                               if doc in source_materials else None) for doc in spec["docs"]}
            if any(value is None for value in documents.values()):
                return None, "review snapshot 当前来源不完整"
            if mapped_review is not None:
                expected_request, material = mapped_review
                if request != expected_request:
                    return None, '外部来源的完整评审输入已过期'
                actual_context = dict(expected_request.supporting_context)
            else:
                material, actual_context, _providers = _prepare_review_material(req_dir, stage, dynamic_state,
                    documents, material_parser or ReviewMaterialParser(), request.schema_version, upstream_materials)
            dependency = material.snapshot.dependency_fingerprint
            if (current.stage != stage or current.doc_hashes != request.doc_hashes
                    or current.dependency_fingerprint != dependency
                    or any(value is None for value in documents.values())):
                return None, "review snapshot 已过期，需重新生成评审输入"
            if (material.snapshot != current
                    or (request.mode != "incremental" and dict(request.supporting_context) != actual_context)):
                return None, "当前 Markdown 章节快照已变化，需重新生成评审输入"
            if request.mode == "incremental":
                expected_request, _expected_material = _build_review_request(
                    req_dir, stage, dynamic_state, schema_version=request.schema_version,
                    material_parser=material_parser, source_materials=source_materials,
                    review_inputs=review_inputs, upstream_materials=upstream_materials)
                if request != expected_request:
                    return None, "增量依赖闭包无法从当前证明重算，需全文重新评审"
            elif isinstance(request, ReviewRequestV2):
                full = full_review_request_v2(current, documents=material.document_map(),
                    section_texts=material.section_map(), supporting_context=dict(request.supporting_context))
                if (request.full_documents != full.full_documents
                        or request.selected_sections != full.selected_sections
                        or request.scope_proof["current_snapshot_digest"] != full.scope_proof["current_snapshot_digest"]
                        or request.scope_proof["boundary_evidence_digest"] != full.scope_proof["boundary_evidence_digest"]):
                    return None, "全文范围/正文无法从当前来源重算"
            try:
                receipt_text = _review_input_bytes(
                    req_dir, stage, "review-receipt.json", review_inputs).decode("utf-8")
            except (FileNotFoundError, UnicodeDecodeError):
                return None, "缺少 reviewer receipt，不能证明实际送审输入"
            known = None
            if isinstance(request, ReviewRequestV2):
                bindings, _external, _lifecycle = _v2_review_bindings(
                    req_dir, stage, material, dynamic_state, use_locations=False,
                    include_closed=True,
                    material_parser=material_parser)
                known = {row["fingerprint"]: tuple(tuple(key) for key in row["section_keys"])
                         if row["section_keys"] is not None else None for row in bindings}
            checked = validate_review_result(request, text, receipt_text,
                current_snapshot=current if isinstance(request, ReviewRequestV2) else None,
                known_issue_sections=known)
            if checked.state != "VALID" or checked.result is None:
                return None, ("增量评审证明失效，需重新生成全文评审输入"
                              if checked.state == "FULL_REQUIRED" else checked.reason)
            baseline_path = reviews / f"{stage}.review-baseline.json"
            if isinstance(request, ReviewRequestV2):
                # A v2 material cache is published only after Lifecycle/Gate commit.
                pass
            elif request.mode == "full" and not checked.result.issues:
                _atomic_review_write(baseline_path, review_snapshot_bytes(current))
            elif checked.result.issues:
                _atomic_review_unlink(baseline_path)
            return list(checked.result.issues), ""
        except (OSError, TypeError, ValueError) as exc:
            return None, f"review proof 无效: {exc}"
    if mapped_review is not None:
        return None, '外部来源缺少当前完整评审请求'
    result, error = validate_review_payload(text, stage, expected)
    return (list(result.issues) if result is not None else None), error


def _publish_full_v2_material_baseline(req_dir: Path, stage: str, gate: dict,
                                       dynamic_state=None,
                                       material_parser: ReviewMaterialParser | None = None, *,
                                       review_inputs=None) -> None:
    """Cache accepted full material after commit, never cache an approval."""
    reviews = req_dir / "reviews"
    request_raw = _review_input_bytes(req_dir, stage, "review-request.json",
                                      review_inputs, required=False)
    if request_raw is None:
        return
    request = load_versioned_review_request(request_raw)
    if not isinstance(request, ReviewRequestV2) or request.mode != "full":
        return
    current = load_review_snapshot(_review_input_bytes(
        req_dir, stage, "review-current.json", review_inputs))
    if (request.stage != stage or dict(request.doc_hashes) != gate["doc_hashes"]
            or current.doc_hashes != request.doc_hashes
            or current.dependency_fingerprint != request.dependency_fingerprint):
        raise ValueError("accepted v2 material changed before baseline publication")
    receipt = _review_input_bytes(req_dir, stage, "review-receipt.json", review_inputs)
    sensor = _review_input_bytes(req_dir, stage, "issues.json", review_inputs)
    material = (material_parser or ReviewMaterialParser()).parse(
        stage, dict(request.full_documents), request.dependency_fingerprint)
    # PASS publication closes verified issues before this cache is written.
    # Keep their fingerprints available to validate the already-reviewed
    # locator receipt; closed issues remain excluded from future review scope.
    bindings, _external, _lifecycle = _v2_review_bindings(
        req_dir, stage, material, dynamic_state, use_locations=False,
        include_closed=True, material_parser=material_parser)
    known = {row["fingerprint"]: tuple(tuple(key) for key in row["section_keys"])
             if row["section_keys"] is not None else None for row in bindings}
    checked = validate_review_result(request, sensor.decode("utf-8"), receipt.decode("utf-8"),
                                     current_snapshot=current, known_issue_sections=known)
    if checked.state != "VALID":
        raise ValueError("v2 material has no accepted full observation")
    baseline = {
        "schema_version": 2,
        "snapshot": json.loads(review_snapshot_bytes(current)),
        "accepted_full_request_digest": request.request_digest,
        "accepted_receipt_digest": hashlib.sha256(receipt).hexdigest(),
        "accepted_sensor_digest": hashlib.sha256(sensor).hexdigest(),
        "dependency_fingerprint": request.dependency_fingerprint,
        "boundary_evidence_digest": request.scope_proof["boundary_evidence_digest"],
    }
    _atomic_review_write(reviews / f"{stage}.review-baseline.json",
                         json.dumps(baseline, ensure_ascii=False, sort_keys=True,
                                    separators=(",", ":")).encode("utf-8"))


def _review_observation_digest(req_dir: Path, stage: str, issues_text: str, *,
                               review_inputs=None) -> str:
    """Bind a lifecycle occurrence to both sent input and returned sensor bytes."""
    request_digest = "legacy"
    request_raw = _review_input_bytes(req_dir, stage, "review-request.json",
                                      review_inputs, required=False)
    if request_raw is not None:
        request_digest = load_versioned_review_request(request_raw).request_digest
    payload = {"request_digest": request_digest, "issues_sha256": hashlib.sha256(
        issues_text.encode("utf-8")).hexdigest()}
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _review_subject_digest(
    stage: str, doc_hashes: dict[str, str], dependency_fingerprint: str,
) -> str:
    payload = {"stage": stage, "doc_hashes": doc_hashes,
               "dependency_fingerprint": dependency_fingerprint}
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _atomic_review_write(path: Path, content: bytes) -> None:
    """Publish non-authoritative review evidence without torn files."""
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                 | getattr(os, "O_BINARY", 0), 0o600)
    try:
        remaining = content
        while remaining:
            written = os.write(fd, remaining)
            if written <= 0:
                raise OSError("short review evidence write")
            remaining = remaining[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(temporary, path)
        if os.name != "nt":
            directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
    finally:
        if temporary.exists():
            temporary.unlink()


def _read_review_bytes(path: Path) -> bytes:
    """Read one bounded regular evidence file without following replacements."""
    if path.is_symlink():
        raise ValueError(f"review evidence is a symlink: {path.name}")
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        opened = os.fstat(fd)
        if not stat.S_ISREG(opened.st_mode) or opened.st_size > 2_000_000:
            raise ValueError(f"review evidence is not a bounded regular file: {path.name}")
        current = os.stat(path, follow_symlinks=False)
        if (not stat.S_ISREG(current.st_mode)
                or (current.st_dev, current.st_ino) != (opened.st_dev, opened.st_ino)):
            raise ValueError(f"review evidence changed while opening: {path.name}")
        chunks: list[bytes] = []
        remaining = opened.st_size
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                raise ValueError(f"review evidence changed while reading: {path.name}")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.fstat(fd).st_size != opened.st_size:
            raise ValueError(f"review evidence changed while reading: {path.name}")
        return b"".join(chunks)
    finally:
        os.close(fd)


def _atomic_review_unlink(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        return


def _review_dependency_fingerprint(req_dir: Path, stage: str,
                                   dynamic_state=None, schema_version: int = 1, *, consumption=None,
                                   supporting_context=None) -> str:
    root = _repo_root(req_dir)
    policy = _load_policy(root)
    reviews = req_dir / "reviews"
    scoped = schema_version == 2 and consumption is not None and consumption["status"] == "SCOPED"
    hard_checks = "current-delivered-checks-v1" if scoped else _sha256(reviews / "hard-checks.json")
    dynamic = {}
    for name in ("artifact-plan.json", "artifact-plan.gate.json"):
        path = reviews / name
        if path.is_file() and not path.is_symlink():
            dynamic[name] = _sha256(path)
    payload = {
        "schema_version": 1,
        "stage": stage,
        "registry_version": ARTIFACT_REGISTRY.schema_version,
        "stage_spec": _effective_stage_spec(stage, dynamic_state),
        "policy": policy,
        "hard_checks": hard_checks,
        "upstream": {"declared_consumption": consumption["content_digest"]} if scoped else {up: _stage_fingerprint(req_dir, up, dynamic_state)
                     for up in _effective_stage_spec(
                         stage, dynamic_state)["upstream"]},
        "dynamic": dynamic,
        "rubric": "design-pipeline-review-v1",
    }
    security = _review_security_context(req_dir, stage)
    if security is not None:
        payload["security_material_digest"] = hashlib.sha256(security.encode("utf-8")).hexdigest()
    if schema_version == 2:
        payload["schema_version"] = 2
        payload["rubric"] = "design-pipeline-review-v2"
        if scoped:
            # Selection facts replace only the broad dependency key. The
            # original request still binds every actual sent byte and receipt.
            payload["hard_checks"] = "current-delivered-checks-v1"
            payload["upstream"] = {"declared_consumption": consumption["content_digest"]}
            payload["upstream_credentials"] = {}
            payload["actual_context_hashes"] = {name: hashlib.sha256(text.encode("utf-8")).hexdigest()
                for name, text in supporting_context.items()
                if not name.startswith(("consumed/upstream/", "upstream/")) and name != "reviews/hard-checks.json"}
        else:
            payload["actual_context_hashes"] = {
                name: hashlib.sha256(text.encode("utf-8")).hexdigest()
                for name, text in (supporting_context if supporting_context is not None else
                                   _review_supporting_context(req_dir, stage, dynamic_state)).items()}
            payload["upstream_credentials"] = {
                f"{up}.{suffix}": hashlib.sha256(_read_review_bytes(
                    reviews / f"{up}.{suffix}")).hexdigest()
                for up in _effective_stage_spec(stage, dynamic_state)["upstream"]
                for suffix in ("gate.json", "plan-binding.json")
                if (reviews / f"{up}.{suffix}").exists()}
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _v2_review_bindings(req_dir, stage, material, dynamic_state=None, *,
                        use_locations=True, include_closed=False,
                        lifecycle_snapshot=None,
                        material_parser: ReviewMaterialParser | None = None,
                        review_inputs=None):
    """Resolve all pending occurrences; explicit source conflicts stay unknown."""
    spec = _effective_stage_spec(stage, dynamic_state)
    external_ids = set()
    upstreams = list(spec["upstream"])
    def collect_upstreams(target):
        for parent in _effective_stage_spec(target, dynamic_state)["upstream"]:
            if parent not in upstreams:
                upstreams.append(parent)
                collect_upstreams(parent)
    for upstream in tuple(upstreams):
        collect_upstreams(upstream)
    for upstream in upstreams:
        state, why = stage_frozen(req_dir, upstream, dynamic_state)
        if state != "FROZEN":
            raise ValueError(f"v2 upstream is not frozen: {upstream}: {why}")
        docs = {doc: raw.decode('utf-8') for doc, raw in _read_stage_materials(req_dir, upstream, dynamic_state).items()}
        if set(docs) != set(_stage_documents(upstream, dynamic_state)):
            raise ValueError('v2 upstream source files are missing')
        mapped = _mapped_stage_roles(dynamic_state, upstream)
        if mapped:
            external_ids.update(point['id'] for artifact in mapped for point in artifact['points'])
            continue
        upstream_material = (material_parser or ReviewMaterialParser()).parse(
            upstream, docs, material.snapshot.dependency_fingerprint)
        if not upstream_material.snapshot.parse_complete or upstream_material.snapshot.unknown_edges:
            raise ValueError("v2 upstream source definitions are not complete")
        external_ids.update(item for section in upstream_material.snapshot.sections for item in section.defines_ids)
    providers = {item: section.key for section in material.snapshot.sections for item in section.defines_ids}
    lifecycle = lifecycle_snapshot or LifecycleGateStore(req_dir / "reviews", stage).recover()
    bindings = []
    if lifecycle is not None:
        for item in lifecycle.issues:
            if item.state == IssueState.CLOSED and not include_closed:
                continue
            occurrence = item.occurrences[-1]
            tokens = set(re.findall(r"(?<![A-Za-z0-9_])(?:A|F|D|T|TC-)[1-9][0-9]*(?![A-Za-z0-9_])",
                                   occurrence.location)) | set(occurrence.affected_ids)
            keys = sorted({providers[token] for token in tokens if token in providers})
            named_docs = set(re.findall(r"([^\s/\\:：]+\.md)", occurrence.location))
            explicit = [section.key for section in material.snapshot.sections
                        if section.heading in occurrence.location and " / " in section.heading]
            # A named non-owner/global leaf takes precedence over ID hints.
            leaf_names = {section.heading.rsplit(" / ", 1)[-1]: section for section in material.snapshot.sections}
            named_global = any(name in occurrence.location and not section.defines_ids
                               for name, section in leaf_names.items()
                               if name not in {"<preamble>", "<whole-document>"} and len(name) > 1
                               and name not in {stage, "功能点设计", "业务逻辑", "接口详细设计"})
            if ("UNSCOPED" in occurrence.location or not keys or named_global
                    or tokens - providers.keys() - external_ids
                    or named_docs - set(material.document_map())
                    or (named_docs and any(doc not in named_docs for doc, _ in keys))
                    or (explicit and not set(explicit).issubset(keys))):
                keys = None
            bindings.append({"fingerprint": item.fingerprint, "state": item.state.value,
                             "section_keys": [list(key) for key in keys] if keys else None})
    if use_locations and bindings:
        try:
            baseline = json.loads(_review_input_bytes(req_dir, stage, "review-baseline.json", review_inputs))
            receipt = _review_input_bytes(req_dir, stage, "review-receipt.json", review_inputs)
            saved = load_versioned_review_request(_review_input_bytes(req_dir, stage, "review-request.json", review_inputs))
            sensor = _review_input_bytes(req_dir, stage, "issues.json", review_inputs)
            if (isinstance(saved, ReviewRequestV2) and baseline.get("schema_version") == 2
                    and baseline["accepted_full_request_digest"] == saved.request_digest
                    and baseline["accepted_receipt_digest"] == hashlib.sha256(receipt).hexdigest()
                    and baseline["accepted_sensor_digest"] == hashlib.sha256(sensor).hexdigest()):
                known = {row["fingerprint"]: tuple(tuple(key) for key in row["section_keys"])
                         if row["section_keys"] is not None else None for row in bindings}
                located = review_issue_locations(saved, receipt.decode("utf-8"), material.snapshot, known)
                for row in bindings:
                    if row["fingerprint"] in located:
                        row["section_keys"] = [list(key) for key in located[row["fingerprint"]]]
        except (OSError, KeyError, TypeError, ValueError):
            # Old, changed or unaccepted locators cannot shrink the next input.
            pass
    return tuple(bindings), tuple(sorted(external_ids)), lifecycle


def _v2_progress(req_dir, stage, request, material, dynamic_state=None, *,
                 lifecycle=None, receipt=None,
                 material_parser: ReviewMaterialParser | None = None,
                 review_inputs=None):
    bindings, external_ids, loaded = _v2_review_bindings(
        req_dir, stage, material, dynamic_state, include_closed=receipt is not None,
        lifecycle_snapshot=lifecycle, material_parser=material_parser,
        review_inputs=review_inputs)
    loaded = lifecycle or loaded
    if loaded is None:
        return None, ()
    claims_raw = _review_input_bytes(req_dir, stage, "issue-claims.json", review_inputs, required=False)
    claims_text = claims_raw.decode("utf-8") if claims_raw is not None else None
    claims = pending_fix_claims(loaded, claims_text, dict(request.doc_hashes))
    locations = {}
    if receipt is not None:
        known = {row["fingerprint"]: tuple(tuple(key) for key in row["section_keys"])
                 if row["section_keys"] is not None else None for row in bindings}
        locations = review_issue_locations(request, receipt, material.snapshot, known)
        # A full receipt accepted by this gate becomes the next persisted
        # baseline. Mirror its trusted bindings now so the progress digest
        # matches the next invocation after that baseline is published.
        for row in bindings:
            if row["fingerprint"] in locations:
                row["section_keys"] = [list(key) for key in
                                       locations[row["fingerprint"]]]
    return review_progress_digest(request, material.snapshot, bindings, external_ids,
        material.document_map(), material.section_map(), claims), bindings


def _prepare_review_material(req_dir, stage, dynamic_state, documents, parser, schema_version, upstream_materials=None):
    """One preparation path for delivery, receipt validation and Lifecycle."""
    context = _review_supporting_context(req_dir, stage, dynamic_state, upstream_materials=upstream_materials)
    dependency = _review_dependency_fingerprint(
        req_dir, stage, dynamic_state, schema_version=schema_version, supporting_context=context)
    material = parser.parse(stage, documents, dependency)
    providers = {}
    if schema_version == 2:
        for parent in _upstream_stages(stage, dynamic_state):
            sources = (upstream_materials[parent] if upstream_materials is not None
                       else _read_stage_materials(req_dir, parent, dynamic_state))
            bodies = {doc: raw.decode('utf-8', errors='strict') for doc, raw in sources.items()}
            if set(bodies) != set(_stage_documents(parent, dynamic_state)):
                raise ValueError('upstream source files are missing')
            for doc, text in bodies.items():
                context[f"upstream/{parent}/{doc}"] = text
            providers[parent] = parser.parse(parent, bodies, dependency)
        if any(_mapped_stage_roles(dynamic_state, parent) for parent in providers):
            context['source/upstream-mapping.json'] = json.dumps(dynamic_state.plan.source_map,
                ensure_ascii=False, sort_keys=True, separators=(',', ':'))
            dependency = _review_dependency_fingerprint(req_dir, stage, dynamic_state,
                schema_version=2, supporting_context=context)
            return parser.rebind_dependency(material, dependency), context, {}
        selected, context = consumed_review_context(material, providers, context)
        if selected["status"] == "SCOPED":
            scoped_dependency = _review_dependency_fingerprint(req_dir, stage, dynamic_state, schema_version=2,
                consumption=selected, supporting_context=context)
            material = parser.rebind_dependency(material, scoped_dependency)
            for parent, provider in providers.items():
                parser.rebind_dependency(provider, scoped_dependency)
    return material, context, providers


def _build_review_request(req_dir: Path, stage: str, dynamic_state=None,
                          schema_version: int = 1,
                          material_parser: ReviewMaterialParser | None = None, *,
                          source_materials: dict[str, bytes] | None = None,
                          review_inputs=None, upstream_materials=None):
    spec = _effective_stage_spec(stage, dynamic_state)
    if source_materials is None:
        source_materials = _capture_stage_materials(req_dir, spec["docs"])
    documents = {doc: (source_materials[doc].decode("utf-8", errors="strict")
                       if doc in source_materials else None) for doc in spec["docs"]}
    missing = [doc for doc, text in documents.items() if text is None]
    if missing:
        raise ValueError("阶段文档不可读: " + "、".join(missing))
    parser = material_parser or ReviewMaterialParser()
    material, context, providers = _prepare_review_material(req_dir, stage, dynamic_state, documents, parser, schema_version, upstream_materials)
    if schema_version == 2:
        baseline = _review_input_bytes(req_dir, stage, "review-baseline.json", review_inputs, required=False)
        bindings, external_ids, _lifecycle = _v2_review_bindings(
            req_dir, stage, material, dynamic_state,
            material_parser=parser, review_inputs=review_inputs)
        unresolved = {tuple(key) for row in bindings for key in (row["section_keys"] or [])}
        if 'source/upstream-mapping.json' in context:
            baseline = None
        request = plan_review_v2(material.snapshot, baseline=baseline,
            documents=material.document_map(), section_texts=material.section_map(),
            supporting_context=context,
            unresolved_sections=tuple(sorted(unresolved)),
            external_ids=tuple(sorted(external_ids)), issue_bindings=tuple(bindings))
        if request.mode == "incremental":
            scope_keys = request.selected_sections + tuple((doc, heading) for doc, heading, _text in request.reference_sections)
            scoped, selected_context = consumed_review_context(material, providers, context, consumer_sections=scope_keys)
            if scoped["status"] == "SCOPED":
                request = plan_review_v2(material.snapshot, baseline=baseline,
                    documents=material.document_map(), section_texts=material.section_map(),
                    supporting_context=selected_context, unresolved_sections=tuple(sorted(unresolved)),
                    external_ids=tuple(sorted(external_ids)), issue_bindings=tuple(bindings))
        return request, material
    previous = material.snapshot
    prior_full = False
    baseline_raw = _review_input_bytes(req_dir, stage, "review-baseline.json", review_inputs, required=False)
    if baseline_raw is not None:
        try:
            previous = load_review_snapshot(baseline_raw)
            prior_full = previous.stage == stage
        except (OSError, ValueError):
            previous = material.snapshot
            prior_full = False
    external_ids: set[str] = set()
    current_docs = set(spec["docs"])
    for other_stage in STAGES:
        for doc in _effective_stage_spec(other_stage, dynamic_state)["docs"]:
            if doc in current_docs:
                continue
            path = req_dir / doc
            if path.is_symlink():
                continue
            other = _read(path)
            if other is not None:
                external_ids.update(extract_trace_ids(other))
    request = plan_review(
        previous, material.snapshot, prior_review_was_full=prior_full,
        reviewed_doc_hashes=previous.doc_hashes if prior_full else (),
        documents=material.document_map(), section_texts=material.section_map(),
        supporting_context=context,
        external_ids=tuple(sorted(external_ids)))
    return request, material


def _review_supporting_context(req_dir: Path, stage: str,
                               dynamic_state=None, *, include_ancestors=False, upstream_materials=None) -> dict[str, str]:
    context: dict[str, str] = {}
    package = _registered_package_identity(req_dir)
    if package is not None:
        context['source/package-identity.json'] = json.dumps(package, ensure_ascii=False,
            sort_keys=True, separators=(',', ':'))
    hard_checks = _read(req_dir / "reviews" / "hard-checks.json")
    if hard_checks is not None:
        context["reviews/hard-checks.json"] = hard_checks
    security = _review_security_context(req_dir, stage)
    if security is not None:
        context["security/design-preconditions.json"] = security
    parents = list(_effective_stage_spec(stage, dynamic_state)['upstream'])
    for upstream in parents:
        if include_ancestors:
            for parent in _effective_stage_spec(upstream, dynamic_state)['upstream']:
                if parent not in parents:
                    parents.append(parent)
        if _mapped_stage_roles(dynamic_state, upstream):
            context['source/upstream-mapping.json'] = json.dumps(dynamic_state.plan.source_map,
                ensure_ascii=False, sort_keys=True, separators=(',', ':'))
        sources = (upstream_materials[upstream] if upstream_materials is not None
                   else _read_stage_materials(req_dir, upstream, dynamic_state))
        for doc, raw in sources.items():
            context[f'upstream/{upstream}/{doc}'] = raw.decode('utf-8', errors='strict')
    return context


def _review_security_context(req_dir: Path, stage: str) -> str | None:
    """Submit existing security material to the original reviewer, never approve it.

    The CLI has no live host provenance channel. A saved ADOPTABLE/VERIFIED
    flag is therefore accompanied by a fresh read-only PENDING evaluation,
    not interpreted as a signed dependency precondition. Absence means no
    approved carrier was supplied, not a proof of no dependency impact.
    """
    if stage not in {"概要设计", "详细设计"}:
        return None
    carrier = req_dir / "security"
    path = carrier / "record.json"
    if carrier.is_symlink() or path.is_symlink():
        raise ValueError("security review carrier is a symlink")
    if not path.exists():
        return None
    from aek.application.security_review import SecurityReviewService
    from aek.core.security.record import load_security_record, record_as_dict
    record = load_security_record(_read_review_bytes(path))
    body = record_as_dict(record)
    payload = {"schema_version": 1, "operation": "evaluate", "stage": "design", "scope": body["scope"],
               "identity": body["identity"], "proposals": [row["proposal"] for row in body["dependency_decisions"]],
               "surfaces": body["surfaces"], "findings": body["findings"], "inventories": body["inventories"],
               "run_refs": [], "invariant_refs": []}
    evaluated = SecurityReviewService().evaluate(json.dumps(payload, ensure_ascii=False).encode("utf-8"))
    return json.dumps({"record_digest": record.revision_digest, "record": body, "evaluation": evaluated,
                       "authority_verified": False,
                       "review_requirement": "Resolve pending design dependency evidence before adoption; delivery inventory may follow."},
                      ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def _record_review_delivery(reviews: Path, stage: str, request,
                            dynamic_state=None) -> None:
    """Account for the exact JSON payload emitted to the reviewer caller.

    This is intentionally a partial report: doc-gate can observe its own
    review payload, not host-native code/search/tool reads performed later by
    the reviewer.  Persisted events contain only digests and sizes.
    """
    route = (dynamic_state.plan.route if dynamic_state is not None
             and dynamic_state.plan is not None else "standard")
    subject = (dynamic_state.plan.subject_digest if dynamic_state is not None
               and dynamic_state.plan is not None
               else hashlib.sha256(json.dumps(
                   request.doc_hashes, ensure_ascii=False, sort_keys=True,
                   separators=(",", ":")).encode("utf-8")).hexdigest())
    suffix = hashlib.sha256(stage.encode("utf-8")).hexdigest()[:12]
    ledger = ContextLedger(
        reviews / f"{stage}.context-events-{subject[:12]}.jsonl")
    budget = resolve_context_budget(
        route, "design", "thorough" if route in {"standard", "initiative"}
        else "quick")
    payload = review_request_bytes(request).decode("utf-8")
    record_context_delivery(
        ledger, budget, payload, source="review", source_kind="document",
        channel="review_loader", event_purpose="review_required",
        expansion_purpose="review_required", session_id=f"review-{suffix}",
        subject_digest=subject,
        logical_path=f"generated/review-input-{suffix}.json")
    expected = (
        "capsule_loader", "host_native", "memory_candidate", "memory_open",
        "reference_loader", "review_loader", "skill_loader",
    )
    report = report_for_budget(
        ledger, budget, coverage="partial", expected_channels=expected,
        observed_channels=("review_loader",), bypass_detected=False)
    _atomic_review_write(
        reviews / f"{stage}.context-report.json",
        json.dumps(asdict(report), ensure_ascii=False, sort_keys=True,
                   separators=(",", ":")).encode("utf-8"))


def cmd_review_input(req_dir: Path, stage: str, as_json: bool,
                     schema_version: int = 1) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        with PlanStore(reviews).gate_snapshot() as snapshot:
            dynamic_state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            if dynamic_state is not None and dynamic_state.state != "FROZEN":
                print(f"✗ 动态计划不可用于评审：{dynamic_state.reason}")
                return 3
            spec = _effective_stage_spec(stage, dynamic_state)
            if not spec["docs"]:
                print(f"✓ {stage} 已由 ArtifactPlan 跳过，无需评审")
                return 0
            mapped = _capture_mapped_stage(req_dir, stage, dynamic_state)
            if mapped is not None and schema_version != 2:
                raise ValueError('外部来源评审需要版本 2 请求')
            sources = _read_stage_materials(req_dir, stage, dynamic_state, mapped)
            upstream_materials = _capture_upstream_materials(req_dir, stage, dynamic_state)
            checks = run_checks(req_dir, stage, dynamic_state, source_materials=sources,
                                mapped_stage=mapped, upstream_materials=upstream_materials)
            (reviews / "hard-checks.json").write_text(
                json.dumps(checks.to_dict(), ensure_ascii=False, indent=2),
                encoding="utf-8")
            if checks.fails:
                print(f"✗ {stage} 硬校验未过，不能生成评审输入")
                return 1
            material_parser = ReviewMaterialParser()
            if mapped is None:
                request, material = _build_review_request(
                    req_dir, stage, dynamic_state, schema_version=schema_version,
                    material_parser=material_parser, source_materials=sources, upstream_materials=upstream_materials)
            else:
                request, material = _mapped_stage_review(req_dir, stage, dynamic_state, mapped, sources, upstream_materials)
            if isinstance(request, ReviewRequestV2):
                progress, bindings = _v2_progress(
                    req_dir, stage, request, material, dynamic_state,
                    material_parser=material_parser)
                gate_path = reviews / f"{stage}.gate.json"
                previous_gate = json.loads(_read_review_bytes(gate_path)) if gate_path.exists() or gate_path.is_symlink() else {}
                lifecycle = LifecycleGateStore(reviews, stage).recover()
                if bindings and lifecycle is not None and (lifecycle.iteration >= lifecycle.max_iterations
                        or progress == previous_gate.get("review_progress_digest")):
                    print(json.dumps({"stage": stage, "status": previous_gate.get("status", "BLOCKED"),
                        "reason": "NO_REVIEW_PROGRESS" if lifecycle.iteration < lifecycle.max_iterations else "REVIEW_ITERATION_LIMIT",
                        "next": "保留未决问题；提供相关修复、合法定位或由维护者裁决后继续"}, ensure_ascii=False))
                    return 1
            _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
            current = _capture_mapped_stage(req_dir, stage, dynamic_state)
            if current != mapped or _read_stage_materials(req_dir, stage, dynamic_state, current) != sources:
                raise ValueError('SOURCE_CHANGED: stage material changed before review delivery')
            _atomic_review_write(
                reviews / f"{stage}.review-request.json",
                review_request_bytes(request))
            _atomic_review_write(
                reviews / f"{stage}.review-current.json",
                review_snapshot_bytes(material.snapshot))
            if as_json:
                _record_review_delivery(
                    reviews, stage, request, dynamic_state)
            output = {
                "request": json.loads(review_request_bytes(request)),
                "receipt": json.loads(reviewer_receipt(request)),
                "receipt_path": f"reviews/{stage}.review-receipt.json",
                "issues_path": f"reviews/{stage}.issues.json",
            }
            if as_json:
                print(json.dumps(output, ensure_ascii=False, indent=2))
            else:
                print(f"✓ {stage} 评审输入已生成（mode={request.mode}）")
            return 0
    except (OSError, PlanInvalid, PolicyError, TypeError, ValueError) as exc:
        print(f"✗ 无法生成评审输入: {exc}")
        return 3


def _mapped_stage_review(req_dir, stage, dynamic_state, mapped, sources, upstream_materials=None):
    mapping, frame = mapped
    context = _review_supporting_context(req_dir, stage, dynamic_state, include_ancestors=True,
                                         upstream_materials=upstream_materials)
    # The source map is supplied by mapped_review_input. A shared file is
    # already delivered in full in this stage and can serve both roles.
    context.pop('source/upstream-mapping.json', None)
    shared = []
    for key in sorted(context):
        if not key.startswith('upstream/'):
            continue
        _kind, upstream, path = key.split('/', 2)
        if path not in sources:
            continue
        if context[key].encode('utf-8') != sources[path]:
            raise ValueError('SOURCE_CHANGED: shared review source differs from its upstream bytes')
        shared.append({'stage': upstream, 'path': path, 'sha256': hashlib.sha256(sources[path]).hexdigest()})
        del context[key]
    if shared:
        context['source/shared-upstream.json'] = json.dumps(shared, ensure_ascii=False,
                                                             sort_keys=True, separators=(',', ':'))
    dependency = _review_dependency_fingerprint(req_dir, stage, dynamic_state,
        schema_version=2, supporting_context=context)
    native = {name: raw for name, raw in sources.items() if name not in frame.sources()}
    return mapped_review_input(frame, mapping, stage, dependency, supporting_context=context, native_sources=native)


def _consecutive_failures(log_file: Path) -> int:
    """从 gate.log 尾部统计**连续**不达标轮数（PASS 清零——P2 修复：
    此前累计全部历史行数，历史 PASS 三次后一次失败即 BLOCKED）。"""
    if not log_file.exists():
        return 0
    count = 0
    for line in reversed(log_file.read_text(encoding="utf-8").splitlines()):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("status") == "PASS":
            break
        count += 1
    return count


def _was_blocked(log_file: Path) -> bool:
    """最近一次判定是否 BLOCKED（BLOCKED 状态由人工介入解除——重跑只有
    PASS 才能解冻，防止自动重试碰运气）。"""
    if not log_file.exists():
        return False
    for line in reversed(log_file.read_text(encoding="utf-8").splitlines()):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        return entry.get("status") == "BLOCKED"
    return False


def cmd_gate(req_dir: Path, stage: str, no_review: bool, as_json: bool, schema_version: int = 1) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        store = PlanStore(reviews)
        dynamic_state = None
        with store.locked_view(req_dir) as view:
            snapshot = view.snapshot()
            dynamic_state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            material_mode = schema_version == 2 or (reviews / 'package.json').exists() or any(
                isinstance(load_binding_bytes(raw), MaterialStageBinding)
                for name, raw in snapshot.items() if name.endswith(".plan-binding.json"))
            if stage in STAGES and _mapped_stage_roles(dynamic_state, stage):
                material_mode = True
            result = _cmd_gate_locked(
                req_dir, stage, no_review, as_json, dynamic_state,
                material_view=view if material_mode else None)
            if result == 0 and dynamic_state is not None:
                return _bind_dynamic_gate(req_dir, dynamic_state, stage, view, material_mode=material_mode)
        return result
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_gate_locked(req_dir: Path, stage: str, no_review: bool, as_json: bool,
                     dynamic_state=None, *, material_view=None) -> int:
    operation_package = _registered_package_identity(req_dir)
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            print(f"✗ 动态计划不可用于门禁：{dynamic_state.reason}")
            return 3
        if not participating_documents(dynamic_state.plan, stage):
            skipped_checks = run_checks(req_dir, stage, dynamic_state)
            if skipped_checks.fails:
                if as_json:
                    print(json.dumps(skipped_checks.to_dict(), ensure_ascii=False))
                else:
                    print(f"✗ {stage} 当前跳过依据未通过校验，不能跳过门禁")
                return 3
            print(f"✓ {stage} 已由 ArtifactPlan 跳过，无需门禁")
            return 0
    elif _dynamic_sidecar_present(req_dir):
        print("✗ 动态计划 sidecar 无法验证，拒绝门禁")
        return 3
    if stage in HUMAN_SIGNOFF:
        print(f"✗ {stage} 是人工签核阶段：评审权在人（签写评审记录后由 freeze 落哈希凭证）")
        return 3
    spec = _effective_stage_spec(stage, dynamic_state)

    try:
        policy = _load_policy(_repo_root(req_dir))
    except PolicyError as e:
        print(f"✗ 文档策略非法: {e}")
        return 3

    mapped = _capture_mapped_stage(req_dir, stage, dynamic_state)
    if mapped is not None:
        spec = {**spec, 'docs': list(_stage_source_names(dynamic_state.plan, stage)), 'review': True}
    source_materials = _read_stage_materials(req_dir, stage, dynamic_state, mapped)
    upstream_materials = _capture_upstream_materials(req_dir, stage, dynamic_state)
    checks = run_checks(req_dir, stage, dynamic_state,
                        source_materials=source_materials, mapped_stage=mapped,
                        upstream_materials=upstream_materials)
    if not checks.fails:
        _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")

    # P1：必审阶段拒绝 --no-review（此前可绕过 AI 评审直接 PASS）
    if no_review and spec["review"] is True:
        print(f"✗ 阶段 {stage} 是必审阶段（review=True），不允许 --no-review")
        return 3

    material_parser = ReviewMaterialParser()
    mapped_review = (_mapped_stage_review(req_dir, stage, dynamic_state, mapped, source_materials, upstream_materials)
                     if mapped is not None and not checks.fails else None)
    review_inputs = _capture_review_inputs(req_dir, stage) if not no_review else None
    issues: list[dict] = []
    issues_text: str | None = None
    if not no_review:
        raw_issues = _review_input_bytes(req_dir, stage, "issues.json", review_inputs, required=False)
        text = raw_issues.decode("utf-8", errors="strict") if raw_issues is not None else None
        if text is None:
            # optional 阶段缺评审文件 = 未做评审，按硬校验判（合法）；
            # 必审阶段缺文件 = 拒绝（硬校验也挂时优先报硬问题）
            if spec["review"] is True and not checks.fails:
                print(f"✗ 阶段 {stage} 需要先跑 AI 评审（reviews/{stage}.issues.json 缺失或损坏）")
                return 3
        else:
            issues_text = text
            issues, err = _validate_issues(
                req_dir, stage, spec, text, dynamic_state,
                material_parser=material_parser, source_materials=source_materials,
                review_inputs=review_inputs, mapped_review=mapped_review, upstream_materials=upstream_materials)
            if issues is None:
                if not checks.fails:
                    print(f"✗ 评审不可用: {err}")
                    return 3
                issues = []

    log_file = reviews_dir / f"{stage}.gate.log"
    consecutive = _consecutive_failures(log_file)
    was_blocked = _was_blocked(log_file)
    doc_hashes = {doc: hashlib.sha256(raw).hexdigest()
                  for doc, raw in source_materials.items()}

    lifecycle_store = None
    lifecycle_before = None
    lifecycle = None
    lifecycle_path = reviews_dir / f"{stage}.issue-lifecycle.json"
    if issues_text is not None or lifecycle_path.exists() or lifecycle_path.is_symlink():
        try:
            lifecycle_store = LifecycleGateStore(reviews_dir, stage)
            lifecycle_before = lifecycle_store.recover()
            if issues_text is None:
                raise ValueError("已有 Issue 生命周期但本轮评审输出缺失")
            claims_raw = _review_input_bytes(req_dir, stage, "issue-claims.json", review_inputs, required=False)
            claims_text = claims_raw.decode("utf-8") if claims_raw is not None else None
            verified_fingerprints = None
            request_raw = _review_input_bytes(req_dir, stage, "review-request.json", review_inputs, required=False)
            request = load_versioned_review_request(request_raw) if request_raw is not None else None
            dependency = _review_dependency_fingerprint(
                req_dir, stage, dynamic_state,
                schema_version=(request.schema_version if request is not None
                                else 1))
            receipt_text = None
            if isinstance(request, ReviewRequestV2):
                receipt_text = _review_input_bytes(
                    req_dir, stage, "review-receipt.json", review_inputs).decode("utf-8")
                current_documents = {
                    doc: (source_materials[doc].decode("utf-8", errors="strict")
                          if doc in source_materials else None) for doc in spec["docs"]
                }
                if any(value is None for value in current_documents.values()):
                    raise ValueError("current review material is incomplete")
                if mapped_review is not None:
                    current_material = mapped_review[1]
                else:
                    current_material, _actual_context, _providers = _prepare_review_material(req_dir, stage, dynamic_state,
                        current_documents, material_parser, 2, upstream_materials)
                dependency = current_material.snapshot.dependency_fingerprint
                current_bindings, _external_ids, _loaded = _v2_review_bindings(
                    req_dir, stage, current_material, dynamic_state,
                    include_closed=True,
                    lifecycle_snapshot=lifecycle_before,
                    material_parser=material_parser)
                known_sections = {
                    row["fingerprint"]: (
                        tuple(tuple(key) for key in row["section_keys"])
                        if row["section_keys"] is not None else None)
                    for row in current_bindings
                }
                locations = review_issue_locations(
                    request, receipt_text, current_material.snapshot,
                    known_sections)
                selected = set(request.selected_sections)
                covered = []
                for row in current_bindings:
                    keys = row["section_keys"]
                    if keys is None and row["fingerprint"] in locations:
                        keys = [list(key) for key in
                                locations[row["fingerprint"]]]
                    if keys and set(tuple(key) for key in keys).issubset(selected):
                        covered.append(row["fingerprint"])
                verified_fingerprints = tuple(sorted(covered))
            lifecycle = prepare_lifecycle(
                lifecycle_before,
                stage=stage,
                subject_digest=_review_subject_digest(
                    stage, doc_hashes, dependency),
                request_digest=_review_observation_digest(
                    req_dir, stage, issues_text, review_inputs=review_inputs),
                doc_hashes=doc_hashes,
                issues=tuple(item for item in issues if not item.get("upstream")),
                iteration=min(max(
                    consecutive + 1,
                    lifecycle_before.iteration if lifecycle_before is not None else 1,
                ), policy["max_iterations"]),
                max_iterations=policy["max_iterations"],
                claims_text=claims_text,
                verified_fingerprints=verified_fingerprints,
            )
            if isinstance(request, ReviewRequestV2):
                progress, _bindings = _v2_progress(
                    req_dir, stage, request, current_material, dynamic_state,
                    lifecycle=lifecycle, receipt=receipt_text,
                    material_parser=material_parser, review_inputs=review_inputs)
                if progress is not None:
                    # Persist the exact state compared by review-input before
                    # it may emit the same request again.
                    lifecycle_progress_digest = progress
                else:
                    lifecycle_progress_digest = None
            else:
                lifecycle_progress_digest = None
        except (LifecycleConflict, OSError, TypeError, ValueError) as exc:
            print(f"✗ Issue 生命周期不可用: {exc}")
            return 3

    upstream_issues = [i for i in issues if i.get("upstream")]
    upstream_ids = {str(item.get("id")) for item in upstream_issues}
    if lifecycle is None:
        counted = [i for i in issues if not i.get("upstream")]
    else:
        unresolved_states = {
            IssueState.OPEN, IssueState.FIXED,
            IssueState.REOPENED, IssueState.BLOCKED,
        }
        counted = [{
            "id": item.occurrences[-1].issue_id,
            "severity": item.occurrences[-1].severity,
            "fingerprint": item.fingerprint,
            "state": item.state.value,
        } for item in lifecycle.issues
                   if item.state in unresolved_states
                   and item.occurrences[-1].issue_id not in upstream_ids]
    n_blocker = sum(1 for i in counted if i["severity"] == "blocker")
    n_major = sum(1 for i in counted if i["severity"] == "major")
    n_minor = sum(1 for i in counted if i["severity"] == "minor")
    lifecycle_pending = len(counted) if lifecycle is not None else 0

    hard_fail = checks.fails
    decision = judge_gate(JudgeInput(
        len(hard_fail), n_blocker, n_major, n_minor, len(upstream_issues),
        consecutive, was_blocked, policy["max_blocker"], policy["max_major"],
        policy["max_minor"], policy["max_iterations"]))
    status = decision.status
    over = decision.over_threshold
    current_attempt = decision.current_attempt

    fix_targets = ([i.get("id", "?") for i in counted][:10]
                   if status != "PASS" else [])
    gate = {
        "stage": stage, "status": status, "time": datetime.now().isoformat(timespec="seconds"),
        "hard": {"pass": len(checks.items) - len(hard_fail), "fail": len(hard_fail),
                 "failed": [f"{c['group']}/{c['name']}" for c in hard_fail]},
        "review": {"blocker": n_blocker, "major": n_major, "minor": n_minor,
                   "upstream_pending": len(upstream_issues),
                   "lifecycle_pending": lifecycle_pending,
                   "fix_targets": fix_targets},
        "policy": policy, "iteration": consecutive + 1, "doc_hashes": doc_hashes,
        "upstream_fingerprints": {
            up: _stage_fingerprint(req_dir, up, dynamic_state)
            for up in spec["upstream"]},
        "failed_because": (
            ["hard checks FAIL: " + "；".join(c["name"] for c in hard_fail[:5])] if hard_fail else [])
            + ([f"severity 超阈值: blocker={n_blocker}/{policy['max_blocker']}, "
                f"major={n_major}/{policy['max_major']}, minor={n_minor}/{policy['max_minor']}"]
               if over else [])
            + ([f"上游打回未决 {len(upstream_issues)} 项（待维护者裁决）"]
               if upstream_issues else []),
        "next": ("进入下一阶段（文档已冻结）" if status == "PASS"
                 else "维护者裁决上游问题后对本阶段重新评审"
                 if upstream_issues and not hard_fail and not over
                 else "定向修改上述问题后重新提交"
                 if status == "NEEDS_REVISION"
                 else f"已连续 {policy['max_iterations']} 轮不达标——升级人工介入"
                 if not was_blocked else "BLOCKED 未解除：人工介入后需重新评审且判定 PASS"),
    }
    if lifecycle is not None and lifecycle_progress_digest is not None:
        gate["review_progress_digest"] = lifecycle_progress_digest
    if operation_package is not None:
        gate['package_identity'] = operation_package
    if mapped is not None:
        gate['source_mapping_digest'] = mapped[1].mapping_digest
    if stage == "计划" and status == "PASS":
        gate["execution_baseline_hashes"] = _plan_baseline_hashes(req_dir, source_materials=source_materials)
    gate_file = reviews_dir / f"{stage}.gate.json"
    def publish_gate(raw):
        _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
        if review_inputs is not None:
            _check_review_inputs_current(req_dir, stage, review_inputs)
        _require_gate_package(req_dir, json.loads(raw.decode('utf-8')), operation_package)
        archive = MaterialArchive(reviews_dir)
        if mapped is None and stage == 'UI设计' and _prototype_manifest_version(source_materials.get('UI设计.md')) == 3:
            def capture_current_ui():
                current_sources = _read_stage_materials(req_dir, stage, dynamic_state)
                ui_checks = Checks(stage)
                _check_ui_prototypes(ui_checks, req_dir,
                    current_sources['UI设计.md'].decode('utf-8'), dynamic_state=dynamic_state)
                if ui_checks.fails:
                    raise ValueError('SOURCE_CHANGED: current interactive evidence or confirmation changed')
                return current_sources
            archive.publish_gate(req_dir, raw, capture_sources=capture_current_ui)
        elif mapped is None:
            archive.publish_gate(req_dir, raw)
        else:
            def capture_current():
                current = _capture_mapped_stage(req_dir, stage, dynamic_state)
                if current != mapped:
                    raise ValueError('SOURCE_CHANGED: mapped source snapshot changed before publication')
                current_sources = _read_stage_materials(req_dir, stage, dynamic_state, current)
                if _mapped_stage_review(req_dir, stage, dynamic_state, current, current_sources)[0] != mapped_review[0]:
                    raise ValueError('SOURCE_CHANGED: mapped review dependencies changed before publication')
                if stage == 'UI设计':
                    current_text, current_ui = _ui_stage_material(req_dir, dynamic_state, current)
                    ui_checks = Checks(stage)
                    _check_ui_prototypes(ui_checks, req_dir, current_text, dynamic_state=dynamic_state,
                                         mapped_ui=current_ui)
                    if ui_checks.fails:
                        raise ValueError('SOURCE_CHANGED: mapped interactive evidence or confirmation changed')
                return current_sources
            archive.publish_gate(req_dir, raw, capture_sources=capture_current)
        _require_gate_package(req_dir, json.loads(raw.decode('utf-8')), operation_package)
        if material_view is not None and dynamic_state is None:
            _document_materials(req_dir, material_view).baseline(stage)

    if lifecycle_store is not None and lifecycle is not None:
        expected_lifecycle = (None if lifecycle_before is None
                              else lifecycle_before.snapshot_digest)
        try:
            if status == "PASS":
                _closed, gate = lifecycle_store.publish_pass_gate(
                    lifecycle, gate,
                    expected_snapshot_digest=expected_lifecycle,
                    gate_publisher=publish_gate)
            else:
                gate = lifecycle_store.publish_non_pass_gate(
                    lifecycle, gate,
                    expected_snapshot_digest=expected_lifecycle)
        except (LifecycleConflict, OSError, TypeError, ValueError) as exc:
            print(f"✗ Issue 生命周期发布失败: {exc}")
            return 3
    else:
        gate_bytes = json.dumps(gate, ensure_ascii=False, indent=2).encode("utf-8")
        if status == "PASS":
            publish_gate(gate_bytes)
        else:
            _atomic_review_write(gate_file, gate_bytes)
    with log_file.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"time": gate["time"], "stage": stage, "status": status,
                            "iteration": gate["iteration"]}, ensure_ascii=False) + "\n")

    if issues_text is not None and not checks.fails:
        try:
            _publish_full_v2_material_baseline(
                req_dir, stage, gate, dynamic_state,
                material_parser=material_parser, review_inputs=review_inputs)
        except (OSError, TypeError, ValueError) as exc:
            print(f"✗ v2 材料基线不可用: {exc}")
            return 3

    if as_json:
        print(json.dumps(gate, ensure_ascii=False, indent=2))
    else:
        print(f"阶段 {stage} 门禁判定: {status}（连续不达标 {consecutive} 轮）")
        for chk in hard_fail:
            print(f"  ✗ HARD {chk['name']}: {chk['detail']}")
        if upstream_issues:
            print(f"  ⚠ 打回上游 {len(upstream_issues)} 项（待维护者裁决，不冻结）")
        if status != "PASS":
            print(f"  下一步: {gate['next']}")
    return {"PASS": 0, "NEEDS_REVISION": 1, "BLOCKED": 2}[status]


def _mapped_signoff_input(req_dir, state, stage, frame):
    from aek.core.security.authority import digest

    doc_hashes = frame.source_hashes()
    upstream = {name: _stage_fingerprint(req_dir, name, state)
                for name in _effective_stage_spec(stage, state)['upstream']}
    return digest({'stage': stage, 'mapping_digest': frame.mapping_digest,
        'package_revision': frame.package_revision, 'doc_hashes': doc_hashes, 'upstream_fingerprints': upstream,
        'credential_digest': state.credential.credential_digest, 'policy': _load_policy(_repo_root(req_dir))})


def cmd_freeze(req_dir: Path, stage: str, approved_by: str, as_json: bool, schema_version: int = 1,
               *, approved_input=None) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        store = PlanStore(reviews)
        dynamic_state = None
        with store.locked_view(req_dir) as view:
            snapshot = view.snapshot()
            dynamic_state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            mapped = _capture_mapped_stage(req_dir, stage, dynamic_state) if stage in HUMAN_SIGNOFF else None
            material_mode = schema_version == 2 or (reviews / 'package.json').exists() or any(
                isinstance(load_binding_bytes(raw), MaterialStageBinding)
                for name, raw in snapshot.items() if name.endswith(".plan-binding.json"))
            material_mode = material_mode or mapped is not None
            result = _cmd_freeze_locked(
                req_dir, stage, approved_by, as_json, dynamic_state,
                material_view=view if material_mode else None, mapped=mapped, approved_input=approved_input)
            if result == 0 and dynamic_state is not None:
                return _bind_dynamic_gate(req_dir, dynamic_state, stage, view, material_mode=material_mode)
        return result
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_freeze_locked(req_dir: Path, stage: str, approved_by: str, as_json: bool,
                       dynamic_state=None, *, material_view=None, mapped=None, approved_input=None) -> int:
    """人工签核阶段的冻结凭证（需求分析/业务流程设计）：hard checks 全过 +
    人工签核已写（评审权在人，本工具只落哈希凭证），写 reviews/<阶段>.gate.json
    绑定该阶段文档的 sha256。签核后任何改动 = 哈希失配。"""
    operation_package = _registered_package_identity(req_dir)
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            print(f"✗ 动态计划不可用于冻结：{dynamic_state.reason}")
            return 3
        if not participating_documents(dynamic_state.plan, stage):
            print(f"✓ {stage} 已由 ArtifactPlan 跳过，无需冻结")
            return 0
    elif _dynamic_sidecar_present(req_dir):
        print("✗ 动态计划 sidecar 无法验证，拒绝冻结")
        return 3
    if stage not in HUMAN_SIGNOFF:
        print(f"✗ 阶段 {stage} 不是人工签核阶段（用 gate 子命令走机器门禁）")
        return 3
    doc = STAGES[stage]["docs"][0]
    sign_re, want_state = HUMAN_SIGNOFF[stage]
    if mapped is None:
        if approved_input is not None:
            raise ValueError('approval source digest requires an explicitly mapped human stage')
        root = _open_dir_nofollow(req_dir)
        try:
            doc_raw = _ui_fs.read_at(root, doc, MAX_DOCUMENT_BYTES)
        finally:
            _ui_fs.close_dir(root)
        sources = {doc: doc_raw}
    else:
        frame = mapped[1]
        if (not approved_by.strip() or approved_input != _mapped_signoff_input(req_dir, dynamic_state, stage, frame)):
            raise ValueError('external signoff requires a maintainer and the exact current reviewed input SHA-256')
        sources = frame.sources()
        location = _mapped_section(frame, 'business-flow', '评审记录')
        doc = location.path
        doc_raw = sources[doc][location.start:location.end]
    doc_text = doc_raw.decode("utf-8", errors="strict")
    upstream_materials = _capture_upstream_materials(req_dir, stage, dynamic_state)
    checks = run_checks(req_dir, stage, dynamic_state,
                        source_materials=sources, upstream_materials=upstream_materials, mapped_stage=mapped)
    m = re.search(sign_re, doc_text)
    signed = m.group(1) if m else "未记录"
    if signed != want_state:
        print(f"✗ 人工签核未完成（当前：{signed}）——评审权在人，"
              f"先在 {doc} 签写签核记录")
        return 3
    if checks.fails:
        print(f"✗ {stage} 硬校验未过（{len(checks.fails)} 项），冻结被拒：")
        for c in checks.fails:
            print(f"  ✗ [{c['group']}] {c['name']}: {c['detail']}")
        return 3
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")
    gate = {
        "stage": stage, "status": "PASS",
        "time": datetime.now().isoformat(timespec="seconds"),
        "approved_by": approved_by or "维护者",
        "doc_hashes": {name: hashlib.sha256(raw).hexdigest() for name, raw in sources.items()},
        "upstream_fingerprints": {
            up: _stage_fingerprint(req_dir, up, dynamic_state)
            for up in _effective_stage_spec(stage, dynamic_state)["upstream"]},
        "frozen_by": "doc-gate freeze（人工签核 + 哈希凭证）",
    }
    if operation_package is not None:
        gate['package_identity'] = operation_package
    capture_current = None
    if mapped is not None:
        gate.update(source_mapping_digest=frame.mapping_digest, approved_input_sha256=approved_input)
        def capture_current():
            current = _capture_mapped_stage(req_dir, stage, dynamic_state)
            _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
            if current != mapped or _mapped_signoff_input(req_dir, dynamic_state, stage, current[1]) != approved_input:
                raise ValueError('SOURCE_CHANGED: external signoff input changed before freeze')
            return current[1].sources()
    _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
    _require_gate_package(req_dir, gate, operation_package)
    MaterialArchive(reviews_dir).publish_gate(
        req_dir, json.dumps(gate, ensure_ascii=False, indent=2).encode("utf-8"), capture_sources=capture_current)
    _require_gate_package(req_dir, gate, operation_package)
    if material_view is not None and dynamic_state is None:
        _document_materials(req_dir, material_view).baseline(stage)
    with (reviews_dir / f"{stage}.gate.log").open("a", encoding="utf-8") as f:
        f.write(json.dumps({"time": gate["time"], "stage": stage,
                            "status": "PASS", "approved_by": gate["approved_by"]},
                           ensure_ascii=False) + "\n")
    if as_json:
        print(json.dumps(gate, ensure_ascii=False, indent=2))
    else:
        print(f"✓ {stage} 已签核冻结（凭证绑定 sha256；approved_by={gate['approved_by']}）——"
              f"下游阶段可开始")
    return 0


def cmd_closeout(req_dir: Path, as_json: bool) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        store = PlanStore(reviews)
        dynamic_state = None
        with store.locked_view(req_dir) as view:
            snapshot = view.snapshot(for_material_recovery=True)
            dynamic_state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            if _mapped_stage_roles(dynamic_state, '计划'):
                raise ValueError('当前计划收口需要原生任务及测试方案')
            recovery = _document_materials(req_dir, view, dynamic_state, policy_operation="execution-closeout-v1")
            view.recover_closeout(lambda stage: recovery._context(stage, _effective_stage_spec(stage, dynamic_state)["docs"]))
            snapshot = view.snapshot()
            dynamic_state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            material_mode = any(isinstance(load_binding_bytes(raw), MaterialStageBinding)
                for name, raw in snapshot.items() if name.endswith(".plan-binding.json"))
            result = _cmd_closeout_locked(req_dir, as_json, dynamic_state,
                                         material_view=view if material_mode else None, publication_view=view)
            if result == 0 and dynamic_state is not None:
                return _bind_dynamic_gate(req_dir, dynamic_state, '计划', view,
                                          material_mode=material_mode, closeout=True)
        return result
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_closeout_locked(req_dir: Path, as_json: bool, dynamic_state=None, *, material_view=None, publication_view=None) -> int:
    """Validate execution facts and bind the complete final plan documents.

    The initial plan gate remains the immutable execution baseline.  This
    separate credential closes the intentionally mutable execution window and
    makes every later document edit invalidate the final state again.
    """
    if dynamic_state is not None:
        if dynamic_state.state != "FROZEN" or dynamic_state.plan is None:
            print(f"✗ 动态计划不可用于收口：{dynamic_state.reason}")
            return 3
        if not participating_documents(dynamic_state.plan, "计划"):
            print("✓ 计划阶段已由 ArtifactPlan 跳过，无需执行收口")
            return 0
    elif _dynamic_sidecar_present(req_dir):
        print("✗ 动态计划 sidecar 无法验证，拒绝收口")
        return 3
    reviews_dir = req_dir / "reviews"
    gate_file = reviews_dir / "计划.gate.json"
    if publication_view is None:
        raise ValueError("closeout requires the original live publication view")
    consumers = publication_view.consumer_digest
    gate_raw = publication_view.read_gate("计划")
    if gate_raw is None:
        print("✗ 计划尚未通过门禁，不能执行收口")
        return 3
    try:
        gate = json.loads(gate_raw.decode("utf-8", errors="strict"))
        _require_gate_package(req_dir, gate)
    except json.JSONDecodeError:
        print("✗ 计划.gate.json 损坏，不能执行收口")
        return 3
    if gate.get("status") != "PASS":
        print(f"✗ 计划最近判定 {gate.get('status')}，不能执行收口")
        return 3

    spec = _effective_stage_spec("计划", dynamic_state)
    sources = {doc: publication_view.read_source(doc) for doc in spec["docs"]}
    hashes = {doc: hashlib.sha256(raw).hexdigest() for doc, raw in sources.items()}
    service = _document_materials(req_dir, publication_view, dynamic_state, policy_operation="execution-closeout-v1")
    service.gate_validator(gate)
    epoch = {"stage": "计划", "context": service._context("计划", sources),
             "source_hashes": hashes, "dependency_hashes": service.capture_dependencies("计划")}
    upstream = {up: _stage_fingerprint(req_dir, up, dynamic_state) for up in spec["upstream"]}
    previous_raw = publication_view.read_closeout()
    previous = json.loads(previous_raw.decode("utf-8")) if previous_raw is not None else None
    current_closeout = (type(previous) is dict and previous.get("status") == "PASS"
        and previous.get("kind") == "execution_closeout" and previous.get("doc_hashes") == hashes
        and previous.get("plan_gate_sha256") == hashlib.sha256(gate_raw).hexdigest()
        and previous.get("upstream_fingerprints") == upstream)
    upstream_materials = _capture_upstream_materials(req_dir, "计划", dynamic_state)
    checks = run_checks(req_dir, "计划", dynamic_state, source_materials=sources,
                        upstream_materials=upstream_materials)
    failures = [
        f"硬校验失败: {item['name']}"
        for item in checks.fails
    ]
    expected_baseline = gate.get("execution_baseline_hashes")
    if expected_baseline:
        current_baseline = _plan_baseline_hashes(req_dir, source_materials=sources)
        if set(expected_baseline) != set(spec["docs"]):
            failures.append("执行前计划基线未完整覆盖阶段文档")
        else:
            for doc, want in expected_baseline.items():
                if current_baseline.get(doc) != want and not current_closeout and not _material_hash_current(req_dir, "计划", dynamic_state):
                    failures.append(f"{doc} 的执行前计划基线已改变")
    failures.extend(_plan_completion_failures(req_dir, source_materials=sources))
    if any(value is None for value in upstream.values()):
        failures.append("上游阶段指纹不可验证")

    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8"
    )
    if failures:
        if as_json:
            print(json.dumps({"stage": "计划", "status": "NEEDS_REVISION",
                              "failures": failures}, ensure_ascii=False, indent=2))
        else:
            print(f"✗ 计划收口未通过（{len(failures)} 项）：")
            for failure in failures:
                print(f"  ✗ {failure}")
        return 1

    closeout = {
        "stage": "计划",
        "status": "PASS",
        "kind": "execution_closeout",
        "time": datetime.now().isoformat(timespec="seconds"),
        "plan_gate_sha256": hashlib.sha256(gate_raw).hexdigest(),
        "baseline_mode": "projected" if expected_baseline else "legacy_unavailable",
        "doc_hashes": hashes,
        "upstream_fingerprints": upstream,
    }
    _require_approved_upstream(req_dir, dynamic_state, upstream_materials)
    publication_view.commit_closeout(json.dumps(closeout, ensure_ascii=False, indent=2).encode("utf-8"),
        expected_consumers=consumers, epoch=epoch,
        context_loader=lambda stage: service._context(stage, sources))
    if material_view is not None and dynamic_state is None:
