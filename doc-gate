def cmd_check(req_dir: Path, stage: str, as_json: bool, summary: bool = False) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        with PlanStore(reviews).gate_snapshot() as snapshot:
            return _cmd_check_locked(
                req_dir, stage, as_json, _dynamic_state_from_snapshot(snapshot, req_dir=req_dir), summary=summary)
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def _cmd_check_locked(req_dir: Path, stage: str, as_json: bool,
                      dynamic_state=None, *, summary: bool = False) -> int:
    if stage not in STAGES:
        print(f"✗ 未知阶段: {stage}（可选: {'、'.join(STAGES)}）")
        return 3
    if dynamic_state is not None and dynamic_state.state != "FROZEN":
        print(f"✗ 动态计划不可用于校验：{dynamic_state.reason}")
        return 3
    mapped = _capture_mapped_stage(req_dir, stage, dynamic_state)
    sources = _read_stage_materials(req_dir, stage, dynamic_state, mapped) if mapped is not None else None
    checks = run_checks(req_dir, stage, dynamic_state, source_materials=sources, mapped_stage=mapped)
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    result = checks.to_dict()
    signoff = {}
    if mapped is not None and stage in HUMAN_SIGNOFF and not checks.fails:
        signoff = {'approved_input_sha256': _mapped_signoff_input(req_dir, dynamic_state, stage, mapped[1]),
                   'mapped_doc_hashes': mapped[1].source_hashes()}
        result.update(signoff)
    raw = json.dumps(result, ensure_ascii=False, indent=2).encode("utf-8")
    _atomic_review_write(reviews_dir / "hard-checks.json", raw)
    if summary:
        print(json.dumps({"schema_version": 1, "stage": stage,
            "status": "FAIL" if checks.fails else "PASS",
            "summary": result["summary"], "failures": checks.fails,
            "full_result_ref": "reviews/hard-checks.json",
            "result_digest": hashlib.sha256(raw).hexdigest(), **signoff}, ensure_ascii=False))
    elif as_json:
        print(raw.decode("utf-8"))
    else:
        print(f"硬校验 {stage}: {checks.to_dict()['summary']['pass']} 通过 / "
              f"{len(checks.fails)} 失败")
        for chk in checks.fails:
            print(f"  ✗ [{chk['group']}] {chk['name']}: {chk['detail']}")
    return 1 if checks.fails else 0


def _stage_material_status(req_dir: Path, stage: str, dynamic_state=None) -> dict:
    """Explain current bytes against the original Gate; never grant approval."""
    result = {"classification": "UNKNOWN", "reason_code": "NO_APPROVAL",
              "rule_version": FORMAT_RULE_VERSION, "raw_before": {}, "raw_after": {},
              "content_digest": {}, "affected_targets": [], "revision": None,
              "required_action": "REVIEW"}
    if dynamic_state is not None and dynamic_state.state != "FROZEN":
        result["reason_code"] = "PLAN_UNVERIFIABLE"
        return result
    binding = None
    try:
        if (req_dir / "reviews" / f"{stage}.plan-binding.json").exists():
            binding = _current_material_binding(req_dir, stage, dynamic_state, allow_changed=True)
            if binding is not None:
                result["revision"] = binding.binding_digest
    except (OSError, PlanInvalid, TypeError, ValueError):
        result["reason_code"] = "BASELINE_UNVERIFIABLE"
        return result
    documents = _stage_documents(stage, dynamic_state)
    if not documents:
        result.update(reason_code="PLAN_SKIPPED", required_action="NONE")
        return result
    try:
        gate_raw = _read_review_bytes(req_dir / "reviews" / f"{stage}.gate.json")
    except FileNotFoundError:
        return result
    try:
        gate = json.loads(gate_raw.decode("utf-8"))
        if type(gate) is not dict or gate.get("status") != "PASS" or gate.get("stage") != stage:
            result["reason_code"] = "NO_CURRENT_APPROVAL"
            return result
        closed = stage == "计划" and (req_dir / "reviews/计划.closeout.json").exists()
        if closed:
            with PlanStore(req_dir / "reviews").read_view(req_dir) as view:
                gate_raw, gate = _document_materials(req_dir, view, dynamic_state)._gate(stage)
        hashes = gate.get("doc_hashes")
        if type(hashes) is not dict or set(hashes) != set(documents):
            result["reason_code"] = "SOURCE_SET_CHANGED"
            return result
        result["raw_before"] = hashes
        result["approved_origin"] = {"gate_sha256": hashlib.sha256(gate_raw).hexdigest()}
        current = _read_stage_materials(req_dir, stage, dynamic_state)
        result["raw_after"] = {doc: hashlib.sha256(raw).hexdigest() for doc, raw in current.items()}
        if set(current) != set(documents):
            result["reason_code"] = "SOURCE_MISSING"
            return result
        archive = MaterialArchive(req_dir / "reviews")
        if stage == "计划" and not closed and gate.get("execution_baseline_hashes"):
            projected = {name: _plan_baseline_text(name, raw.decode("utf-8")).encode("utf-8")
                         for name, raw in current.items()}
            projected_hashes = {name: hashlib.sha256(raw).hexdigest() for name, raw in projected.items()}
            accepted = gate["execution_baseline_hashes"]
            if binding is not None:
                accepted = {name: hashlib.sha256(_plan_baseline_text(name,
                    archive.get(digest).decode("utf-8")).encode("utf-8")).hexdigest()
                    for name, digest in binding.material_revision["raw_after"].items()}
            if projected_hashes == accepted:
                changed = [name for name in documents if hashes[name] != result["raw_after"][name]]
                result.update(classification="EQUIVALENT" if changed else "EXACT",
                    reason_code="APPROVED_EXECUTION_FIELDS" if changed else "RAW_UNCHANGED",
                    rule_version="plan-execution-v1", required_action="NONE", affected_targets=changed,
                    content_digest={name: compare_material(raw, raw).content_sha256 for name, raw in projected.items()})
                return result
        comparisons = {}
        for document in documents:
            try:
                before = archive.get(hashes[document])
            except FileNotFoundError:
                # Unchanged legacy documents can be identified without
                # implicitly creating a baseline. Changed ones cannot.
                if result["raw_after"][document] != hashes[document]:
                    result["reason_code"] = "BASELINE_MISSING"
                    return result
                before = current[document]
            comparisons[document] = compare_material(before, current[document])
        result["content_digest"] = {doc: item.content_sha256 for doc, item in comparisons.items()}
        result["affected_targets"] = [doc for doc, item in comparisons.items() if item.classification != "EXACT"]
        for classification in ("UNKNOWN", "REVIEW_REQUIRED", "EQUIVALENT", "EXACT"):
            found = [item for item in comparisons.values() if item.classification == classification]
            if found:
                result.update(classification=classification, reason_code=found[0].reason_code,
                              required_action={"UNKNOWN": "REVIEW", "REVIEW_REQUIRED": "REVIEW",
                                               "EQUIVALENT": "REFRESH_EQUIVALENT", "EXACT": "NONE"}[classification])
                break
        if (binding is not None and result["raw_after"] == binding.material_revision["raw_after"]
                and result["classification"] in {"EXACT", "EQUIVALENT"}):
            result.update(required_action="NONE", reason_code="MATERIAL_REVISION_CURRENT")
    except (OSError, TypeError, ValueError):
        # Failure is diagnostic, never an equivalent-format approval.
        result.update(classification="UNKNOWN", reason_code="BASELINE_UNVERIFIABLE",
                      required_action="REVIEW")
    return result


def cmd_status(req_dir: Path, as_json: bool, schema_version: int = 1) -> int:
    try:
        reviews = req_dir / "reviews"
        reviews.mkdir(parents=True, exist_ok=True)
        with PlanStore(reviews).gate_snapshot() as snapshot:
            return _cmd_status_locked(
                req_dir, as_json, _dynamic_state_from_snapshot(snapshot, req_dir=req_dir), schema_version)
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 文档门禁锁不可用: {exc}")
        return 3


def cmd_material_refresh(req_dir, stage, expected_revision, source_hashes, as_json):
    try:
        if stage not in STAGES:
            raise ValueError("unknown material stage")
        with PlanStore(req_dir / "reviews").locked_view(req_dir) as view:
            snapshot = view.snapshot(for_material_recovery=True)
            state = _dynamic_state_from_snapshot(snapshot, req_dir=req_dir)
            if state is not None and state.state != "FROZEN":
                raise ValueError("BASELINE_MISSING: dynamic plan is not frozen")
            service = _document_materials(req_dir, view, state)
            dependencies = service.capture_dependencies(stage)
            view.recover_material(lambda target: service._context(target,
                _stage_documents(target, state)))
            state = _dynamic_state_from_snapshot(view.snapshot(), req_dir=req_dir)
            service = _document_materials(req_dir, view, state)
            for upstream in _effective_stage_spec(stage, state)["upstream"]:
                if stage_frozen(req_dir, upstream, state)[0] != "FROZEN":
                    raise ValueError("SOURCE_CHANGED: prerequisite is not frozen")
            if expected_revision is None and stage_frozen(req_dir, stage, state)[0] != "FROZEN":
                raise ValueError("BASELINE_MISSING: legacy baseline must match current original approval")
            status, binding = service.refresh(stage,
                expected_revision=expected_revision, source_hashes=source_hashes, dependencies=dependencies)
            current = _dynamic_state_from_snapshot(view.snapshot(), req_dir=req_dir)
            if stage_frozen(req_dir, stage, current)[0] != "FROZEN":
                raise ValueError("SOURCE_CHANGED: stage dependencies are no longer frozen")
            result = {"status": status, "stage": stage, "revision": binding.binding_digest,
                      "approved_origin": {"gate_sha256": binding.gate_digest}}
        print(json.dumps(result, ensure_ascii=False, indent=2) if as_json
              else f"{stage} {status}: {binding.binding_digest}")
        return 0
    except (OSError, PlanInvalid, TypeError, ValueError) as exc:
        print(f"✗ 等价刷新拒绝: {exc}")
        return 3


def _cmd_status_locked(req_dir: Path, as_json: bool, dynamic_state=None, schema_version: int = 1) -> int:
    report = {}
    lines = [f"需求目录: {req_dir.name}"]
    for stage in STAGES:
        st, why = stage_frozen(req_dir, stage, dynamic_state)
        report[stage] = {"state": st, "detail": why}
        if schema_version == 2:
            report[stage]["material"] = _stage_material_status(req_dir, stage, dynamic_state)
        lines.append(f"  {stage:<6s} {st:<10s} {why}")
    for extra in ("线上联调功能验证清单.md", "终稿.md"):
        p = req_dir / extra
        if p.is_file():
            ph = len(_placeholders(_read(p) or ""))
            report[extra] = {"exists": True, "placeholders": ph}
            lines.append(f"  {extra} 存在（占位符 {ph} 处）")
    if as_json:
        print(json.dumps({"schema_version": 2, "stages": report} if schema_version == 2 else report,
                         ensure_ascii=False, indent=2))
    else:
        print("\n".join(lines))
    return 0


def _dynamic_runtime(req_dir: Path, base_ref: str):
    root = _repo_root(req_dir)
    if root is None:
        raise ValueError("无法定位 Git 仓库根")
    base_commit = resolve_base_commit(root, base_ref)
    store = PlanStore(req_dir / "reviews")
    snapshot = store.snapshot()
    raw_plan = snapshot.get("artifact-plan.json")
    if raw_plan is None:
        return root, base_commit, store, None, None
    plan = load_plan_bytes(raw_plan)
    input_digest = git_plan_input_digest(plan, base_commit)
    state = read_frozen_dynamic_state(store, input_digest,
        verify_source_map=lambda mapping: _verify_composition(req_dir, mapping))
    return root, base_commit, store, plan, state


def _dynamic_state_from_snapshot(snapshot: dict[str, bytes], *, req_dir=None):
    """Validate the dynamic state captured by PlanStore.gate_snapshot()."""
    if not snapshot:
        return None
    try:
        raw_plan = snapshot.get("artifact-plan.json")
        raw_credential = snapshot.get("artifact-plan.gate.json")
        if raw_plan is None:
            if snapshot and all(name.endswith(".plan-binding.json") for name in snapshot):
                bindings = [load_binding_bytes(raw) for raw in snapshot.values()]
                if all(isinstance(item, MaterialStageBinding) and item.binding_kind == "material-only"
                       and item.stage + ".plan-binding.json" in snapshot for item in bindings):
                    return None
            return DynamicPlanState("INVALID", "orphan credential or binding")
        plan = load_plan_bytes(raw_plan)
        if raw_credential is None:
            if any(name.endswith(".plan-binding.json") for name in snapshot):
                return DynamicPlanState("INVALID", "binding without credential", plan)
            return DynamicPlanState("PREPARED", "plan has no freeze credential", plan)
        credential = load_credential_bytes(raw_credential)
    except (KeyError, TypeError, ValueError) as exc:
        return DynamicPlanState("INVALID", str(exc))

    class CapturedSnapshot:
        def snapshot(self) -> dict[str, bytes]:
            return dict(snapshot)

    verifier = (lambda mapping: _verify_composition(req_dir, mapping)) if req_dir is not None else None
    return read_frozen_dynamic_state(CapturedSnapshot(), credential.input_digest, verify_source_map=verifier)


def _bind_dynamic_gate(req_dir: Path, prior_state, stage: str, view, *, material_mode=False, closeout=False) -> int:
    """Bind the published approval while still holding its original plan lock."""
    if (prior_state.state != "FROZEN" or prior_state.plan is None
            or prior_state.credential is None):
        print("✗ gate 已写入，但 ArtifactPlan 状态不可绑定")
        return 3
    if not participating_documents(prior_state.plan, stage):
        return 0
    try:
        consumers = view.consumer_digest
        current = _dynamic_state_from_snapshot(view.snapshot(), req_dir=req_dir)
        if (current is None or current.state != 'FROZEN' or current.plan != prior_state.plan
                or current.credential != prior_state.credential):
            raise ValueError('ArtifactPlan changed before approved material baseline')
        states = evaluate_stage_states(current, _dynamic_snapshots(req_dir, current))
        group = ARTIFACT_REGISTRY.get_group(stage)
        ancestors = {parent for artifact in group.artifact_ids
                     for parent in current.plan.by_id(artifact).resolved_prerequisites}
        if any(states[parent] != 'BOUND' for parent in ancestors):
            raise ValueError('SOURCE_CHANGED: a required prerequisite is not bound')
        digest, documents, fingerprints = _current_plan_gate_inputs(req_dir, current, stage, verify_material=False)
        raw_approval = view.read_closeout() if closeout else view.read_gate(stage)
        approved = json.loads(raw_approval) if raw_approval is not None else None
        if not isinstance(approved, dict) or approved.get('upstream_fingerprints') != fingerprints:
            raise ValueError('SOURCE_CHANGED: current prerequisites differ from the published approval')
        candidate = bind_stage(current.plan, current.credential, stage, gate_digest=digest,
            doc_hashes=documents, prerequisite_fingerprints=fingerprints)
        if material_mode:
            for previous in current.bindings:
                if previous.stage == stage:
                    raw = json.dumps(asdict(previous), ensure_ascii=False, sort_keys=True,
                                     separators=(',', ':')).encode('utf-8')
                    MaterialArchive(req_dir / 'reviews').put(raw, expected_sha256=hashlib.sha256(raw).hexdigest())
            # A failed material publication cannot leave a legacy binding.
            _document_materials(req_dir, view, current).baseline(stage, origin_binding=candidate)
        else:
            raw = json.dumps(asdict(candidate), ensure_ascii=False, sort_keys=True,
                             separators=(',', ':')).encode('utf-8')
            view.publish({stage + '.plan-binding.json': raw}, expected_consumers=consumers)
        updated = _dynamic_state_from_snapshot(view.snapshot(), req_dir=req_dir)
        if (updated is None or updated.state != 'FROZEN'
                or evaluate_stage_states(updated, _dynamic_snapshots(req_dir, updated)).get(stage) != 'BOUND'):
            raise ValueError('material stage changed before final binding verification')
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ gate 已写入，但 ArtifactPlan binding 失败: {exc}")
        return 3
    return 0


def _current_plan_gate_inputs(req_dir: Path, state, stage: str, *, verify_material=True):
    if state.plan is None:
        raise ValueError("动态计划不可用")
    documents = participating_documents(state.plan, stage)
    if not documents:
        return None, {}, {}
    gate_digest, current_docs = _current_plan_gate_inputs_no_parents(
        req_dir, state, stage, verify_material=verify_material)
    parent_fingerprints = {
        parent: _dynamic_stage_fingerprint(req_dir, state, parent)
        for parent in participating_prerequisites(state.plan, stage)
    }
    material = next((item for item in state.bindings if item.stage == stage
                     and isinstance(item, MaterialStageBinding)
                     and item.material_revision.get("dependency_identity") is not None), None)
    if verify_material and material is not None:
        if _current_material_binding(req_dir, stage, state) != material:
            raise ValueError("consumed approval is no longer current")
        # Preserve the original parent authority only after independently
        # recomputing all consumed slices from archived approved materials.
        parent_fingerprints = dict(material.prerequisite_fingerprints)
    return gate_digest, current_docs, parent_fingerprints


def _dynamic_stage_fingerprint(req_dir: Path, state, stage: str) -> str:
    if state.plan is None or state.credential is None:
        return "0" * 64
    matching = [binding for binding in state.bindings if binding.stage == stage]
    if len(matching) != 1:
        return "0" * 64
    try:
        gate_digest, documents = _current_plan_gate_inputs_no_parents(
            req_dir, state, stage)
    except (OSError, PlanInvalid, ValueError):
        return "0" * 64
    authority = matching[0]
    if isinstance(authority, MaterialStageBinding):
        authority = load_binding_bytes(json.dumps(authority.material_revision["origin_binding"],
            ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8"))
    payload = {
        "stage": stage,
        "gate_digest": gate_digest,
        "doc_hashes": documents,
        "binding_digest": authority.binding_digest,
        "credential_digest": state.credential.credential_digest,
    }
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True,
        separators=(",", ":")).encode("utf-8")).hexdigest()


def _current_plan_gate_inputs_no_parents(req_dir: Path, state, stage: str, *, verify_material=True):
    if state.plan is None:
        raise ValueError("动态计划不可用")
    documents = _stage_source_names(state.plan, stage)
    if not documents:
        return None, {}
    gate_path = req_dir / "reviews" / f"{stage}.gate.json"
    raw_gate = _read_review_bytes(gate_path)
    try:
        gate = json.loads(raw_gate.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"{stage} gate 不可读") from exc
    recorded = gate.get("doc_hashes") if isinstance(gate, dict) else None
    if (not isinstance(gate, dict) or gate.get("status") != "PASS"
            or not isinstance(recorded, dict)):
        raise ValueError(f"{stage} gate 不是有效 PASS")
    _require_gate_package(req_dir, gate)
    mapped = _capture_mapped_stage(req_dir, stage, state)
    if mapped is not None and (set(recorded) != set(documents)
                               or gate.get('source_mapping_digest') != mapped[1].mapping_digest):
        raise ValueError('SOURCE_CHANGED: Gate does not bind the current mapping and physical source set')
    material_gate_identity = hashlib.sha256(raw_gate).hexdigest()
    if stage == "计划" and (req_dir / "reviews/计划.closeout.json").exists():
        material_gate_identity = hashlib.sha256(raw_gate + b"\0" + _read_review_bytes(
            req_dir / "reviews/计划.closeout.json")).hexdigest()
    material = next((item for item in state.bindings if item.stage == stage
                     and isinstance(item, MaterialStageBinding)
                     and item.gate_digest == material_gate_identity), None) if verify_material else None
    if material is not None:
        if _current_material_binding(req_dir, stage, state) != material:
            raise ValueError("material revision changed during stage snapshot")
    lifecycle_path = req_dir / "reviews" / f"{stage}.issue-lifecycle.json"
    if lifecycle_path.exists() or lifecycle_path.is_symlink():
        lifecycle = LifecycleGateStore(
            req_dir / "reviews", stage).load_lifecycle()
        binding = gate.get("lifecycle_snapshot_digest")
        if lifecycle is None or not isinstance(binding, str):
            raise ValueError(f"{stage} gate 未绑定 Issue 生命周期")
        project_pass_gate(
            lifecycle, stage=stage, status="PASS",
            lifecycle_snapshot_digest=binding,
            gate_digest=hashlib.sha256(raw_gate).hexdigest())
    identity_parts = [raw_gate]
    if stage == "计划":
        closeout_path = req_dir / "reviews" / "计划.closeout.json"
        if closeout_path.exists() or closeout_path.is_symlink():
            raw_closeout = _read_review_bytes(closeout_path)
            try:
                closeout = json.loads(raw_closeout.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise ValueError("计划 closeout 不可读") from exc
            final_hashes = closeout.get("doc_hashes") if isinstance(
                closeout, dict) else None
            if (not isinstance(closeout, dict)
                    or closeout.get("status") != "PASS"
                    or closeout.get("plan_gate_sha256") != hashlib.sha256(
                        raw_gate).hexdigest()
                    or not isinstance(final_hashes, dict)
                    or set(final_hashes) != set(documents)):
                raise ValueError("计划 closeout 不是有效 PASS")
            current_docs = {
                document: hashlib.sha256(
                    _read_review_bytes(req_dir / document)).hexdigest()
                for document in documents
            }
            if current_docs != final_hashes and material is None:
                raise ValueError("计划收口后文档哈希失配")
            if material is not None:
                current_docs = dict(material.doc_hashes)
            identity_parts.append(raw_closeout)
        elif gate.get("execution_baseline_hashes") is not None:
            baseline = gate.get("execution_baseline_hashes")
            if not isinstance(baseline, dict) or set(baseline) != set(documents):
                raise ValueError("计划执行基线未覆盖参与文档")
            current_docs = {
                document: _plan_baseline_hashes(req_dir).get(document)
                for document in documents
            }
            if (current_docs != baseline and material is None) or any(
                    not isinstance(value, str) for value in current_docs.values()):
                raise ValueError("计划执行基线哈希失配")
            if material is not None:
                current_docs = dict(material.doc_hashes)
        else:
            current_docs = {}
    else:
        current_docs = {}
    if not current_docs:
        mapped_materials = _read_stage_materials(req_dir, stage, state, mapped) if mapped is not None else None
        for document in documents:
            raw = (mapped_materials[document] if mapped_materials is not None else
                   _read_review_bytes(req_dir / document))
            digest = hashlib.sha256(raw).hexdigest()
            if material is not None and stage != '计划' and digest != material.material_revision['raw_after'][document]:
                raise ValueError(f'SOURCE_CHANGED: {document} changed during approved material verification')
            if recorded.get(document) != digest and material is None:
                raise ValueError(f"{document} 与 gate 哈希失配")
            current_docs[document] = recorded[document] if material is not None else digest
    identity = hashlib.sha256(b"\x00".join(identity_parts)).hexdigest()
    return identity, current_docs


def _dynamic_snapshots(req_dir: Path, state) -> dict[str, dict[str, object]]:
    if state.plan is None:
        return {}
    snapshots = {}
    bound = {binding.stage for binding in state.bindings}
    for stage in ARTIFACT_REGISTRY.groups:
        if stage not in bound:
            continue
        try:
            gate_digest, documents, parents = _current_plan_gate_inputs(
                req_dir, state, stage)
            if gate_digest is None:
                continue
            snapshots[stage] = {
                "gate_digest": gate_digest,
                "doc_hashes": documents,
                "prerequisite_fingerprints": parents,
            }
            material = next((item for item in state.bindings if item.stage == stage
                             and isinstance(item, MaterialStageBinding)
                             and item.material_revision.get("dependency_identity") is not None), None)
            if material is not None:
                snapshots[stage]["verified_consumption"] = VerifiedConsumption(
                    material.binding_digest, material.material_revision["dependency_identity"]["content_digest"])
        except (OSError, PlanInvalid, ValueError):
            snapshots[stage] = {
                "gate_digest": "0" * 64,
                "doc_hashes": {doc: "0" * 64 for doc in
                               participating_documents(state.plan, stage)},
                "prerequisite_fingerprints": {
                    parent: "0" * 64 for parent in
                    participating_prerequisites(state.plan, stage)},
            }
    return snapshots


def _dynamic_payload(req_dir: Path, state) -> dict[str, object]:
    payload: dict[str, object] = {"state": state.state, "reason": state.reason}
    if state.plan is not None:
        payload["plan"] = asdict(state.plan)
    if isinstance(state.plan, ComposedArtifactPlan):
        mapping = load_source_map(state.plan.source_map)
        payload['capability_diagnostics'] = [{
            'artifact_id': binding['artifact_id'], 'client': binding['client'], 'entry': binding['entry'],
            'contract_path': binding['contract_path'], 'contract_sha256': binding['contract_sha256'],
            'configured': 'CURRENT' if state.state in {'PREPARED', 'FROZEN'} else 'UNVERIFIED',
            'visible': 'UNOBSERVED', 'actually_used': 'UNOBSERVED',
        } for binding in mapping.capability_bindings]
    if state.credential is not None:
        payload["credential"] = asdict(state.credential)
    if state.plan is not None and state.state == "FROZEN":
        binding_states = evaluate_stage_states(
            state, _dynamic_snapshots(req_dir, state))
        payload["binding_states"] = binding_states
        payload["effective_stage_states"] = effective_stage_states(
            state.plan, binding_states)
    return payload


def _print_dynamic(payload: dict[str, object], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"ArtifactPlan: {payload['state']} — {payload['reason']}")
        for stage, value in payload.get("effective_stage_states", {}).items():
            print(f"  {stage}: {value}")


def _verify_composition(req_dir, mapping):
    root, package = _package_locations(req_dir)
    relative = req_dir.absolute().relative_to(root.absolute()).as_posix()
    if mapping.package_ref != relative or package.package_ref != relative:
        raise ValueError('ROOT_MISMATCH: source mapping belongs to another design package')
    epoch = capture_composition(root, mapping)
    if epoch.package_revision != package.revision:
        raise ValueError('SOURCE_CHANGED: package revision changed while verifying composition')
    return epoch


def cmd_plan_prepare(req_dir: Path, base_ref: str, route: str,
                     overlays: tuple[str, ...], as_json: bool, *, source_map_stdin=False) -> int:
    try:
        root = _repo_root(req_dir)
        if root is None:
            raise ValueError("无法定位 Git 仓库根")
        base = resolve_base_commit(root, base_ref)
        mapping = load_source_map(sys.stdin.buffer.read(MAX_LAYOUT_BYTES + 1)) if source_map_stdin else None
        state = prepare_git_current_plan(
            PlanStore(req_dir / "reviews"), root, base, route,
            scan_scope=scan_negative_risks, required_overlays=overlays, source_map=mapping,
            verify_source_map=lambda current: _verify_composition(req_dir, current))
        _print_dynamic(_dynamic_payload(req_dir, state), as_json)
        return 0 if state.state == "PREPARED" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan prepare 失败: {exc}")
        return 3


def cmd_plan_freeze(req_dir: Path, base_ref: str, as_json: bool) -> int:
    try:
        root, base, store, plan, _state = _dynamic_runtime(req_dir, base_ref)
        if plan is None:
            raise ValueError("没有 PREPARED ArtifactPlan")
        state = freeze_git_current_plan(
            store, root, base, git_plan_input_digest(plan, base),
            scan_scope=scan_negative_risks,
            verify_source_map=lambda mapping: _verify_composition(req_dir, mapping),
            frozen_at=datetime.now().isoformat(timespec="seconds"))
        _print_dynamic(_dynamic_payload(req_dir, state), as_json)
        return 0 if state.state == "FROZEN" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan freeze 失败: {exc}")
        return 3


def cmd_plan_bind(req_dir: Path, base_ref: str, stage: str, as_json: bool) -> int:
    try:
        root, base, store, plan, state = _dynamic_runtime(req_dir, base_ref)
        if plan is None or state is None or state.state != "FROZEN":
            raise ValueError("ArtifactPlan 未冻结或已失效")
        if isinstance(plan, ComposedArtifactPlan):
            raise ValueError('组合计划必须通过当前外部来源的阶段门禁建立绑定')
        documents = participating_documents(plan, stage)
        if not documents:
            payload = _dynamic_payload(req_dir, state)
            _print_dynamic(payload, as_json)
            return 0
        current_states = evaluate_stage_states(
            state, _dynamic_snapshots(req_dir, state))
        parents = participating_prerequisites(plan, stage)
        if any(current_states[parent] != "BOUND" for parent in parents):
            raise ValueError("真实前置 stage 尚未全部 BOUND")
        gate_digest, doc_hashes, parent_fingerprints = _current_plan_gate_inputs(
            req_dir, state, stage)
        if gate_digest is None:
            raise ValueError("跳过 stage 不应建立 binding")
        rebound = bind_frozen_stage(
            store, git_plan_input_digest(plan, base), stage,
            gate_digest=gate_digest, doc_hashes=doc_hashes,
            prerequisite_fingerprints=parent_fingerprints)
        _print_dynamic(_dynamic_payload(req_dir, rebound), as_json)
        binding_states = _dynamic_payload(req_dir, rebound).get("binding_states", {})
        return 0 if binding_states.get(stage) == "BOUND" else 3
    except (OSError, PlanInvalid, TypeError, ValueError, RuntimeError) as exc:
        print(f"✗ ArtifactPlan bind 失败: {exc}")
        return 3


