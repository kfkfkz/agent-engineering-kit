UI_STATES = ["加载中", "空态", "错误", "禁用", "成功"]

# 人工签核阶段：评审权在人，doc-gate 只落哈希凭证
HUMAN_SIGNOFF = {
    "需求分析": (r"冻结状态[:：]\s*(已冻结|未冻结)", "已冻结"),
    "业务流程设计": (r"评审结论[:：]\s*(通过|未评审|未通过)", "通过"),
}


# ══════════════════════════ 基础工具 ══════════════════════════

def _read(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def _sha256(path: Path) -> str | None:
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


def _block(text: str, pos: int) -> str:
    """从标题位置取到下一个同级或更高级标题前的文本块。"""
    ends = [e for e in (text.find("\n### ", pos + 1),
                         text.find("\n## ", pos + 1)) if e != -1]
    end = min(ends) if ends else len(text)
    return text[pos:end]


def _placeholders(text: str) -> list[str]:
    return re.findall(r"〈[^〉]+〉", text)


def _repo_root(start: Path) -> Path | None:
    for p in [start, *start.parents]:
        if (p / ".repo-memory-kit").is_dir() or (p / ".git").exists() or (p / ".svn").exists():
            return p
    return None


def _load_policy(root: Path | None) -> dict:
    policy = dict(DEFAULT_POLICY)
    if not root:
        return policy
    f = root / ".repo-memory-kit" / "doc-policy.json"
    if not f.exists():
        return policy
    text = _read(f)
    if text is None:
        raise PolicyError(f"无法读取 {f}")
    try:
        user = json.loads(text)
    except json.JSONDecodeError as e:
        raise PolicyError(f"JSON 语法错误（第 {e.lineno} 行第 {e.colno} 列）") from e
    if not isinstance(user, dict):
        raise PolicyError("顶层必须是 JSON object")
    unknown = sorted(set(user) - set(DEFAULT_POLICY))
    if unknown:
        raise PolicyError(f"未知字段: {', '.join(unknown)}")
    for key, value in user.items():
        if type(value) is not int or value < 0:
            raise PolicyError(f"{key} 必须是非负整数")
        policy[key] = value
    if policy["max_iterations"] < 1:
        raise PolicyError("max_iterations 必须大于等于 1")
    return policy


# ══════════════════════════ 解析器 ══════════════════════════

def parse_scenarios(text: str) -> dict[str, dict]:
    """场景 N → {前置, 操作, 结果}（值为原文，空串=缺失）。"""
    out = {}
    for m in re.finditer(r"^###\s*场景\s*(\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        item = {}
        for key in ("前置", "操作", "结果"):
            km = re.search(rf"\*\*{key}\*\*：(.*)", block)
            item[key] = km.group(1).strip() if km else ""
        out[m.group(1)] = item
    return out


def parse_a_items(text: str) -> dict[str, dict]:
    """A-ID → {scenarios: [n], text}（验收项）。"""
    out = {}
    for m in re.finditer(r"^- \[[ x]\]\s*(A\d+)：(.*)$", text, re.M):
        rest = m.group(2).strip()
        out[m.group(1)] = {"scenarios": re.findall(r"场景\s*(\d+)", rest), "text": rest}
    return out


def parse_f_items(text: str) -> dict[str, dict]:
    """F-ID → {covers: [A-ID]}（概要设计功能点）。"""
    out = {}
    for m in re.finditer(r"^###\s*(F\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        cov = re.search(r"覆盖验收项：\s*(.+)", block)
        out[m.group(1)] = {"covers": re.findall(r"A\d+", cov.group(1)) if cov else []}
    return out


def parse_d_items(text: str) -> dict[str, dict]:
    """D-ID → {f: [F-ID], a: [A-ID]}（详细设计落点）。"""
    out = {}
    for m in re.finditer(r"^###\s*(D\d+)：(.*)$", text, re.M):
        refm = re.search(r"（对应\s*([^）]+)）", m.group(2))
        refs = refm.group(1) if refm else ""
        out[m.group(1)] = {"f": re.findall(r"F\d+", refs), "a": re.findall(r"A\d+", refs)}
    return out


def parse_tc_items(text: str) -> dict[str, dict]:
    """TC-ID → {accepts: [A-ID]}（测试方案用例清单行）。"""
    out = {}
    for m in re.finditer(r"^\|\s*(TC-\d+)\s*\|(.+)$", text, re.M):
        cells = [c.strip() for c in m.group(2).split("|")]
        accepts = re.findall(r"A\d+", cells[1]) if len(cells) > 1 else []
        out[m.group(1)] = {"accepts": accepts}
    return out


def parse_t_items(text: str) -> dict[str, dict]:
    """T-ID → {designs: [D/TC-ID], has_scope, has_verify}（任务清单）。"""
    out = {}
    for m in re.finditer(r"^###\s*(T\d+)：(.*)$", text, re.M):
        block = _block(text, m.start())
        des = re.search(r"对应设计：\s*(.+)", block)
        scope = re.search(r"预计修改范围：\s*(.+)", block)
        verify = re.search(r"验证方式：\s*(.+)", block)
        out[m.group(1)] = {
            "designs": re.findall(r"(?:D\d+|TC-\d+)", des.group(1)) if des else [],
            "has_scope": bool(scope and _placeholders(scope.group(1)) == []
                            and scope.group(1).strip() not in ("", "无")),
            "has_verify": bool(verify and _placeholders(verify.group(1)) == []
                               and verify.group(1).strip() != ""),
        }
    return out


def parse_page_items(text: str) -> dict[str, dict]:
    """PAGE-ID → {refs, states_ok}（UI设计页面清单）。"""
    out = {}
    for m in re.finditer(r"^###\s*(PAGE-\d+)：(.*)$", text, re.M):
        refm = re.search(r"（对应\s*([^）]+)）", m.group(2))
        refs = refm.group(1) if refm else ""
        block = _block(text, m.start())
        has_na = "不适用" in block
        states_ok = has_na or all(s in block for s in UI_STATES)
        out[m.group(1)] = {"refs": re.findall(r"(?:F\d+|A\d+)", refs), "states_ok": states_ok}
    return out


def req_freeze_state(text: str) -> str:
    m = re.search(r"冻结状态[:：]\s*(已冻结|未冻结)", text or "")
    return m.group(1) if m else "未记录"


# ══════════════════════════ 冻结状态 ══════════════════════════

def _stage_fingerprint(req_dir: Path, stage: str) -> str | None:
    """上游阶段的指纹 = digest(status + doc_hashes + 其上游指纹)——
    任何上游重冻结（内容或其上游变化）都会改变指纹，驱动下游递归失效
    （第八轮审计 P1：此前只校验本阶段哈希，上游 v2 重冻结后旧下游仍 FROZEN）。"""
    # A gate record is not a current credential by itself. Validate the stage
    # first so an edited-but-not-refrozen upstream invalidates descendants too.
    state, _detail = stage_frozen(req_dir, stage)
    if state != "FROZEN":
        return None
    gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
    if gate is None:
        return None
    try:
        g = json.loads(gate)
    except json.JSONDecodeError:
        return None
    ident = {"status": g.get("status"),
             "doc_hashes": g.get("doc_hashes"),
             "upstream_fingerprints": g.get("upstream_fingerprints")}
    return hashlib.sha256(
        json.dumps(ident, ensure_ascii=False, sort_keys=True).encode()).hexdigest()


def stage_frozen(req_dir: Path, stage: str) -> tuple[str, str]:
    """返回 (状态, 说明)。状态: FROZEN / DRAFT / BLOCKED / NOT_GATED / MISSING。

    FROZEN = gate.json PASS 且文档哈希一致 且 上游指纹与冻结时一致；
    上游重冻结/本阶段改动 → DRAFT（下游需重过门禁——递归失效）。
    """
    if stage in HUMAN_SIGNOFF:
        # 人工签核阶段（需求分析/业务流程设计）：文本签核不是凭证——必须有
        # gate.json 绑定内容哈希，签核后改动会被哈希检出
        doc = STAGES[stage]["docs"][0]
        if not (req_dir / doc).is_file():
            return "MISSING", f"{doc} 不存在"
        gate = _read(req_dir / "reviews" / f"{stage}.gate.json")
        if gate is None:
            sign_re, _want = HUMAN_SIGNOFF[stage]
            m = re.search(sign_re, _read(req_dir / doc) or "")
            signed = m.group(1) if m else "未记录"
            return "DRAFT", (f"未过 doc-gate freeze（签核状态：{signed}——"
                            f"文本不构成凭证）")
        try:
            g = json.loads(gate)
        except json.JSONDecodeError:
            return "DRAFT", f"{stage}.gate.json 损坏"
        if g.get("status") != "PASS":
            return "DRAFT", f"{stage}最近判定 {g.get('status')}"
        want = (g.get("doc_hashes") or {}).get(doc)
        cur = _sha256(req_dir / doc)
        if want != cur:
            return "DRAFT", f"{doc} 签核后有改动（哈希失配）——需人工重审并重新 freeze"
        recorded = g.get("upstream_fingerprints") or {}
        for up in STAGES[stage]["upstream"]:
            cur_fp = _stage_fingerprint(req_dir, up)
            if cur_fp is None or recorded.get(up) != cur_fp:
                return "DRAFT", f"上游 {up} 已重新冻结（指纹失配）——需重新签核"
        return "FROZEN", f"gate.json 通过（{g.get('approved_by', '未知')} 签核）"

    gate_file = req_dir / "reviews" / f"{stage}.gate.json"
    data = _read(gate_file)
    if data is None:
        return "NOT_GATED", "无 gate.json（未过门禁）"
    try:
        gate = json.loads(data)
    except json.JSONDecodeError:
        return "DRAFT", "gate.json 损坏"
    if gate.get("status") == "BLOCKED":
        return "BLOCKED", "最近判定 BLOCKED（人工介入）"
    if gate.get("status") != "PASS":
        return "DRAFT", f"最近判定 {gate.get('status')}"
    for doc, want in (gate.get("doc_hashes") or {}).items():
        cur = _sha256(req_dir / doc)
        if cur is None:
            return "DRAFT", f"{doc} 已不存在"
        if cur != want:
            return "DRAFT", f"{doc} 冻结后有改动（哈希失配）"
    # 上游指纹核验（第八轮审计 P1）：任一上游重冻结 → 本阶段失效，需重过门禁
    recorded = gate.get("upstream_fingerprints") or {}
    for up in STAGES[stage]["upstream"]:
        cur_fp = _stage_fingerprint(req_dir, up)
        if cur_fp is None:
            return "DRAFT", f"上游 {up} 的 gate 凭证缺失"
        if recorded.get(up) != cur_fp:
            return "DRAFT", (f"上游 {up} 已重新冻结（指纹失配）——"
                            f"本阶段需重过门禁")
    return "FROZEN", f"gate.json PASS（iteration {gate.get('iteration')}）"


# ══════════════════════════ 硬校验引擎 ══════════════════════════

class Checks:
    def __init__(self, stage: str):
        self.stage = stage
        self.items: list[dict] = []

    def add(self, group: str, name: str, ok: bool, detail: str = "") -> None:
        self.items.append({"group": group, "name": name,
                           "status": "PASS" if ok else "FAIL", "detail": detail})

    @property
    def fails(self) -> list[dict]:
        return [c for c in self.items if c["status"] == "FAIL"]

    def to_dict(self) -> dict:
        return {"stage": self.stage, "checks": self.items,
                "summary": {"pass": len(self.items) - len(self.fails),
                            "fail": len(self.fails)}}


def _check_structure(c: Checks, doc: str, text: str, required: list[str]) -> None:
    headers = re.findall(r"^##\s+(.+)$", text, re.M)
    def _norm(h: str) -> str:
        h = re.split(r"[（(]", h.strip())[0].strip()
        return re.sub(r"^\d+(\.\d+)*[.、\s]*", "", h)   # 剥编号前缀（"1. 简介"→"简介"）
    have = {_norm(h) for h in headers}
    missing = [s for s in required if s not in have]
    c.add("structure", f"必填章节：{doc}",
          not missing, "缺失: " + "、".join(missing) if missing else "")


def _check_placeholders(c: Checks, doc: str, text: str) -> None:
    ph = _placeholders(text)
    c.add("placeholder", f"占位符已替换：{doc}", not ph,
          f"残留 {len(ph)} 处: {'、'.join(ph[:3])}…" if ph else "")


def run_checks(req_dir: Path, stage: str) -> Checks:
    """对一个阶段跑全部硬校验（含上游冻结与需求意图检查）。"""
    c = Checks(stage)
    spec = STAGES[stage]

    # ── 上游冻结 ──
    for up in spec["upstream"]:
        st, why = stage_frozen(req_dir, up)
        c.add("upstream", f"上游已冻结：{up}", st == "FROZEN", why)

    # ── 需求意图（薄输入拒绝——任何阶段都校验最上游，需求分析阶段本身也检查）──
    req_text = _read(req_dir / "需求分析.md")
    if req_text is not None:
        scen = parse_scenarios(req_text)
        ok_scen = bool(scen) and all(
            s["前置"] and s["操作"] and s["结果"]
            and not _placeholders(s["前置"] + s["操作"] + s["结果"])
            for s in scen.values())
        c.add("intent", "需求场景完整（前置/操作/结果 已填）", ok_scen,
              "场景为空或 Given/When/Then 未填写/仍为占位符" if not ok_scen else "")
        a_items = parse_a_items(req_text)
        ok_a = bool(a_items) and all(not _placeholders(v["text"]) for v in a_items.values())
        c.add("intent", "验收项非占位", ok_a,
              "验收项为空或仍为占位符" if not ok_a else "")

    # ── 本阶段文档 ──
    for doc in spec["docs"]:
        text = _read(req_dir / doc)
        if text is None:
            c.add("structure", f"文档存在：{doc}", False, "文件不存在")
            continue
        _check_structure(c, doc, text, spec["sections"][doc])
        _check_placeholders(c, doc, text)

    # ── 各阶段追踪链 ──
    req_a = parse_a_items(req_text) if req_text else {}

    if stage == "概要设计":
        text = _read(req_dir / "概要设计.md") or ""
        f_items = parse_f_items(text)
        covered = [a for f in f_items.values() for a in f["covers"]]
        dangling = [a for f in f_items.values() for a in f["covers"] if a not in req_a]
        c.add("trace", "每个验收项被 ≥1 功能点覆盖",
              bool(f_items) and set(req_a) <= set(covered),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered))) or '无')}")
        c.add("id", "功能点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "UI设计":
        text = _read(req_dir / "UI设计.md") or ""
        pages = parse_page_items(text)
        c.add("id", "页面清单非空", bool(pages), "无 PAGE 项")
        bad_states = [p for p, v in pages.items() if not v["states_ok"]]
        c.add("ui", "每页状态枚举完整（或 N/A）",
              not bad_states, f"缺状态: {'、'.join(bad_states)}" if bad_states else "")
        f_all = parse_f_items(_read(req_dir / "概要设计.md") or "")
        dangling = [r for v in pages.values() for r in v["refs"]
                    if r not in f_all and r not in req_a]
        c.add("id", "页面引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "详细设计":
        d_items: dict = {}
        for doc in ("详细设计.md", "API设计.md", "数据库设计.md"):
            text = _read(req_dir / doc)
            d_items.update(parse_d_items(text) if text is not None else {})
        f_all = parse_f_items(_read(req_dir / "概要设计.md") or "")
        covered_f = [f for v in d_items.values() for f in v["f"]]
        c.add("trace", "每个功能点有 ≥1 设计落点",
              bool(d_items) and set(f_all) <= set(covered_f),
              f"未落点: {('、'.join(sorted(set(f_all) - set(covered_f))) or '无')}")
        dangling = [r for v in d_items.values() for r in v["f"] + v["a"]
                    if (r.startswith("F") and r not in f_all)
                    or (r.startswith("A") and r not in req_a)]
        c.add("id", "落点引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    if stage == "计划":
        task_text = _read(req_dir / "任务清单.md") or ""
        test_text = _read(req_dir / "测试方案.md") or ""
        t_items = parse_t_items(task_text)
        tc_items = parse_tc_items(test_text)
        d_all: dict = {}
        for doc in ("详细设计.md", "API设计.md", "数据库设计.md"):
            text = _read(req_dir / doc)
            d_all.update(parse_d_items(text) if text is not None else {})

        covered_a = [a for v in tc_items.values() for a in v["accepts"]]
        c.add("trace", "每个验收项有 ≥1 测试用例",
              bool(tc_items) and set(req_a) <= set(covered_a),
              f"未覆盖: {('、'.join(sorted(set(req_a) - set(covered_a))) or '无')}")
        bad_tc = [tc for tc, v in tc_items.items() if not v["accepts"]]
        c.add("id", "用例挂接验收项", not bad_tc,
              f"未挂接: {'、'.join(bad_tc)}" if bad_tc else "")
        bad_t = [t for t, v in t_items.items()
                 if not v["designs"] or not v["has_verify"] or not v["has_scope"]]
        c.add("trace", "每任务绑定设计+验证方式+预计范围", not bad_t,
              f"缺项: {'、'.join(bad_t)}" if bad_t else "")
        dangling = [r for v in t_items.values() for r in v["designs"]
                    if (r.startswith("TC") and r not in tc_items)
                    or (r.startswith("D") and r not in d_all)]
        c.add("id", "任务引用无悬空", not dangling,
              f"悬空: {'、'.join(dangling)}" if dangling else "")

    return c


# ══════════════════════════ gate 判定 ══════════════════════════

VALID_SEVERITIES = ("blocker", "major", "minor")
ISSUE_FIELDS = ("id", "severity", "location", "problem", "required_change")


def _validate_issues(req_dir: Path, stage: str, spec: dict,
                     text: str) -> tuple[list[dict] | None, str]:
    """解析并严格校验 issues.json 内容。返回 (issues 或 None=不可用, 错误说明)。

    P1 完整性修复：绑定被评审文档的 SHA——评审后文档再改动即过期（旧 clean
    review 不能冻结新版本）；stage 必须匹配；severity/schema 非法直接拒绝。
    """
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None, "issues.json 不是合法 JSON"
    if not isinstance(data, dict):
        return None, "issues.json 顶层必须是对象"
    if data.get("stage") != stage:
        return None, f"issues.json 的 stage={data.get('stage')!r} 与门禁阶段 {stage!r} 不符"
    # 评审绑定：记录的 doc_hashes 必须覆盖本阶段全部文档且与当前一致
    recorded = data.get("doc_hashes")
    if not isinstance(recorded, dict) or not recorded:
        return None, ("issues.json 缺 doc_hashes（评审必须记录被评审文档的 "
                      "sha256——防旧评审冻结新版本）")
    for doc in spec["docs"]:
        want = recorded.get(doc)
        cur = _sha256(req_dir / doc) if (req_dir / doc).is_file() else None
        if want is None:
            return None, f"issues.json 的 doc_hashes 未覆盖 {doc}"
        if want != cur:
            return None, (f"{doc} 在评审后有改动（哈希失配）——评审已过期，"
                          f"需对当前版本重新评审")
    issues = data.get("issues")
    if not isinstance(issues, list):
        return None, "issues 必须是数组"
    seen_ids: set[str] = set()
    for i, issue in enumerate(issues):
        if not isinstance(issue, dict):
            return None, f"issues[{i}] 不是对象"
        for field in ISSUE_FIELDS:
            if not str(issue.get(field, "")).strip():
                return None, f"issues[{i}] 缺必填字段 {field}（id/severity/location/problem/required_change）"
        sev = str(issue.get("severity", "")).strip().lower()
        if sev not in VALID_SEVERITIES:
            return None, (f"issues[{i}].severity={sev!r} 非法"
                          f"（只允许 blocker/major/minor）")
        issue["severity"] = sev
        if issue.get("id") in seen_ids:
            return None, f"issues[{i}].id 重复: {issue.get('id')}"
        seen_ids.add(issue.get("id"))
    return issues, ""


def _consecutive_failures(log_file: Path) -> int:
    """从 gate.log 尾部统计**连续**不达标轮数（PASS 清零——P2 修复：
    此前累计全部历史行数，历史 PASS 三次后一次失败即 BLOCKED）。"""
    if not log_file.exists():
        return 0
    count = 0
    for line in reversed(log_file.read_text(encoding="utf-8").splitlines()):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("status") == "PASS":
            break
        count += 1
    return count


def _was_blocked(log_file: Path) -> bool:
    """最近一次判定是否 BLOCKED（BLOCKED 状态由人工介入解除——重跑只有
    PASS 才能解冻，防止自动重试碰运气）。"""
    if not log_file.exists():
        return False
    for line in reversed(log_file.read_text(encoding="utf-8").splitlines()):
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        return entry.get("status") == "BLOCKED"
    return False


def cmd_gate(req_dir: Path, stage: str, no_review: bool, as_json: bool) -> int:
    if stage in HUMAN_SIGNOFF:
        print(f"✗ {stage} 是人工签核阶段：评审权在人（签写评审记录后由 freeze 落哈希凭证）")
        return 3
    spec = STAGES[stage]

    try:
        policy = _load_policy(_repo_root(req_dir))
    except PolicyError as e:
        print(f"✗ 文档策略非法: {e}")
        return 3

    checks = run_checks(req_dir, stage)
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")

    # P1：必审阶段拒绝 --no-review（此前可绕过 AI 评审直接 PASS）
    if no_review and spec["review"] is True:
        print(f"✗ 阶段 {stage} 是必审阶段（review=True），不允许 --no-review")
        return 3

    issues: list[dict] = []
    if not no_review:
        text = _read(reviews_dir / f"{stage}.issues.json")
        if text is None:
            # optional 阶段缺评审文件 = 未做评审，按硬校验判（合法）；
            # 必审阶段缺文件 = 拒绝（硬校验也挂时优先报硬问题）
            if spec["review"] is True and not checks.fails:
                print(f"✗ 阶段 {stage} 需要先跑 AI 评审（reviews/{stage}.issues.json 缺失或损坏）")
                return 3
        else:
            issues, err = _validate_issues(req_dir, stage, spec, text)
            if issues is None:
                if not checks.fails:
                    print(f"✗ 评审不可用: {err}")
                    return 3
                issues = []

    upstream_issues = [i for i in issues if i.get("upstream")]
    counted = [i for i in issues if not i.get("upstream")]
    n_blocker = sum(1 for i in counted if i["severity"] == "blocker")
    n_major = sum(1 for i in counted if i["severity"] == "major")
    n_minor = sum(1 for i in counted if i["severity"] == "minor")

    log_file = reviews_dir / f"{stage}.gate.log"
    consecutive = _consecutive_failures(log_file)
    was_blocked = _was_blocked(log_file)

    hard_fail = checks.fails
    over = (n_blocker > policy["max_blocker"] or n_major > policy["max_major"]
            or n_minor > policy["max_minor"])
    current_attempt = consecutive + 1        # 本次是第几次失败尝试
    if not hard_fail and not over and not upstream_issues:
        status = "PASS"          # BLOCKED 后人工修复 → PASS 才解冻
    elif upstream_issues and not hard_fail and not over:
        # P1：上游打回未决 → 不得冻结（下游建立在被质疑的上游上）
        status = "BLOCKED"
    elif was_blocked:
        status = "BLOCKED"       # 此前已 BLOCKED：只有 PASS 能解冻（人工介入后重评审）
    elif current_attempt >= policy["max_iterations"]:
        # 第七轮审计 P2：第 max_iterations 次失败本身即 BLOCKED（此前晚一轮）
        status = "BLOCKED"
    else:
        status = "NEEDS_REVISION"

    doc_hashes = {doc: _sha256(req_dir / doc) for doc in spec["docs"]
                  if (req_dir / doc).is_file()}
    fix_targets = ([i.get("id", "?") for i in counted][:10]
                   if status != "PASS" else [])
    gate = {
        "stage": stage, "status": status, "time": datetime.now().isoformat(timespec="seconds"),
        "hard": {"pass": len(checks.items) - len(hard_fail), "fail": len(hard_fail),
                 "failed": [f"{c['group']}/{c['name']}" for c in hard_fail]},
        "review": {"blocker": n_blocker, "major": n_major, "minor": n_minor,
                   "upstream_pending": len(upstream_issues),
                   "fix_targets": fix_targets},
        "policy": policy, "iteration": consecutive + 1, "doc_hashes": doc_hashes,
        "upstream_fingerprints": {
            up: _stage_fingerprint(req_dir, up)
            for up in STAGES[stage]["upstream"]},
        "failed_because": (
            ["hard checks FAIL: " + "；".join(c["name"] for c in hard_fail[:5])] if hard_fail else [])
            + ([f"severity 超阈值: blocker={n_blocker}/{policy['max_blocker']}, "
                f"major={n_major}/{policy['max_major']}, minor={n_minor}/{policy['max_minor']}"]
               if over else [])
            + ([f"上游打回未决 {len(upstream_issues)} 项（待维护者裁决）"]
               if upstream_issues else []),
        "next": ("进入下一阶段（文档已冻结）" if status == "PASS"
                 else "维护者裁决上游问题后对本阶段重新评审"
                 if upstream_issues and not hard_fail and not over
                 else "定向修改上述问题后重新提交"
                 if status == "NEEDS_REVISION"
                 else f"已连续 {policy['max_iterations']} 轮不达标——升级人工介入"
                 if not was_blocked else "BLOCKED 未解除：人工介入后需重新评审且判定 PASS"),
    }
    gate_file = reviews_dir / f"{stage}.gate.json"
    gate_file.write_text(json.dumps(gate, ensure_ascii=False, indent=2), encoding="utf-8")
    with log_file.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"time": gate["time"], "stage": stage, "status": status,
                            "iteration": gate["iteration"]}, ensure_ascii=False) + "\n")

    if as_json:
        print(json.dumps(gate, ensure_ascii=False, indent=2))
    else:
        print(f"阶段 {stage} 门禁判定: {status}（连续不达标 {consecutive} 轮）")
        for chk in hard_fail:
            print(f"  ✗ HARD {chk['name']}: {chk['detail']}")
        if upstream_issues:
            print(f"  ⚠ 打回上游 {len(upstream_issues)} 项（待维护者裁决，不冻结）")
        if status != "PASS":
            print(f"  下一步: {gate['next']}")
    return {"PASS": 0, "NEEDS_REVISION": 1, "BLOCKED": 2}[status]


def cmd_freeze(req_dir: Path, stage: str, approved_by: str, as_json: bool) -> int:
    """人工签核阶段的冻结凭证（需求分析/业务流程设计）：hard checks 全过 +
    人工签核已写（评审权在人，本工具只落哈希凭证），写 reviews/<阶段>.gate.json
    绑定该阶段文档的 sha256。签核后任何改动 = 哈希失配。"""
    if stage not in HUMAN_SIGNOFF:
        print(f"✗ 阶段 {stage} 不是人工签核阶段（用 gate 子命令走机器门禁）")
        return 3
    doc = STAGES[stage]["docs"][0]
    sign_re, want_state = HUMAN_SIGNOFF[stage]
    checks = run_checks(req_dir, stage)
    doc_text = _read(req_dir / doc)
    if doc_text is None:
        print(f"✗ {doc} 不存在")
        return 3
    m = re.search(sign_re, doc_text)
    signed = m.group(1) if m else "未记录"
    if signed != want_state:
        print(f"✗ 人工签核未完成（当前：{signed}）——评审权在人，"
              f"先在 {doc} 签写签核记录")
        return 3
    if checks.fails:
        print(f"✗ {stage} 硬校验未过（{len(checks.fails)} 项），冻结被拒：")
        for c in checks.fails:
            print(f"  ✗ [{c['group']}] {c['name']}: {c['detail']}")
        return 3
    reviews_dir = req_dir / "reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    (reviews_dir / "hard-checks.json").write_text(
        json.dumps(checks.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")
    gate = {
        "stage": stage, "status": "PASS",
        "time": datetime.now().isoformat(timespec="seconds"),
        "approved_by": approved_by or "维护者",
        "doc_hashes": {doc: _sha256(req_dir / doc)},
        "upstream_fingerprints": {
            up: _stage_fingerprint(req_dir, up)
            for up in STAGES[stage]["upstream"]},
        "frozen_by": "doc-gate freeze（人工签核 + 哈希凭证）",
    }
    (reviews_dir / f"{stage}.gate.json").write_text(
        json.dumps(gate, ensure_ascii=False, indent=2), encoding="utf-8")
    with (reviews_dir / f"{stage}.gate.log").open("a", encoding="utf-8") as f:
        f.write(json.dumps({"time": gate["time"], "stage": stage,
                            "status": "PASS", "approved_by": gate["approved_by"]},
                           ensure_ascii=False) + "\n")
    if as_json:
        print(json.dumps(gate, ensure_ascii=False, indent=2))
    else:
        print(f"✓ {stage} 已签核冻结（凭证绑定 sha256；approved_by={gate['approved_by']}）——"
              f"下游阶段可开始")
    return 0


REQ_TPL_SDD = ["需求分析.md", "概要设计.md", "UI设计.md", "业务流程设计.md",
              "详细设计.md", "API设计.md", "数据库设计.md", "任务清单.md",
              "测试方案.md", "线上联调功能验证清单.md", "终稿.md"]


def _path_is_link(p: Path) -> bool:
    """符号链接或 Windows junction。"""
    if p.is_symlink():
        return True
    if hasattr(os, "isjunction"):
        try:
            return os.path.isjunction(p)
        except OSError:
            return True
    return False


def _safe_parts(rel: str) -> tuple[str, ...]:
    """把仓库内 POSIX 相对路径约束为不可逃逸的组件序列。"""
    if not rel or os.path.isabs(rel) or "\\" in rel:
        raise ValueError(f"非法仓库相对路径: {rel!r}")
    parts = tuple(rel.split("/"))
    if any(part in ("", ".", "..") for part in parts):
        raise ValueError(f"非法仓库相对路径: {rel!r}")
    return parts


def _has_dir_fd_support() -> bool:
    return (os.name == "posix" and os.open in os.supports_dir_fd
            and os.stat in os.supports_dir_fd
            and os.mkdir in os.supports_dir_fd
            and os.link in os.supports_dir_fd
            and os.unlink in os.supports_dir_fd)


def _open_parent_fd(repo: Path, rel: str, *, create: bool = False,
                    created_dirs: list[str] | None = None) -> tuple[int, str]:
    """固定最终文件的父目录；每层以 O_NOFOLLOW 打开，阻断路径替换逃逸。"""
    parts = _safe_parts(rel)
    flags = (os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(repo, flags)
    walked: list[str] = []
    try:
        for part in parts[:-1]:
            walked.append(part)
            try:
                child = os.open(part, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, 0o755, dir_fd=fd)
                if created_dirs is not None:
                    created = "/".join(walked)
                    if created not in created_dirs:
                        created_dirs.append(created)
                child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd, parts[-1]
    except BaseException:
        os.close(fd)
        raise


def _secure_read(repo: Path, rel: str) -> bytes:
    """不跟随最终组件或任一父组件的仓库内读取。"""
    if not _has_dir_fd_support():
        _preflight_dest_fallback(repo, rel)
        path = repo.joinpath(*_safe_parts(rel))
        if not path.is_file():
            raise OSError(f"不是普通文件: {path}")
        return path.read_bytes()
    parent_fd, name = _open_parent_fd(repo, rel)
    fd = -1
    try:
        fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=parent_fd)
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"不是普通文件: {rel}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        if fd >= 0:
            os.close(fd)
        os.close(parent_fd)


def _secure_exists_regular(repo: Path, rel: str) -> bool:
    """返回普通文件是否存在；路径链异常或非普通最终组件一律拒绝。"""
    if not _has_dir_fd_support():
        _preflight_dest_fallback(repo, rel)
        path = repo.joinpath(*_safe_parts(rel))
        if not path.exists():
            return False
        if not path.is_file():
            raise ValueError(f"目标不是普通文件，拒绝写入: {path}")
        return True
    try:
        parent_fd, name = _open_parent_fd(repo, rel)
    except FileNotFoundError:
        return False
    try:
        try:
            info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        if not stat.S_ISREG(info.st_mode):
            raise ValueError(f"目标不是普通文件，拒绝写入: {rel}")
        return True
    finally:
        os.close(parent_fd)


def _write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError("short write")
        view = view[written:]


def _ensure_parent_fallback(repo: Path, rel: str,
                            created_dirs: list[str]) -> Path:
    """Best-effort fallback directory creation with rollback bookkeeping."""
    parts = _safe_parts(rel)
    current = repo
    walked: list[str] = []
    for part in parts[:-1]:
        walked.append(part)
        current = current / part
        if _path_is_link(current):
            raise ValueError(f"路径组件是符号链接/junction，拒绝写入: {current}")
        try:
            current.mkdir()
        except FileExistsError:
            if not current.is_dir() or _path_is_link(current):
                raise ValueError(f"路径组件不是安全目录: {current}")
        else:
            created = "/".join(walked)
            if created not in created_dirs:
                created_dirs.append(created)
    return repo.joinpath(*parts)


def _secure_create(repo: Path, rel: str, data: bytes,
                   created_dirs: list[str]) -> None:
    """完整写入同目录临时文件后，以 no-replace 语义原子发布。"""
    if not _has_dir_fd_support():
        _preflight_dest_fallback(repo, rel)
        path = _ensure_parent_fallback(repo, rel, created_dirs)
        tmp = path.with_name(
            f".{path.name}.kit-init-{os.getpid()}-{os.urandom(6).hex()}.tmp")
        fd = -1
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            _write_all(fd, data)
            os.fsync(fd)
            os.close(fd)
            fd = -1
            if os.name == "nt":
                # Windows os.rename 不覆盖已存在目标。
                os.rename(tmp, path)
            else:
                # 无 dir_fd 的 POSIX 实现仍用 link(2) 保持 no-replace。
                os.link(tmp, path, follow_symlinks=False)
        finally:
            if fd >= 0:
                os.close(fd)
            try:
                tmp.unlink()
            except FileNotFoundError:
                pass
        return
    parent_fd, name = _open_parent_fd(
        repo, rel, create=True, created_dirs=created_dirs)
    tmp_name = f".{name}.kit-init-{os.getpid()}-{os.urandom(6).hex()}.tmp"
    fd = -1
    try:
        fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | getattr(os, "O_NOFOLLOW", 0), 0o644, dir_fd=parent_fd)
        _write_all(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        # link(2) 对目标是原子 no-replace：目标已存在则 EEXIST，绝不覆盖。
        os.link(tmp_name, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd,
                follow_symlinks=False)
        os.fsync(parent_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp_name, dir_fd=parent_fd)
        except FileNotFoundError:
            pass
        os.close(parent_fd)


def _secure_replace(repo: Path, rel: str, data: bytes,
                    expected_hash: str) -> None:
    """CAS 检查后在同一固定父目录原子替换文件。"""
    if not _has_dir_fd_support():
        path = repo.joinpath(*_safe_parts(rel))
        current = _secure_read(repo, rel)
        if hashlib.sha256(current).hexdigest() != expected_hash:
            raise RuntimeError(f"并发修改冲突: {rel}")
        original_mode = stat.S_IMODE(path.stat().st_mode)
        tmp = path.with_name(
            f".{path.name}.kit-init-{os.getpid()}-{os.urandom(6).hex()}.tmp")
        fd = -1
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                         original_mode)
            _write_all(fd, data)
            if hasattr(os, "fchmod"):
                os.fchmod(fd, original_mode)
            os.fsync(fd)
            os.close(fd)
            fd = -1
            if hashlib.sha256(_secure_read(repo, rel)).hexdigest() != expected_hash:
                raise RuntimeError(f"并发修改冲突: {rel}")
            os.replace(tmp, path)
        finally:
            if fd >= 0:
                os.close(fd)
            try:
                tmp.unlink()
            except FileNotFoundError:
                pass
        return
    parent_fd, name = _open_parent_fd(repo, rel)
    tmp_name = f".{name}.kit-init-{os.getpid()}-{os.urandom(6).hex()}.tmp"
    fd = -1
    try:
        current_fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                             dir_fd=parent_fd)
        try:
            current_stat = os.fstat(current_fd)
            if not stat.S_ISREG(current_stat.st_mode):
                raise OSError(f"不是普通文件: {rel}")
            current_hash = hashlib.sha256()
            while True:
                chunk = os.read(current_fd, 1024 * 1024)
                if not chunk:
                    break
                current_hash.update(chunk)
        finally:
            os.close(current_fd)
        if current_hash.hexdigest() != expected_hash:
            raise RuntimeError(f"并发修改冲突: {rel}")
        original_mode = stat.S_IMODE(current_stat.st_mode)
        fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | getattr(os, "O_NOFOLLOW", 0), original_mode,
                     dir_fd=parent_fd)
        _write_all(fd, data)
        os.fchmod(fd, original_mode)  # POSIX branch
        os.fsync(fd)
        os.close(fd)
        fd = -1
        # 第一次 CAS 后至 replace 前仍可能有竞争；在相同目录句柄上再校验一次。
        check_fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                           dir_fd=parent_fd)
        try:
            h = hashlib.sha256()
            while True:
                chunk = os.read(check_fd, 1024 * 1024)
                if not chunk:
                    break
                h.update(chunk)
        finally:
            os.close(check_fd)
        if h.hexdigest() != expected_hash:
            raise RuntimeError(f"并发修改冲突: {rel}")
        os.replace(tmp_name, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
        os.fsync(parent_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp_name, dir_fd=parent_fd)
        except FileNotFoundError:
            pass
        os.close(parent_fd)


def _secure_unlink(repo: Path, rel: str) -> None:
    if not _has_dir_fd_support():
        repo.joinpath(*_safe_parts(rel)).unlink(missing_ok=True)
        return
    try:
        parent_fd, name = _open_parent_fd(repo, rel)
    except FileNotFoundError:
        return
    try:
        os.unlink(name, dir_fd=parent_fd)
    except FileNotFoundError:
        pass
    finally:
        os.close(parent_fd)


def _secure_rmdir(repo: Path, rel: str) -> None:
    parts = _safe_parts(rel)
    if not _has_dir_fd_support():
        try:
            repo.joinpath(*parts).rmdir()
        except (FileNotFoundError, OSError):
            pass
        return
    try:
        parent_fd, name = _open_parent_fd(repo, rel)
    except (FileNotFoundError, NotADirectoryError, OSError):
        return
    try:
        try:
            os.rmdir(name, dir_fd=parent_fd)
        except (FileNotFoundError, OSError):
            pass
    finally:
        os.close(parent_fd)


def _preflight_dest_fallback(repo: Path, rel: str) -> None:
    """Windows fallback：拒绝 symlink/junction；POSIX 正常路径不使用它。"""
    cur = repo
    for part in _safe_parts(rel):
        cur = cur / part
        if _path_is_link(cur):
            raise ValueError(f"路径组件是符号链接/junction，拒绝写入: {cur}")


def _acquire_init_lock(repo: Path) -> int:
    """与 kit 生命周期共用锁，避免模板更新与并发 init 产生混合快照。"""
    rel = ".repo-memory-kit/install.lock"
    if _has_dir_fd_support():
        parent_fd, lock_name = _open_parent_fd(repo, rel)
        try:
            fd = os.open(lock_name, os.O_RDWR | os.O_CREAT
                         | getattr(os, "O_NOFOLLOW", 0), 0o600,
                         dir_fd=parent_fd)
        finally:
            os.close(parent_fd)
    else:
        _preflight_dest_fallback(repo, rel)
        lock_path = repo.joinpath(*_safe_parts(rel))
        fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        if os.fstat(fd).st_size == 0:
            _write_all(fd, b"\0")
            os.fsync(fd)
        os.lseek(fd, 0, os.SEEK_SET)
        if os.name == "nt":
            import msvcrt
            msvcrt.locking(fd, msvcrt.LK_LOCK, 1)
        else:
            import fcntl
            fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except BaseException:
        os.close(fd)
        raise


def _release_init_lock(fd: int) -> None:
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        if os.name == "nt":
            import msvcrt
            msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
        else:
            import fcntl
            fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    finally:
        os.close(fd)


def cmd_init(repo: Path, name: str, as_json: bool) -> int:
    if not re.fullmatch(r"\d+-[^/\\\s]+", name) or ".." in name:
        print(f"✗ 需求名格式应为 NNN-名称（如 014-识别驱动脱敏）：{name!r}")
        return 3
    try:
        lock_fd = _acquire_init_lock(repo)
    except OSError as e:
        print(f"✗ 无法取得 doc-gate init 锁: {e}")
        return 3
    try:
        return _cmd_init_locked(repo, name, as_json)
    finally:
        _release_init_lock(lock_fd)


def _cmd_init_locked(repo: Path, name: str, as_json: bool) -> int:
    """需求登记脚手架：安全创建全部模板，最后以 CAS 原子更新索引。"""
    template_rels = [f"docs/01-需求/_模板/{t}"
                     for t in ["原始需求.md"] + REQ_TPL_SDD]
    try:
        templates = {rel: _secure_read(repo, rel) for rel in template_rels}
        index_rel = "docs/01-需求/README.md"
        index_bytes = _secure_read(repo, index_rel)
        index_text = index_bytes.decode("utf-8")
    except (OSError, UnicodeDecodeError, ValueError) as e:
        print(f"✗ 模板或索引不可安全读取: {e}——请先运行 kit 安装/修复")
        return 3
    lines = index_text.split("\n")
    nnn = name.split("-", 1)[0]
    row_exists = any(_l.strip().startswith(f"| {nnn}-") and "---" not in _l
                     for _l in lines)
    last_row = max((i for i, _l in enumerate(lines)
                    if _l.strip().startswith("|")), default=None)
    if last_row is None:
        print("✗ 索引格式异常（未找到表格）——请人工登记")
        return 3
    req_rel = f"docs/01-需求/{name}"
    sdd_rel = f"docs/03-SDD/{name}"
    destinations = [(f"{req_rel}/原始需求.md", templates[template_rels[0]])]
    destinations.extend(
        (f"{sdd_rel}/{name_}", templates[f"docs/01-需求/_模板/{name_}"])
        for name_ in REQ_TPL_SDD)
    created: list[str] = []
    skipped: list[str] = []
    created_dirs: list[str] = []
    try:
        for rel, _data in destinations:
            if _secure_exists_regular(repo, rel):
                skipped.append(rel)
    except (OSError, ValueError) as e:
        print(f"✗ 目标路径不安全: {e}")
        return 3
    row_added = False
    index_replaced = False
    old_index_hash = hashlib.sha256(index_bytes).hexdigest()
    new_index_bytes = index_bytes
    if not row_exists:
        row = (f"| {name} | （填写需求名） | 草拟 | 需求分析 | {name} | "
               f"（实现人） | （版本） | 未定 |")
        lines.insert(last_row + 1, row)
        new_index_bytes = "\n".join(lines).encode("utf-8")
    try:
        for rel, data in destinations:
            if rel not in skipped:
                _secure_create(repo, rel, data, created_dirs)
                created.append(rel)
        if not row_exists:
            _secure_replace(repo, index_rel, new_index_bytes, old_index_hash)
            index_replaced = True
            row_added = True
    except (OSError, RuntimeError, ValueError) as e:
        rollback_errors: list[str] = []
        if index_replaced:
            try:
                _secure_replace(repo, index_rel, index_bytes,
                                hashlib.sha256(new_index_bytes).hexdigest())
            except (OSError, RuntimeError, ValueError) as restore_error:
                rollback_errors.append(f"索引恢复失败: {restore_error}")
        for rel in reversed(created):
            try:
                _secure_unlink(repo, rel)
            except OSError as cleanup_error:
                rollback_errors.append(f"清理 {rel} 失败: {cleanup_error}")
        for rel in reversed(created_dirs):
            _secure_rmdir(repo, rel)
        suffix = f"；{'；'.join(rollback_errors)}" if rollback_errors else ""
        print(f"✗ init 写入失败，已回滚本次创建: {e}{suffix}")
        return 3
    if as_json:
        print(json.dumps({"name": name, "created": created, "skipped": skipped,
                          "index_row_added": row_added}, ensure_ascii=False, indent=2))
    else:
        for c in created:
            print(f"✓ 已创建 {c}")
        for s in skipped:
            print(f"• 已存在跳过 {s}")
        print(f"{'✓' if row_added else '•'} 索引行{'已登记' if row_added else '（同号已存在，跳过）'}")
        print("下一步：维护者填写 原始需求.md → Agent 衍生需求分析 → "
              "维护者签核后 doc-gate freeze")
    return 0



