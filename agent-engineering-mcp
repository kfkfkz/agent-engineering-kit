#!/usr/bin/env python3
"""agent-engineering-kit MCP server.

Exposes deterministic knowledge operations as first-class MCP tools,
eliminating the "Agent has to remember to use Bash" gap:
  memory_recall   — semantic search over docs/ (replaces Bash CLI call)
  memory_build     — rebuild indexes (replaces Bash CLI call)
  domain_check     — domain map validation (replaces Bash CLI call)
  kit_status      — installation & staleness overview (new)

Zero external dependencies: Python stdlib only (json, sys, subprocess, os).
Delegates to existing CLI tools (single implementation, no code duplication).

Usage:
  agent-engineering-mcp <target-repo>     # stdio JSON-RPC MCP server
"""
import json
import os
import subprocess
import sys


def _configure_utf8_stdio():
    """Keep CLI protocol/output independent from the host's narrow code page."""
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is not None:
            reconfigure(encoding="utf-8", errors="backslashreplace")


_configure_utf8_stdio()

KIT_BIN = os.path.dirname(os.path.abspath(__file__))
# 绑定目标仓库:MCP 服务器只能操作安装它的仓库,不允许 Agent 传任意路径
# KIT_BIN 形如 <repo>/.repo-memory-kit/bin,向上三级即仓库根
_BOUND_REPO = os.path.dirname(os.path.dirname(KIT_BIN))

# MCP 协议版本协商：支持列表按时间正序，DEFAULT 是我们测试过的最新版。
# 客户端在 initialize.params.protocolVersion 发来版本号：
#   - 在支持列表内 → 回显该版本（客户端继续）
#   - 不在列表内 → 回 DEFAULT（客户端自行决定是否继续）
#
# 只声明 initialize 握手时代（legacy era）真正实现的版本——2026-07-28
# (modern era) 移除了 initialize、要求 server/discover 与每请求 _meta，
# 我们未实现，不宣称支持（P1 诚实化：声明与 wire 行为必须一致）。
# 参考：https://modelcontextprotocol.io/specification
SUPPORTED_VERSIONS = ["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"]
DEFAULT_PROTOCOL_VERSION = "2025-11-25"
SERVER_NAME = "agent-engineering-kit"
SERVER_VERSION = "1.1.0"

TOOLS = [
    {
        "name": "memory_recall",
        "description": "语义检索 docs/ 全量文档（记忆条目、业务域地图、SDD、交付回执）。"
                       "任务开始时先调此工具查找相关知识，再读命中条目全文。",
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "检索文本"},
                "type": {"type": "string", "description": "类型过滤(逗号分隔): pitfall,decision,playbook,domain,sdd,receipt"},
                "status": {"type": "string", "description": "状态过滤: confirmed,unverified"},
                "top": {"type": "integer", "description": "最大返回数", "default": 8},
                            },
            "required": ["query"],
        },
    },
    {
        "name": "memory_build",
        "description": "重建记忆索引和语义索引（条目变更后调用）。"
                       "mode: build=重建, check=只读校验, changed=变更影响分析。"
                       "绑定安装时的仓库。不支持跨仓库操作。",
        "inputSchema": {
            "type": "object",
            "properties": {
                "mode": {"type": "string", "enum": ["build", "check", "changed"],
                         "description": "操作模式", "default": "build"},
                            },
        },
    },
    {
        "name": "domain_check",
        "description": "校验业务域地图（索引登记一致性、状态合法、证据路径存在）。"
                       "回写域条目后或定期巡检时调用。",
        "inputSchema": {
            "type": "object",
            "properties": {
                "strict": {"type": "boolean", "description": "警告也计为失败", "default": False},
                            },
        },
    },
    {
        "name": "kit_status",
        "description": "查看 kit 安装状态、语义索引新鲜度、域地图健康度。"
                       "会话开始时调用一次以了解项目知识层状态。"
                       "target 应传项目根目录路径。",
        "inputSchema": {
            "type": "object",
            "properties": {
                            },
        },
    },
]


def run_cli(script_name, args, cwd):
    """Delegate to existing CLI tool. Returns (returncode, stdout, stderr)."""
    script = os.path.join(KIT_BIN, script_name)
    if not os.path.isfile(script):
        return 1, "", f"CLI tool not found: {script}"
    cmd = [sys.executable, script] + args
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd,
                           timeout=60, check=False)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"Tool timeout after 60s: {script_name}"


def tool_memory_recall(args):
    query = args.get("query", "")
    if not query:
        return {"error": "query is required"}
    target = _BOUND_REPO
    cmd_args = [query, target]
    if args.get("type"):
        cmd_args.extend(["--type", args["type"]])
    if args.get("status"):
        cmd_args.extend(["--status", args["status"]])
    if args.get("top"):
        cmd_args.extend(["--top", str(args["top"])])
    rc, out, err = run_cli("memory-recall", cmd_args, target)
    return {"returncode": rc, "output": out.strip(), "error": err.strip() if rc != 0 else ""}


def tool_memory_build(args):
    target = _BOUND_REPO
    mode = args.get("mode", "build")
    if mode == "build":
        rc, out, err = run_cli("memory-build", [target], target)
    elif mode == "check":
        rc, out, err = run_cli("memory-build", ["--check", target], target)
    elif mode == "changed":
        rc, out, err = run_cli("memory-build", ["--changed", target], target)
    else:
        return {"error": f"invalid mode: {mode}"}
    return {"returncode": rc, "output": out.strip(), "error": err.strip() if rc != 0 else ""}


def tool_domain_check(args):
    target = _BOUND_REPO
    cmd_args = [target]
    if args.get("strict"):
        cmd_args.append("--strict")
    rc, out, err = run_cli("domain-check", cmd_args, target)
    return {"returncode": rc, "output": out.strip(), "error": err.strip() if rc != 0 else ""}


def tool_kit_status(args):
    target = os.path.abspath(_BOUND_REPO)
    status = {"target": target, "kit_version": None, "semantic_index": None, "domain_map": None}

    # manifest（Manifest v2：manifest.json；旧 install.sh 的文本 manifest 已退役）
    manifest = os.path.join(target, ".repo-memory-kit", "manifest.json")
    if os.path.isfile(manifest):
        try:
            with open(manifest) as f:
                status["kit_version"] = json.load(f).get("kit_version", "unknown")
        except (OSError, ValueError):
            status["kit_version"] = "unknown"
    else:
        status["kit_version"] = "not installed"

    # semantic index（v4 布局：zvec/generations/<uuid> + current.json 指针；
    # 旧 zvec/recall 布局只读兼容）
    zvec_dir = os.path.join(target, ".repo-memory-kit", "zvec")
    gen_dir = None
    pointer = os.path.join(zvec_dir, "current.json")
    if os.path.isfile(pointer):
        try:
            with open(pointer) as f:
                gen = json.load(f).get("generation", "")
            if gen:
                gen_dir = os.path.join(zvec_dir, "generations", gen)
        except (OSError, ValueError):
            gen_dir = None
    if gen_dir is None and os.path.isdir(os.path.join(zvec_dir, "recall")):
        gen_dir = os.path.join(zvec_dir, "recall")
    if gen_dir is not None and os.path.isdir(gen_dir):
        count_file = os.path.join(gen_dir, ".doc-count")
        if os.path.isfile(count_file):
            with open(count_file) as count_stream:
                count = int(count_stream.read().strip())
            status["semantic_index"] = {"exists": True, "docs": count}
        else:
            status["semantic_index"] = {"exists": True, "docs": "unknown"}
    else:
        status["semantic_index"] = {"exists": False}

    # domain map
    dm = os.path.join(target, "docs", "02-业务域地图")
    if os.path.isdir(dm):
        count = sum(1 for g in ("02-公共能力域", "03-核心业务域")
                    for d in (os.path.join(dm, g) for _ in [1])
                    if os.path.isdir(d)
                    for s in os.listdir(d) if os.path.isdir(os.path.join(d, s)))
        status["domain_map"] = {"exists": True, "entries": count}
    else:
        status["domain_map"] = {"exists": False}

    return status


_initialized = False   # 生命周期状态：initialize 成功前拒绝业务调用（ping 除外）


TOOL_HANDLERS = {
    "memory_recall": tool_memory_recall,
    "memory_build": tool_memory_build,
    "domain_check": tool_domain_check,
    "kit_status": tool_kit_status,
}


def handle_request(req):
    """Handle a single JSON-RPC request. Returns response dict or None (for notifications).

    第八轮审计 P1：合法 JSON 可以是数组/标量/null——envelope 校验先行，
    非对象或缺 method → -32600（结构化错误，不崩溃）。"""
    if not isinstance(req, dict):
        return {"jsonrpc": "2.0", "id": None, "error": {
            "code": -32600, "message": "Invalid Request: not an object"}}
    req_id = req.get("id")
    if req.get("jsonrpc") != "2.0":
        return {"jsonrpc": "2.0", "id": None, "error": {
            "code": -32600, "message": "Invalid Request: jsonrpc must be '2.0'"}}
    if ("id" in req and req_id is not None
            and (isinstance(req_id, bool)
                 or not isinstance(req_id, (str, int, float)))):
        return {"jsonrpc": "2.0", "id": None, "error": {
            "code": -32600, "message": "Invalid Request: invalid id"}}
    method = req.get("method")
    if not isinstance(method, str):
        return {"jsonrpc": "2.0", "id": req_id, "error": {
            "code": -32600, "message": "Invalid Request: method must be a string"}}

    if method == "initialize":
        # 2025-11-25 schema：InitializeRequest 必须携带 protocolVersion、
        # capabilities、clientInfo——缺失返回 -32602（第七轮审计 P2：
        # params={} 此前被当正常路径初始化）
        params = req.get("params")
        if (not isinstance(params, dict)
                or not isinstance(params.get("protocolVersion"), str)
                or not isinstance(params.get("capabilities"), dict)
                or not isinstance(params.get("clientInfo"), dict)
                or not isinstance(params.get("clientInfo", {}).get("name"), str)
                or not isinstance(params.get("clientInfo", {}).get("version"), str)):
            return {
                "jsonrpc": "2.0", "id": req_id,
                "error": {"code": -32602,
                          "message": "Invalid params: initialize requires "
                                     "protocolVersion (string), capabilities "
                                     "(object) and clientInfo (object)"},
            }
        client_version = params.get("protocolVersion", "")
        negotiated = (client_version if client_version in SUPPORTED_VERSIONS
                      else DEFAULT_PROTOCOL_VERSION)
        global _initialized
        _initialized = True
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": negotiated,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
            },
        }

    if method == "notifications/initialized":
        if "params" in req and not isinstance(req["params"], dict):
            return {"jsonrpc": "2.0", "id": req_id, "error": {
                "code": -32602, "message": "Invalid params: expected object"}}
        return None  # notification, no response

    # 初始化前调用（ping 除外——无状态健康检查）→ -32002 ServerNotInitialized
    if method != "ping" and not _initialized:
        return {
            "jsonrpc": "2.0", "id": req_id,
            "error": {"code": -32002,
                      "message": "Server not initialized: send initialize first"},
        }

    if method == "tools/list":
        if "params" in req and not isinstance(req["params"], dict):
            return {"jsonrpc": "2.0", "id": req_id, "error": {
                "code": -32602, "message": "Invalid params: expected object"}}
        return {"jsonrpc": "2.0", "id": req_id, "result": {"tools": TOOLS}}

    if method == "tools/call":
        params = req.get("params")
        if not isinstance(params, dict):
            return {"jsonrpc": "2.0", "id": req_id, "error": {
                "code": -32602, "message": "Invalid params: expected object"}}
        tool_name = params.get("name")
        arguments = params.get("arguments", {})

        if not isinstance(tool_name, str) or not tool_name:
            return {"jsonrpc": "2.0", "id": req_id, "error": {
                "code": -32602, "message": "Invalid params: name must be a non-empty string"}}
        if not isinstance(arguments, dict):
            return {"jsonrpc": "2.0", "id": req_id, "error": {
                "code": -32602, "message": "Invalid params: arguments must be an object"}}

        if tool_name not in TOOL_HANDLERS:
            return {
                "jsonrpc": "2.0", "id": req_id,
                "error": {"code": -32602, "message": f"Unknown tool: {tool_name}"},
            }

        try:
            result = TOOL_HANDLERS[tool_name](arguments)
            is_error = bool(result.get("error")) or result.get("returncode", 0) != 0
            return {
                "jsonrpc": "2.0", "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(result, ensure_ascii=False, indent=2)}],
                    "isError": is_error,
                },
            }
        except Exception as e:  # noqa: BLE001 - tool boundary returns structured failure
            return {
                "jsonrpc": "2.0", "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps({"error": str(e)})}],
                    "isError": True,
                },
            }

    # ping
    if method == "ping":
        return {"jsonrpc": "2.0", "id": req_id, "result": {}}

    # unknown method
    if req_id is not None:
        return {
            "jsonrpc": "2.0", "id": req_id,
            "error": {"code": -32601, "message": f"Method not found: {method}"},
        }
    return None


def main():
    """Read newline-delimited JSON-RPC from stdin, write responses to stdout."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(
                line,
                parse_constant=lambda value: (_ for _ in ()).throw(
                    ValueError(f"invalid JSON constant: {value}")),
            )
        except (json.JSONDecodeError, ValueError):
            sys.stdout.write(json.dumps({
                "jsonrpc": "2.0", "id": None,
                "error": {"code": -32700, "message": "Parse error"}
            }) + "\n")
            sys.stdout.flush()
            continue

        try:
            resp = handle_request(req)
        except Exception as e:  # noqa: BLE001 - JSON-RPC boundary must survive tools
            sys.stderr.write(f"[mcp] internal error: {type(e).__name__}: {e}\n")
            safe_id = None
            if isinstance(req, dict):
                candidate = req.get("id")
                if (candidate is None or
                        (not isinstance(candidate, bool)
                         and isinstance(candidate, (str, int, float)))):
                    safe_id = candidate
            resp = {"jsonrpc": "2.0", "id": safe_id, "error": {
                "code": -32603, "message": "Internal error"}}
        # A structurally valid request without an id is a notification. Execute
        # it, but never emit a response (including method/params errors).
        if (isinstance(req, dict) and req.get("jsonrpc") == "2.0"
                and isinstance(req.get("method"), str) and "id" not in req):
            resp = None
        if resp is not None:
            sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
