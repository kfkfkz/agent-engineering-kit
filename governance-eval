#!/usr/bin/env python3
"""governance-eval — 确定性治理策略引擎（从 installer/governance.py 迁入并布线）。

读取 governance.json 中的结构化规则，对 git diff 做机械匹配。
Skill 可以建议风险等级，但本引擎是**唯一裁决者**——只认 diff + 规则 + 证据。

架构原则（与 doc-gate 同一哲学：Agent 是 sensor，引擎是 judge）：
1. 扫描 diff 的新增/修改行（不扫全文件——存量代码不应触发）
2. 删除的文件也参与匹配（删掉 security/ 同样触发）
3. 每条规则独立判定，输出命中的规则 ID 和需要补的 action
4. Agent 拿到的是"哪条规则命中、还缺什么"，不是模糊的"gate failed"

用法:
  git diff | governance-eval [仓库根目录]              # 人类可读摘要
  governance-eval [仓库根目录] --diff <file> --json   # 机器可读（CI/delivery-gate）

退出码: 0 = 评估完成（判定结果在输出里，本工具只评估不拦截）；
       3 = 环境/用法错误。
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any

def _configure_utf8_stdio() -> None:
    """Keep CLI output independent from the host's narrow code page."""
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is not None:
            reconfigure(encoding="utf-8", errors="backslashreplace")


_configure_utf8_stdio()

_script_dir = Path(__file__).resolve().parent
_installed_layout = (
    _script_dir.name == "bin" and _script_dir.parent.name == ".repo-memory-kit"
)
_package_root = _script_dir.parent / "lib" if _installed_layout else _script_dir
if not (_package_root / "aek/core/policy/evaluator.py").is_file():
    print("✗ AEK package 缺失或安装布局无效", file=sys.stderr)
    raise SystemExit(3)
sys.path.insert(0, str(_package_root))
from aek.application.governance import evaluate_governance
from aek.core.policy.evaluator import GovernanceResult, PolicyError, evaluate_policy


PROFILE_DEFAULTS: dict[str, list[str]] = {
    "strict": ["receipt"],
    "lightweight": ["inline_review"],
}


def load_policy(governance_path: Path) -> dict[str, Any]:
    """组装策略（第七轮审计 P1：单一事实源）：
    - profile 唯一权威 = 同目录 governance **文本 marker**（安装器每次 install
      更新——切换 lightweight 即时生效；json 里不再存 profile）
    - 团队规则 = governance.json（缺失 = 无规则；存在但非法 = PolicyError，fail-closed）
    - 默认动作按 profile 派生（strict=receipt / lightweight=inline_review）"""
    marker = governance_path.parent / "governance"
    profile = "strict"
    try:
        if marker.is_file():
            text = marker.read_text(encoding="utf-8").strip()
            if text in PROFILE_DEFAULTS:
                profile = text
    except OSError:
        pass
    rules: list[dict[str, Any]] = []
    if governance_path.is_file():
        try:
            data = json.loads(governance_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError) as e:
            raise PolicyError(f"governance.json 存在但不可解析（fail-closed）: {e}")
        if not isinstance(data, dict):
            raise PolicyError("governance.json 顶层必须是对象")
        rules = data.get("rules", [])
        if not isinstance(rules, list):
            raise PolicyError("governance.json 的 rules 必须是数组")
        # 第八轮审计 P2：逐条规则 schema 校验——元素非法 → 受控 fail-closed，
        # 不在 evaluate_diff 里 traceback
        for i, rule in enumerate(rules):
            if not isinstance(rule, dict):
                raise PolicyError(f"rules[{i}] 不是对象（得到 {type(rule).__name__}）")
            rid = rule.get("id", f"rules[{i}]")
            if not isinstance(rule.get("id", ""), str):
                raise PolicyError(f"{rid}: id 必须是字符串")
            require = rule.get("require", [])
            if not isinstance(require, list) or not all(
                    isinstance(a, str) for a in require):
                raise PolicyError(f"{rid}: require 必须是字符串数组")
            match = rule.get("match", {})
            if not isinstance(match, dict):
                raise PolicyError(f"{rid}: match 必须是对象")
            for key in ("paths", "files", "added_lines_regex"):
                if key in match and not (
                        isinstance(match[key], list)
                        and all(isinstance(x, str) for x in match[key])):
                    raise PolicyError(f"{rid}: match.{key} 必须是字符串数组")
    return {"version": 1, "profile": profile, "rules": rules,
            "default": {"require": list(PROFILE_DEFAULTS[profile])}}


def _unquote_git_path(path: str) -> str:
    """还原 git core.quotePath 转义的路径（"\346\265\213" 八进制 → UTF-8）。
    引号包裹的路径才需要还原；裸路径原样返回。"""
    if not (path.startswith('"') and path.endswith('"') and len(path) >= 2):
        return path
    inner = path[1:-1]
    out = bytearray()
    i = 0
    escapes = {"n": b"\n", "t": b"\t", "r": b"\r", "b": b"\b",
               "f": b"\f", "v": b"\v", "\\": b"\\", '"': b'"'}
    while i < len(inner):
        if inner[i] == "\\" and i + 1 < len(inner):
            oct_part = inner[i + 1:i + 4]
            if len(oct_part) == 3 and all(c in "01234567" for c in oct_part):
                out += bytes([int(oct_part, 8)])
                i += 4
                continue
            escaped = escapes.get(inner[i + 1])
            if escaped is not None:
                out += escaped
                i += 2
                continue
        out += inner[i].encode("utf-8", "surrogateescape")
        i += 1
    try:
        return out.decode("utf-8")
    except UnicodeDecodeError:
        return path


def _diff_header_path(line: str, marker: str) -> str | None:
    """Decode one ``---``/``+++`` path, including Git C-quoted names."""
    prefix = marker + " "
    if not line.startswith(prefix):
        return None
    raw = line[len(prefix):]
    if raw.startswith('"'):
        escaped = False
        end = None
        for i, char in enumerate(raw[1:], 1):
            if char == '"' and not escaped:
                end = i
                break
            if char == "\\" and not escaped:
                escaped = True
            else:
                escaped = False
        token = raw if end is None else raw[:end + 1]
    else:
        token = raw.split("\t", 1)[0]
    path = _unquote_git_path(token)
    if path == "/dev/null":
        return None
    if path.startswith(("a/", "b/")):
        path = path[2:]
    return path


def _diff_files(diff_text: str) -> set[str]:
    """从 git diff 输出中提取变更的文件路径（支持 quotePath 转义还原）。"""
    files = set()
    for line in diff_text.split("\n"):
        for marker in ("---", "+++"):
            path = _diff_header_path(line, marker)
            if path is not None:
                files.add(path)
    return files


def _added_lines(diff_text: str) -> list[tuple[str, int, str]]:
    """从 git diff 中提取新增/修改的行（带文件名和行号）。"""
    results = []
    current_file = ""
    line_no = 0
    for line in diff_text.split("\n"):
        if line.startswith("+++ "):
            current_file = _diff_header_path(line, "+++") or ""
            line_no = 0
        elif line.startswith("@@"):
            # 解析 @@ -old,count +new,count @@
            m = re.search(r"\+(\d+)", line)
            if m:
                line_no = int(m.group(1)) - 1
        elif line.startswith("+") and not line.startswith("+++ "):
            line_no += 1
            content = line[1:]  # 去掉 +
            results.append((current_file, line_no, content))
        elif line.startswith("-") and not line.startswith("--- "):
            pass  # 删除的行不计数
        else:
            line_no += 1
    return results


def _deleted_files(diff_text: str) -> set[str]:
    """从 git diff 中提取被删除的文件。"""
    deleted = set()
    lines = diff_text.split("\n")
    for i, line in enumerate(lines):
        if line.startswith("--- "):
            old_path = _diff_header_path(line, "---")
            if (old_path is not None and i + 1 < len(lines)
                    and lines[i + 1].startswith("+++ /dev/null")):
                deleted.add(old_path)
    return deleted


def evaluate_diff(diff_text: str, policy: dict[str, Any]) -> GovernanceResult:
    """对 git diff 应用治理策略——**唯一裁决入口**。

    参数：
    - diff_text: `git diff` 的完整输出（unified format）
    - policy: load_policy() 返回的策略 JSON

    返回 GovernanceResult，包含命中的规则和需要的动作。
    """
    return evaluate_governance(
        diff_text, policy, changed_files=_diff_files,
        added_lines=_added_lines, deleted_files=_deleted_files)


def _legacy_evaluate_diff(diff_text: str, policy: dict[str, Any]) -> GovernanceResult:
    """Pre-1.0.1 parity oracle; production dispatch uses Application."""
    return evaluate_policy(
        _diff_files(diff_text), _added_lines(diff_text),
        _deleted_files(diff_text), policy)


# ══════════════════════════ CLI ══════════════════════════

def main() -> int:
    ap = argparse.ArgumentParser(prog="governance-eval",
                                 description="确定性治理策略引擎（diff 评估）")
    ap.add_argument("repo", nargs="?", default=".", help="目标仓库根目录（默认当前目录）")
    ap.add_argument("--diff", help="diff 文件路径（缺省从 stdin 读）")
    ap.add_argument("--json", action="store_true", help="机器可读输出")
    args = ap.parse_args()

    repo = Path(args.repo).resolve()
    if args.diff:
        try:
            diff_text = Path(args.diff).read_text(encoding="utf-8")
        except OSError as e:
            print(f"✗ 无法读取 diff 文件: {e}")
            return 3
    else:
        if sys.stdin.isatty():
            print("用法: git diff | governance-eval [仓库]   或   governance-eval --diff <file>")
            return 3
        diff_text = sys.stdin.read()

    try:
        policy = load_policy(repo / ".repo-memory-kit" / "governance.json")
        result = evaluate_diff(diff_text, policy)
    except PolicyError as e:
        print(f"✗ 治理策略非法，评估阻断（fail-closed）: {e}")
        return 3

    if args.json:
        print(json.dumps(result.to_dict(), ensure_ascii=False, indent=2))
    else:
        print(result.summary())
    return 0


if __name__ == "__main__":
    sys.exit(main())
