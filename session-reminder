#!/bin/sh
# agent-engineering-kit 会话提醒：语义检索层状态（只读、快速）。
# 由项目 .claude/settings.json 的 SessionStart 钩子调用（$CLAUDE_PROJECT_DIR 定位）；
# kit 未装、无 docs/ 或层未启用时静默退出，不产生噪音。
# 索引布局（v12 §15）：zvec/generations/<uuid> + current.json 指针；
# 旧 zvec/recall 布局只读兼容（发布新索引后即退役）。
set -u
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET="$(cd "$SELF_DIR/../.." && pwd)"

[ -d "$TARGET/docs" ] || exit 0
[ -f "$TARGET/.repo-memory-kit/bin/memory-recall" ] || exit 0
ZVEC_DIR="$TARGET/.repo-memory-kit/zvec"

# 检测 docs/ 新增/修改（时间戳）与删除（计数），对新旧两种布局分别判定
check_dir="$TARGET/docs"
if [ -f "$ZVEC_DIR/current.json" ]; then
    INDEX="$ZVEC_DIR/generations/$(sed -n 's/.*"generation": *"\([^"]*\)".*/\1/p' "$ZVEC_DIR/current.json" | head -1)"
    [ -d "$INDEX" ] || exit 0
    count_file="$INDEX/.doc-count"
elif [ -d "$ZVEC_DIR/recall" ]; then
    INDEX="$ZVEC_DIR/recall"
    count_file="$INDEX/.doc-count"
else
    # 索引未建：仅当 zvec 实际可用时提醒构建，否则静默（避免每会话唠叨）
    command -v python3 >/dev/null 2>&1 || exit 0
    python3 -c "import zvec" >/dev/null 2>&1 || exit 0
    echo "[agent-engineering-kit] Memory configured；MCP visible/indexed 状态需由当前宿主确认。请先使用 memory_recall MCP；索引维护由 Agent 内部处理。"
    exit 0
fi

# 新增/修改：docs/ 下有比索引目录更新的 md
newest="$(find "$check_dir" -name '*.md' -newer "$INDEX" -print -quit 2>/dev/null)"
if [ -n "$newest" ]; then
    echo "[agent-engineering-kit] Memory 索引可能落后；请先使用 memory_recall MCP，Agent 将按契约决定是否内部刷新。codebase visible/indexed/fresh 仍需宿主取证。"
    exit 0
fi

# 删除/新增：当前 docs/ 下 md 数与上次 rebuild 记录的数对比
doc_count="$(find "$check_dir" -name '*.md' ! -name '_*' -not -path '*/01-索引/*' -not -path '*/memory/README.md' 2>/dev/null | wc -l)"
if [ "$doc_count" -gt 0 ] && [ -f "$count_file" ]; then
    last_count="$(cat "$count_file" 2>/dev/null || echo 0)"
    if [ "$doc_count" != "$last_count" ]; then
        echo "[agent-engineering-kit] Memory 文档数变化（$last_count → $doc_count）；请先使用 memory_recall MCP，由 Agent 内部处理刷新。"
        exit 0
    fi
fi

echo "[agent-engineering-kit] Memory configured；优先使用 memory_recall MCP。codebase configured 不代表 visible/indexed/fresh，结构查询前需宿主执行 freshness barrier。"
